index 0000000000000000000000000000000000000000..04c2e5868e8a1d690342575a7e17f532975eb9e5
--- /dev/null
+++ b/.github/workflows/source-bundle-index.yml
@@ -0,0 +1,80 @@
+name: Index source bundle artifact
+
+on:
+  workflow_run:
+    workflows: [Source bundle]
+    types: [completed]
+
+permissions: {}
+
+jobs:
+  index:
+    if: >-
+      github.event.workflow_run.conclusion == 'success' &&
+      github.event.workflow_run.repository.id == github.event.repository.id
+    runs-on: ubuntu-24.04
+    timeout-minutes: 3
+    permissions:
+      actions: read
+      statuses: write
+    steps:
+      - name: Validate metadata and publish fixed source index
+        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9
+        with:
+          script: |
+            const run = context.payload.workflow_run;
+            let sourceSha;
+            if (run.event === 'push') {
+              sourceSha = run.head_sha;
+            } else if (run.event === 'pull_request') {
+              if (!Array.isArray(run.pull_requests) || run.pull_requests.length !== 1) {
+                core.setFailed('Pull-request Source bundle run has no unique immutable PR identity.');
+                return;
+              }
+              sourceSha = run.pull_requests[0].head.sha;
+            } else {
+              core.setFailed(`Unsupported Source bundle event: ${run.event}`);
+              return;
+            }
+            if (!/^[0-9a-f]{40}$/.test(sourceSha)) {
+              core.setFailed('Source bundle run did not resolve to a full lowercase source SHA.');
+              return;
+            }
+
+            const artifacts = await github.paginate(
+              github.rest.actions.listWorkflowRunArtifacts,
+              {
+                owner: context.repo.owner,
+                repo: context.repo.repo,
+                run_id: run.id,
+                per_page: 100,
+              }
+            );
+            const expectedName = `teasescript-source-${sourceSha}`;
+            const matches = artifacts.filter((artifact) => artifact.name === expectedName);
+            if (matches.length !== 1) {
+              core.setFailed(`Expected exactly one ${expectedName} artifact, found ${matches.length}.`);
+              return;
+            }
+            const artifact = matches[0];
+            if (
+              artifact.expired !== false ||
+              !/^sha256:[0-9a-f]{64}$/.test(artifact.digest || '') ||
+              artifact.workflow_run?.id !== run.id ||
+              artifact.workflow_run?.head_sha !== run.head_sha ||
+              artifact.workflow_run?.repository_id !== context.payload.repository.id
+            ) {
+              core.setFailed('Source bundle artifact metadata did not match its trusted producer run.');
+              return;
+            }
+
+            const artifactUrl = `${context.serverUrl}/${context.repo.owner}/${context.repo.repo}/actions/runs/${run.id}/artifacts/${artifact.id}`;
+            await github.rest.repos.createCommitStatus({
+              owner: context.repo.owner,
+              repo: context.repo.repo,
+              sha: sourceSha,
+              state: 'success',
+              context: 'source-bundle/artifact-v1',
+              description: `artifact ${artifact.id} ${artifact.digest}`.slice(0, 140),
+              target_url: artifactUrl,
+            });
