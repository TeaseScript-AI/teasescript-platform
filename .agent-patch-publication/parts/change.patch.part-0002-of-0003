+name: Runner startup benchmark
+
+on:
+  pull_request:
+    paths:
+      - .github/workflows/runner-startup-benchmark.yml
+
+permissions: {}
+
+jobs:
+  ubuntu-24-04:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 3
+    steps:
+      - name: Exercise control-plane toolchain
+        run: |
+          set -euo pipefail
+          command -v bash git gh node python3
+          tmp=$(mktemp -d)
+          git init -q "$tmp"
+          python3 -c 'import hashlib; print(hashlib.sha256(b"runner-benchmark").hexdigest())'
+      - name: Initialize JavaScript action runtime
+        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9
