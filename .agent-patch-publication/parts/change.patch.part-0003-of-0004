+@layer tokens {
+      :root,
+      [data-theme="light"] {
+        /*
+          Radix-inspired functional primitives. The numbered neutral scale
+          preserves the approved light-theme anchors rather than forcing a
+          mathematically uniform ramp that would change the Player appearance.
+        */
+        --neutral-1: oklch(0.958388167 0.013064634 71.329675);
+        --neutral-2: oklch(0.975859732 0.011304887 71.900713);
+        --neutral-3: oklch(0.991986399 0.007338834 80.721397);
+        --neutral-4: oklch(0.954491898 0.016177987 64.670581);
+        --neutral-5: oklch(0.924813698 0.022133945 58.770256);
+        --neutral-6: oklch(0.930086518 0.013607742 60.562705);
+        --neutral-7: oklch(0.863698296 0.022520549 58.740358);
+        --neutral-8: oklch(0.842463561 0.029049486 65.706579);
+        --neutral-9: oklch(0.780500634 0.037401997 56.320047);
+        --neutral-10: oklch(0.688505808 0.048261569 51.545561);
+        --neutral-11: oklch(0.526489898 0.026786943 41.270655);
+        --neutral-12: oklch(0.308376787 0.017117909 35.721243);
+
+        /* Disabled text is an approved neutral anchor outside the 12-step interaction ramp. */
+        --neutral-disabled-text: oklch(0.584857304 0.026025073 41.299400);
+        --neutral-white: oklch(1 0 0);
+
