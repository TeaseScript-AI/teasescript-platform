+test("rename deduplicates repeated compiler locations without corrupting identifiers", () => {
+  const root = createFixture({
+    "src/declaration.ts": "export class oldName {}\n",
+    "src/consumer.ts": "export type Imported = import(\"./declaration.js\").oldName;\nexport async function use(): Promise<unknown> {\n  return (await import(\"./declaration.js\")).oldName;\n}\n",
+  });
+  try {
+    const result = run(root, renameArguments("write"));
