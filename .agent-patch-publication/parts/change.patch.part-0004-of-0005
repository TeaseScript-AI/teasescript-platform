+  await github.rest.repos.createCommitStatus({
+    owner: context.repo.owner,
+    repo: context.repo.repo,
+    sha: identity.sourceSha,
+    state: 'success',
+    context: FIXED_STATUS_CONTEXT,
+    description: `artifact ${numericArtifactId} ${digest}`.slice(0, 140),
+    target_url: artifactUrl,
+  });
+
+  return {
+    artifactId: numericArtifactId,
+    artifactName: artifact.name,
+    artifactDigest: rawDigest,
+    artifactUrl,
+    producerRunId: Number(context.runId),
+    expiresAt: artifact.expires_at || null,
+    reused: false,
+  };
