+    throw new Error('The upload action did not return a valid artifact ID.');
+  }
+  const numericArtifactId = Number.parseInt(String(artifactId), 10);
+  const parsedTarget = parseArtifactTargetUrl(
+    artifactUrl,
+    context.serverUrl,
+    `${context.repo.owner}/${context.repo.repo}`
