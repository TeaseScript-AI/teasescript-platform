+    resultMarker(requestCommentId),
+    '## Artifact request failed',
+    '',
+    String(error || 'The request failed before a verified Source bundle was available.'),
+    '',
+    `Producer run: ${runUrl}`,
+  ].join('\n');
+}
+
+async function revalidateRequestComment({ github, context, request }) {
+  const response = await github.rest.issues.getComment({
+    owner: context.repo.owner,
+    repo: context.repo.repo,
+    comment_id: request.commentId,
+  });
+  const current = response.data;
+  if (
+    current.id !== request.commentId ||
+    current.user?.login !== request.author ||
+    current.body !== request.body
+  ) {
+    throw new Error('The request comment changed while the workflow was running.');
+  }
+}
