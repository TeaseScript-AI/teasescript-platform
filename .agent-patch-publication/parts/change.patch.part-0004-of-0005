+      `- Pull request: \`#${identity.pullRequestNumber}\``,
+      `- Head repository/ref: \`${identity.headRepository}:${identity.headRef}\``,
+      `- Base SHA: \`${identity.baseSha}\``,
+      `- Merge-base SHA: \`${identity.mergeBaseSha}\``
+    );
+  }
+  details.push(
+    `- Artifact ID: \`${artifact.artifactId}\``,
+    `- Artifact name: \`${artifact.artifactName}\``,
+    `- SHA-256: \`${artifact.artifactDigest}\``,
+    `- Producer run: \`${artifact.producerRunId}\``,
+    `- Expires: \`${artifact.expiresAt || 'unavailable'}\``,
+    `- Reused existing artifact: \`${artifact.reused ? 'yes' : 'no'}\``,
+    '',
+    'Download with the GitHub connector:',
+    '',
+    '```text',
+    `download_workflow_artifact(repo_full_name="${repositoryFullName}", artifact_id=${artifact.artifactId}, file_name="${artifact.artifactName}.zip")`,
+    '```',
+    '',
+    'Then run exactly:',
+    '',
+    '```shell',
+    preparationCommand(repositoryFullName, identity, artifact),
+    '```'
+  );
+  return details.join('\n');
+}
+
+function formatFailureComment({ requestCommentId, error, runUrl }) {
