+    artifact.id !== numericArtifactId ||
+    artifact.name !== artifactNameFor(identity.sourceSha) ||
+    artifact.expired !== false ||
+    artifact.digest !== digest ||
+    artifact.workflow_run?.id !== Number(context.runId)
+  ) {
+    throw new Error('Uploaded Source bundle metadata did not match the pinned source and producer run.');
+  }
