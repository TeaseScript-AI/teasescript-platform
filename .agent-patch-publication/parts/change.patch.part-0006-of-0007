+        patch = bytearray(b"x" * 301)
+        marker = b"\ndiff --git "
+        for offset in range(51, len(patch), 51):
+            if offset + len(marker) <= len(patch):
+                patch[offset : offset + len(marker)] = marker
+
+        parts, counts = SUPPORT.split_utf8_patch(
