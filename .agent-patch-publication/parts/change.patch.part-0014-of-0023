+def resolve_link_target(member: PurePosixPath, linkname: str, *, symbolic: bool) -> str:
+    if not linkname or "\\" in linkname or "\x00" in linkname:
+        raise fail(f"unsafe archive link target for {member}: {linkname!r}")
+    if linkname.startswith("/"):
+        raise fail(f"absolute archive link target for {member}: {linkname!r}")
+    base = str(member.parent) if symbolic else ""
+    normalized = posixpath.normpath(posixpath.join(base, linkname))
+    if normalized == "." or normalized.startswith("../") or "/../" in normalized:
+        raise fail(f"archive link escapes payload root for {member}: {linkname!r}")
+    if PurePosixPath(normalized).parts[0] != member.parts[0]:
+        raise fail(f"archive link escapes payload root for {member}: {linkname!r}")
+    return normalized
