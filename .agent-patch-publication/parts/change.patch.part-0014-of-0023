+def copy_and_verify(source: Path, destination: Path, expected_sha256: str) -> None:
+    try:
+        source_stat = source.lstat()
+    except OSError as exc:
+        raise fail(f"payload is not accessible: {source}: {exc}") from exc
+    if stat.S_ISLNK(source_stat.st_mode) or not stat.S_ISREG(source_stat.st_mode):
+        raise fail(f"payload must be a regular non-symlink file: {source}")
+    digest = hashlib.sha256()
+    try:
+        with source.open("rb") as input_stream, destination.open("xb") as output_stream:
+            for chunk in iter(lambda: input_stream.read(1024 * 1024), b""):
+                digest.update(chunk)
+                output_stream.write(chunk)
+    except OSError as exc:
+        raise fail(f"cannot copy payload {source}: {exc}") from exc
+    actual = digest.hexdigest()
+    if actual != expected_sha256:
+        raise fail(
+            f"payload SHA-256 mismatch for {source.name}: "
+            f"expected {expected_sha256}, got {actual}"
+        )
