{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": { "correctness": "error" },
  "jsPlugins": [{ "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/src/index.ts" }],
  "rules": {
    "constructor-super": "error",
    "no-constant-binary-expression": "error",
    "no-debugger": "error",
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-this-before-super": "error",
    "no-unreachable": "error",
    "no-unsafe-finally": "error",
    "valid-typeof": "error",
    "typescript/no-explicit-any": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "prefer-rest-params": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          { "from": "package", "package": "node:test", "name": ["test", "describe", "it", "suite"] }
        ]
      }
    ],
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "off",
    "typescript/no-array-delete": "off",
    "typescript/no-base-to-string": "off",
    "typescript/no-duplicate-type-constituents": "off",
    "typescript/no-for-in-array": "off",
    "typescript/no-implied-eval": "off",
    "typescript/no-meaningless-void-operator": "off",
    "typescript/no-misused-spread": "off",
    "typescript/no-redundant-type-constituents": "off",
    "typescript/no-unsafe-unary-minus": "off",
    "typescript/no-useless-default-assignment": "off",
    "typescript/require-array-sort-compare": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/unbound-method": "off",
    "unicorn/no-new-array": "off",
    "require-yield": "off",
    "no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_" }
    ]
  },
  "overrides": [
    {
      "files": [
        "player/captured-media.ts",
        "src/deterministic-math.ts",
        "src/message-markup.ts",
        "src/runtime/random/random.ts",
        "src/semantic/scope.ts",
        "src/type-checker.ts",
        "src/type-inference/collector.ts",
        "src/type-inference/core/admission/eligibility.ts",
        "src/type-inference/core/admission/groups.ts",
        "src/type-inference/core/answers.ts",
        "src/type-inference/core/checks/interactions.ts",
        "src/type-inference/core/contract.ts",
        "src/type-inference/core/contract/levels.ts",
        "src/validation-testing.ts",
        "src/xmp-keywords.ts",
        "tests/families-runner.test.ts",
        "tests/type-core-closure.test.ts",
        "tests/type-core-mixed-family.test.ts",
        "tests/type-core-stop.test.ts"
      ],
      "rules": {
        "no-control-regex": "off",
        "no-unused-vars": "off",
        "no-useless-escape": "off",
        "oxc/double-comparisons": "off",
        "oxc/erasing-op": "off",
        "typescript/no-this-alias": "off",
        "unicorn/no-useless-fallback-in-spread": "off",
        "unicorn/no-useless-spread": "off",
        "unicorn/prefer-string-starts-ends-with": "off"
      }
    },
    {
      "files": [
        "player/vue/src/AbTestsPanel.vue",
        "player/vue/src/CodeBlock.vue",
        "player/vue/src/ExportTextDialog.vue",
        "player/vue/src/FloatingViewfinder.vue",
        "player/vue/src/LayoutDebug.vue",
        "player/vue/src/LockDialog.vue",
        "player/vue/src/PasswordField.vue",
        "player/vue/src/PathBreadcrumb.vue",
        "player/vue/src/PlayerApp.vue",
        "player/vue/src/PlayerToolsShell.vue",
        "player/vue/src/PopupDialog.vue",
        "player/vue/src/RandomDrawPicker.vue",
        "player/vue/src/SessionEndDialog.vue",
        "player/vue/src/StageRightRail.vue",
        "player/vue/src/StorageEditDialog.vue",
        "player/vue/src/ToolPanelHeader.vue",
        "player/vue/src/components/ui/sidebar/SidebarProvider.vue"
      ],
      "rules": {
        "anti-slop/require-safety-comment-for-type-assertion": "off"
      }
    },
    {
      "files": [
        "src/**/*.{ts,tsx,mts,cts}",
        "player/**/*.{ts,tsx,mts,cts}",
        "tests/helpers/**/*.{ts,tsx,mts,cts}"
      ],
      "rules": {
        "typescript/no-base-to-string": "error",
        "typescript/restrict-template-expressions": "error"
      }
    },
    {
      "files": [
        "src/runtime/evaluation/access.ts",
        "src/runtime/values/serializable-values.ts",
        "tests/helpers/type-core-held-host.ts"
      ],
      "rules": {
        "typescript/no-base-to-string": "off",
        "typescript/restrict-template-expressions": "off"
      }
    },
    {
      "files": ["tests/helpers/live-host-effects.ts", "tests/helpers/source-ops-lifecycle.ts"],
      "rules": { "typescript/no-base-to-string": "off" }
    },
    {
      "files": ["tests/player-session-rewind.test.ts"],
      "rules": { "typescript/no-floating-promises": "off" }
    }
  ]
}
