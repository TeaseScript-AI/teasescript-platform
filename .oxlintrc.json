{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": { "correctness": "error" },
  "jsPlugins": [{ "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/src/index.ts" }],
  "rules": {
    "constructor-super": "error",
    "no-constant-binary-expression": "error",
    "no-debugger": "error",
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-this-before-super": "error",
    "no-unreachable": "error",
    "no-unsafe-finally": "error",
    "valid-typeof": "error",
    "typescript/no-explicit-any": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "prefer-rest-params": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          { "from": "package", "package": "node:test", "name": ["test", "describe", "it", "suite"] }
        ]
      }
    ],
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "off",
    "typescript/no-array-delete": "off",
    "typescript/no-base-to-string": "off",
    "typescript/no-duplicate-type-constituents": "off",
    "typescript/no-for-in-array": "off",
    "typescript/no-implied-eval": "off",
    "typescript/no-meaningless-void-operator": "off",
    "typescript/no-misused-spread": "off",
    "typescript/no-redundant-type-constituents": "off",
    "typescript/no-unsafe-unary-minus": "off",
    "typescript/no-useless-default-assignment": "off",
    "typescript/require-array-sort-compare": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/unbound-method": "off",
    "unicorn/no-new-array": "off",
    "require-yield": "off",
    "no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_" }
    ]
  },
  "overrides": [
    {
      "files": [
        "player/media/captured-media.ts",
        "src/deterministic-math.ts",
        "src/message-markup.ts",
        "src/runtime/random/random.ts",
        "src/semantic/scope.ts",
        "src/type-checker.ts",
        "src/type-inference/collector.ts",
        "src/type-inference/core/admission/eligibility.ts",
        "src/type-inference/core/admission/groups.ts",
        "src/type-inference/core/answers.ts",
        "src/type-inference/core/checks/interactions.ts",
        "src/type-inference/core/contract.ts",
        "src/type-inference/core/contract/levels.ts",
        "src/validation-testing.ts",
        "src/xmp-keywords.ts",
        "tests/families-runner/families-baseline-store.test.ts",
        "tests/families-runner/families-runner-compare.test.ts",
        "tests/type-core/stop/type-core-closure.test.ts",
        "tests/type-core/type-core-mixed-family.test.ts",
        "tests/type-core/stop/type-core-stop-combined.test.ts",
        "tests/type-core/stop/type-core-stop-labels.test.ts",
        "tests/type-core/stop/type-core-stop-route.test.ts"
      ],
      "rules": {
        "no-control-regex": "off",
        "no-unused-vars": "off",
        "no-useless-escape": "off",
        "oxc/double-comparisons": "off",
        "oxc/erasing-op": "off",
        "typescript/no-this-alias": "off",
        "unicorn/no-useless-fallback-in-spread": "off",
        "unicorn/no-useless-spread": "off",
        "unicorn/prefer-string-starts-ends-with": "off"
      }
    },
    {
      "files": [
        "player/vue/src/shell/AbTestsPanel.vue",
        "player/vue/src/debug/random/CodeBlock.vue",
        "player/vue/src/interaction/ExportTextDialog.vue",
        "player/vue/src/stage/FloatingViewfinder.vue",
        "player/vue/src/development/LayoutDebug.vue",
        "player/vue/src/interaction/LockDialog.vue",
        "player/vue/src/interaction/PasswordField.vue",
        "player/vue/src/debug/random/PathBreadcrumb.vue",
        "player/vue/src/shell/PlayerApp.vue",
        "player/vue/src/shell/PlayerToolsShell.vue",
        "player/vue/src/interaction/PopupDialog.vue",
        "player/vue/src/debug/random/RandomDrawPicker.vue",
        "player/vue/src/start-and-end/SessionEndDialog.vue",
        "player/vue/src/stage/StageRightRail.vue",
        "player/vue/src/debug/StorageEditDialog.vue",
        "player/vue/src/shell/ToolPanelHeader.vue",
        "player/vue/src/components/ui/sidebar/SidebarProvider.vue"
      ],
      "rules": { "anti-slop/require-safety-comment-for-type-assertion": "off" }
    },
    {
      "files": [
        "src/**/*.{ts,tsx,mts,cts}",
        "player/**/*.{ts,tsx,mts,cts}",
        "tests/helpers/**/*.{ts,tsx,mts,cts}"
      ],
      "rules": {
        "typescript/no-base-to-string": "error",
        "typescript/restrict-template-expressions": "error"
      }
    },
    {
      "files": [
        "tests/helpers/type-core-held-host.ts"
      ],
      "rules": {
        "typescript/no-base-to-string": "off",
        "typescript/restrict-template-expressions": "off"
      }
    },
    {
      "files": ["tests/helpers/live-host-effects.ts", "tests/helpers/source-ops-lifecycle.ts"],
      "rules": { "typescript/no-base-to-string": "off" }
    },
    {
      "files": ["tests/player/player-session-rewind.test.ts"],
      "rules": { "typescript/no-floating-promises": "off" }
    },
    {
      "files": ["player/vue/src/session/activation/work/**"],
      "rules": { "typescript/no-floating-promises": ["error", { "ignoreVoid": false }] }
    },
    {
      "files": ["**/*.{js,jsx,mjs,cjs}"],
      "env": { "node": true, "builtin": true },
      "rules": { "no-undef": "error" }
    },
    {
      "files": ["**/*.{js,jsx,mjs}"],
      "rules": {
        "no-restricted-globals": ["error", "exports", "require", "module", "__filename", "__dirname"]
      }
    },
    {
      "files": ["tools/player-firefox-camera.mjs", "tools/player-preview-checks.mjs"],
      "globals": {
        "document": "readonly",
        "Element": "readonly",
        "getComputedStyle": "readonly",
        "HTMLMediaElement": "readonly",
        "HTMLTextAreaElement": "readonly",
        "HTMLVideoElement": "readonly",
        "MouseEvent": "readonly",
        "StorageEvent": "readonly",
        "window": "readonly"
      }
    },
    {
      "files": ["tools/player-gate/bridge/page.mjs", "tools/player-gate/bridge/worker-entry.mjs", "tools/player-gate/drive.mjs", "tools/player-gate/lib/player.mjs", "tools/player-gate/lib/probe.mjs", "tools/player-gate/scenarios/bridge.mjs", "tools/player-gate/scenarios/demo.mjs", "tools/player-gate/scenarios/keep.mjs", "tools/player-gate/scenarios/keys.mjs", "tools/player-gate/scenarios/taps.mjs", "tools/player-gate/tapes/browser.mjs"],
      "globals": {"document": "readonly", "Document": "readonly", "getComputedStyle": "readonly", "IDBDatabase": "readonly", "IDBObjectStore": "readonly", "indexedDB": "readonly", "innerHeight": "readonly", "innerWidth": "readonly", "location": "readonly", "MutationObserver": "readonly", "Node": "readonly", "requestAnimationFrame": "readonly", "self": "readonly", "window": "readonly", "Worker": "readonly"}
    },
    {
      "files": ["tools/player-gate/variants/delayed-client.mjs", "tools/player-gate/variants/delayed-in-process.mjs"],
      "globals": { "__GATE_DELAY_MS__": "readonly" }
    }
  ]
}
