function descend(depth) {
    let subtotal = 0
    for index in 0..2 {
        if depth > 0 {
            subtotal += descend(depth - 1)
        } else {
            if index == 0 { say "leaf:${depth}", instant }
            subtotal += index + 1
        }
    }
    return subtotal
}
let result = descend(2)
say "tree:${result}", instant
exit
