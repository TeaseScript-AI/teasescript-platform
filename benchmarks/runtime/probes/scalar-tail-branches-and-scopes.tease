let n = 0
let totalValue = 0
while n < 3 { n += 1 }
repeat 3 { totalValue += 2 }
for v in [2, 4, 6] { totalValue += v }
if totalValue == 18 { totalValue += 1 }
if false { totalValue += 100 }
while n > 0 { n -= 1 }
for i in 0..3 {
  if i == 1 { continue }
  totalValue += 1
}
let text = "a"
repeat 2 { text += "b" }
say "scalar:${n}:${totalValue}:${text}", instant
exit
