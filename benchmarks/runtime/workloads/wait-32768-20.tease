// Target 20 counted instructions between consecutive waits.
let payload = []
for i in 0..32768 { payload.add(i) }
let counter = 0
repeat 12 {
 payload[0] = counter
 counter += 1
 counter += 1
 counter += 1
 counter += 1
 counter += 1
 counter += 1
 counter += 1
 counter += 1
 counter += 1
 counter += 1
 counter += 1
 wait 1 ms
}
say "boundary:${counter}:${payload.length}:${payload[0]}", instant
exit
