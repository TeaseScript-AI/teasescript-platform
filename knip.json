{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "playground/browser.ts",
    "playground/server.ts",
    "player/vue/index.html",
    "player/vue/src/lib/utils.ts",
    "player/runtime-adapter.ts",
    "player/saved-data.ts",
    "player/theme/palette.ts",
    "player/theme/photo-theme.ts",
    "player/vue/src/randomDrawPresentation.ts",
    "player/vue/src/stagePhotos.ts",
    "player/vue/src/transcriptPresentation.ts",
    "player/vue/src/useDebugRandom.ts",
    "player/vue/src/useDebugRewind.ts",
    "player/vue/src/useDevelopmentTime.ts",
    "player/vue/src/useImageCapture.ts",
    "player/vue/src/useMessageUpdateAnnouncements.ts",
    "player/vue/src/usePlayerDebug.ts",
    "player/vue/src/usePlayerNotifications.ts",
    "player/vue/src/usePlayerPreference.ts",
    "player/vue/src/usePlayerSession.ts",
    "player/vue/src/usePlayerTheme.ts",
    "player/vue/src/usePlayerToasts.ts",
    "player/vue/src/useStagePhoto.ts",
    "tests/**/*.test.ts",
    "tests/property/replay.ts",
    "tools/oxlint/{run,test}.mjs",
    "tools/oxlint/check-evidence.test.mjs",
    "tools/oxlint/anti-slop/src/**/*.test.ts",
    "tools/local-agent/patch-publication-cleanup-comment.cjs",
    "tools/local-agent/patch-publication-request.cjs",
    "tools/local-agent/source-bundle-artifact-request.cjs",
    "tools/local-agent/test-source-bundle-artifact-request.cjs"
  ],
  "project": [
    "src/**/*.ts",
    "playground/**/*.ts",
    "player/**/*.ts",
    "player/vue/**/*.{css,vue}",
    "tests/**/*.ts",
    "tools/oxlint/**/*.mjs",
    "tools/oxlint/**/*.ts",
    "tools/local-agent/**/*.{cjs,mjs}"
  ],
  "ignoreDependencies": [
    "@vue/tsconfig",
    "shadcn-vue"
  ],
  "include": [
    "files",
    "exports",
    "dependencies",
    "unlisted",
    "unresolved"
  ]
}
