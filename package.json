{
  "name": "teasescript-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "build": "npm run build:typescript && node tools/run-parallel.mjs typecheck:player build:player build:player-test-modules",
    "build:tree": "npm run build:typescript && node tools/run-parallel.mjs build:player build:player-test-modules",
    "build:typescript": "node ./tools/clean-compiled-tests.mjs && tsc",
    "build:player": "vite build --config player/vue/vite.config.ts",
    "build:player-test-modules": "vite build --config player/vue/vite.test-modules.config.ts",
    "typecheck": "tsc --noEmit && npm run typecheck:player",
    "typecheck:player": "node ./tools/vue-typecheck.cjs --noEmit -p player/vue/tsconfig.json",
    "format": "prettier --write \"**/*.{ts,tsx,cts,mts,js,jsx,cjs,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,cts,mts,js,jsx,cjs,mjs}\"",
    "test:compiled": "node ./tools/test-output-filter.mjs",
    "test": "npm run build && node ./tools/test-output-filter.mjs",
    "check": "npm run check:pretest && BUILD_SOURCEMAPS=0 npm test",
    "check:pretest": "node tools/run-parallel.mjs format:check lint lint:design test:lint:design test:lint knip check:doc-links check:imports test:build:typescript test:verification test:families",
    "check:doc-links": "node tools/repository-checks/doc-links.mjs",
    "check:imports": "node tools/repository-checks/imports.mjs",
    "knip": "knip",
    "lint": "node tools/oxlint/run.mjs",
    "lint:design": "eslint --config eslint.design.config.mjs player/vue/src --ext .vue,.ts --max-warnings 0",
    "test:lint": "tsc -p tools/oxlint/tsconfig.json && node tools/oxlint/test.mjs",
    "playground": "npm run build && node dist/playground/server.js",
    "playground:https": "npm run build && node dist/playground/server.js --https",
    "probe": "node tools/probe.mjs",
    "benchmark:runtime": "node tools/benchmark-runtime.mjs",
    "test:property": "npm run build && node dist/tests/property/replay.js",
    "test:build:typescript": "node ./tools/test-clean-typescript-build.mjs",
    "test:compiled:full-output": "node ./tools/test-output-filter.mjs --full-output",
    "test:full-output": "npm run build && node ./tools/test-output-filter.mjs --full-output",
    "check:full-output": "TEST_FULL_OUTPUT=1 npm run check",
    "test:player:browser": "npm run build && node tools/player-browser-smoke.mjs",
    "test:player:preview": "node tools/player-preview-checks.mjs",
    "test:player:firefox-camera": "node tools/player-firefox-camera.mjs",
    "dev:player": "vite --config player/vue/vite.config.ts",
    "test:verification": "node --test tools/run-parallel.test.mjs tools/test-shards.test.mjs tools/test-files-at-once.test.mjs tools/test-in-flight.test.mjs tools/check-changed.test.mjs tools/check-shas.test.mjs tools/ci-test-counts.test.mjs tools/counters.test.mjs tools/benchmark-runtime.test.mjs tools/knip-entries.test.mjs tools/structure-report.test.mjs tools/repository-checks/doc-links.test.mjs tools/repository-checks/regression-cases.test.mjs tools/repository-checks/imports.test.mjs tools/repository-checks/pin-suites.test.mjs",
    "test:families": "node tests/families/check.mjs",
    "test:lint:design": "node --test tools/design-lint/test.mjs"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "@shadcn/lint": "0.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/sortablejs": "1.15.9",
    "@typescript-eslint/parser": "8.70.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/tsconfig": "0.9.1",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.10.0",
    "knip": "6.34.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2006",
    "postcss": "8.5.26",
    "postcss-selector-parser": "7.1.6",
    "prettier": "3.9.6",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1",
    "remark-validate-links": "13.1.0",
    "shadcn-vue": "2.8.2",
    "tailwindcss": "4.3.3",
    "ts-morph": "28.0.0",
    "typescript-vue": "npm:typescript@5.9.3",
    "unified-engine": "11.2.2",
    "vfile": "6.0.3",
    "vite": "8.2.2",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  },
  "dependencies": {
    "@lucide/vue": "1.46.0",
    "@material/material-color-utilities": "0.4.0",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@tanstack/vue-virtual": "3.13.36",
    "@vueuse/core": "14.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "colorjs.io": "0.7.1",
    "re2js": "2.8.6",
    "reka-ui": "2.10.4",
    "sortablejs": "1.15.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vue": "3.5.41",
    "vue-sonner": "2.0.9"
  }
}
