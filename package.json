{
  "name": "teasescript-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "build": "npm run build:typescript && npm run typecheck:player && npm run build:player",
    "build:typescript": "tsc",
    "build:player": "vite build --config player/vue/vite.config.ts",
    "typecheck": "tsc --noEmit && npm run typecheck:player",
    "typecheck:player": "node ./tools/vue-typecheck.cjs --noEmit -p player/vue/tsconfig.json",
    "format": "prettier --write \"**/*.{ts,tsx,cts,mts,js,jsx,cjs,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,cts,mts,js,jsx,cjs,mjs}\"",
    "test:compiled": "node ./tools/test-output-filter.mjs",
    "test": "npm run build && node ./tools/test-output-filter.mjs",
    "check": "npm run format:check && npm run lint && npm run test:lint && npm run knip && npm test",
    "knip": "knip",
    "lint": "node tools/oxlint/run.mjs",
    "test:lint": "tsc -p tools/oxlint/tsconfig.json && node tools/oxlint/test.mjs",
    "playground": "npm run build && node dist/playground/server.js",
    "test:property": "npm run build && node dist/tests/property/replay.js",
    "test:compiled:full-output": "node ./tools/test-output-filter.mjs --full-output",
    "test:full-output": "npm run build && node ./tools/test-output-filter.mjs --full-output",
    "check:full-output": "npm run format:check && npm run lint && npm run test:lint -- --full-output && npm run knip && npm run test:full-output"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/tsconfig": "0.9.1",
    "knip": "6.34.0",
    "oxlint": "1.81.0",
    "prettier": "3.9.6",
    "shadcn-vue": "2.8.2",
    "tailwindcss": "4.3.3",
    "ts-morph": "28.0.0",
    "typescript-vue": "npm:typescript@5.9.3",
    "vite": "8.2.2",
    "vue-tsc": "3.3.11"
  },
  "dependencies": {
    "@tanstack/vue-virtual": "3.13.36",
    "clsx": "2.1.1",
    "reka-ui": "2.10.4",
    "tailwind-merge": "3.6.0",
    "vue": "3.5.41"
  }
}
