{
  "name": "teasescript-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "build": "node ./node_modules/typescript/lib/tsc.js",
    "typecheck": "node ./node_modules/typescript/lib/tsc.js --noEmit",
    "test:compiled": "node --test dist/tests/*.test.js",
    "check:libraries": "npm run build && node --test dist/tests/library-catalog-metadata.test.js dist/tests/library-export-boundary.test.js dist/tests/library-validation-pipeline.test.js",
    "test": "npm run build && npm run test:compiled",
    "check:legacy-imports": "node tools/check-legacy-imports.mjs",
    "check": "npm run check:legacy-imports && npm test",
    "playground": "npm run build && node dist/playground/server.js",
    "test:property": "npm run build && node dist/tests/property/replay.js",
    "test:property:extended": "npm run build && node dist/tests/property/replay.js --profile extended"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "typescript-api": "npm:typescript@6.0.2"
  }
}
