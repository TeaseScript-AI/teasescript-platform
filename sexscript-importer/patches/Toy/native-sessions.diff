+{ toy ->
+	// The domme's session plans (formerly data in images/toy/domme.groovy) as methods, run by sessionPlay in
+	// toy/play.groovy. Each phase runs in order, one with a condition only when it holds; a phase takes one activity
+	// unless it says otherwise, and the session dresses for the activities of all of its phases first.
+
+	// The sessions available now, with their probabilities.
+	toy.metaClass.sessionChoices { int punishment ->
+		final sessions = [];
+		if (punishment < 50) sessions.add([theme: "stroking and edging", probability: 50]);
+		if (has("dildo")) sessions.add([theme: "blowjob training", probability: 5]);
+		sessions.add([theme: "reminder who's boss", probability: 5]);
+		if (punishment > 40) sessions.add([theme: "punishment", probability: 50]);
+		return sessions;
+	};
+
+	toy.metaClass.runSession { String theme, int punishment ->
+		switch (theme) {
+			case "stroking and edging": sessionStrokingAndEdging(punishment); break;
+			case "blowjob training": sessionBlowjobTraining(punishment); break;
+			case "reminder who's boss": sessionWhosBoss(punishment); break;
+			case "punishment": sessionPunishment(punishment); break;
+		}
+	};
+
+	toy.metaClass.sessionStrokingAndEdging { int punishment ->
+		final pre = sessionActivities(['*pre,!punish']);
+		final play = sessionActivities(['*play,tease']);
+		final intervals = sessionActivities([null, '*int']);
+		sessionDress([pre, play, intervals, ['postCum', 'postChastity'], ['postChastity'], ['postPermitCum']]);
+		sessionRepeat(randRange(1, 3), pre, []);
+		sessionRepeat(randRange(1, 3), play, intervals);
+		sessionTake(randRange(0, 2), ['postCum', 'postChastity'], []);
+		if (can("perm_chaste")) sessionTake(1, ['postChastity'], []);
+		if (!sessionAborted && !can("cum")) sessionTake(1, ['postPermitCum'], []);
+	};
+
+	toy.metaClass.sessionBlowjobTraining { int punishment ->
+		final pre = sessionActivities(['*pre,!reward,!ballgag']);
+		sessionDress([pre, ['playSuck']]);
+		sessionTake(randRange(1, 3), pre, []);
+		sessionTake(1, ['playSuck'], []);
+	};
+
+	// "reminder who's boss"
+	toy.metaClass.sessionWhosBoss { int punishment ->
+		final pre = sessionActivities(['*pre,!reward,!chaste']);
+		final play = sessionActivities(['*play,punish', '*play,humiliation']);
+		sessionDress([pre, play, ['postChastity']]);
+		sessionTake(randRange(1, 4), pre, [], 'punishMultiply');
+		sessionRepeat(randRange(2, 3), play, [], 'punishApply');
+		if (can("perm_chaste") || randRange(1, 2) == 1) sessionTake(1, ['postChastity'], []);
+	};
+
+	toy.metaClass.sessionPunishment { int punishment ->
+		final pre = sessionActivities(['*pre,!reward,!chaste']);
+		final play = sessionActivities(['*play,punish', '*play,humiliation']);
+		final intervals = sessionActivities([null, '*int']);
+		final punish = sessionActivities(['*!pre,!int,punish']);
+		sessionDress([['preChastity'], pre, play, intervals, punish, ['postChastity']]);
+		sessionTake(1, ['preChastity'], []);
+		sessionTake(randRange(1, 2 + (int)(punishment / 100)), pre, [], 'punishMultiply');
+		sessionRepeat(randRange(1, 2 + (int)(punishment / 100)), play, intervals, 'punishApply');
+		sessionTake(randRange(1, 2 + (int)(punishment / 100)), punish, [], 'punishApply');
+		sessionTake(1, ['postChastity'], []);
+	};
+	return null;
+}
