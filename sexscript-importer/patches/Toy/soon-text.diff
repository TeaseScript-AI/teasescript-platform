+	// The text of a time as soonFormatter wrote it: "Monday at 3:05PM".
+	String soonText(int s) {
+		final local = s + localTimeOffset();
+		final day = ["Thursday", "Friday", "Saturday", "Sunday", "Monday", "Tuesday", "Wednesday"][(int) (local / DAY) % 7];
+		final minutes = (int) ((local % DAY) / 60);
+		final hour = (int) (minutes / 60);
+		final minute = minutes % 60;
+		return "$day at ${(hour + 11) % 12 + 1}:${minute < 10 ? '0' : ''}$minute${hour < 12 ? 'AM' : 'PM'}";
+	}
