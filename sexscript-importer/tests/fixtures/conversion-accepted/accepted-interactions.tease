// MIGRATION INCOMPLETE: 1 error diagnostic.
// Review diagnostics before treating this file as behaviorally equivalent.

function sexscriptLegacyShowButton(text, timeout) {
  if timeout == 0 {
    showButton text, timeout: 10 ms
    return 0
  }
  return (showButton text, timeout: timeout * 1 s) / 1 s
}
let ready = askBoolean prose "Are you ready?"
let sure = askBoolean prose "Really?", yesText: "Yes, Mistress"
let count = askInteger prose "How many?", prefill: 10
showPopup "Session starts now"
showButton "Quick!", timeout: 3 s
// A zero timeout showed the button for its 10 ms safety margin and returned 0.
// NOTE SX_BUTTON_TIMEOUT line 7: With a zero timeout the legacy button stayed visible only for its 10 ms safety margin, and the result was 0; TeaseScript rejects a zero timeout (#531), so the button keeps the 10 ms.
showButton "Flash", timeout: 10 ms
// NOTE SX_BUTTON_TIMEOUT line 8: With a zero timeout the legacy button stayed visible only for its 10 ms safety margin, and the result was 0; TeaseScript rejects a zero timeout (#531), so the button keeps the 10 ms.
showButton "Blink", timeout: 10 ms
let instant = 0
// A timeout known to be zero before the script runs keeps the margin too; a computed one may be zero only at runtime.
let noWait = 0
// NOTE SX_BUTTON_TIMEOUT line 11: With a zero timeout the legacy button stayed visible only for its 10 ms safety margin, and the result was 0; TeaseScript rejects a zero timeout (#531), so the button keeps the 10 ms.
showButton "Now", timeout: 10 ms
// NOTE SX_BUTTON_TIMEOUT line 12: With a zero timeout the legacy button stayed visible only for its 10 ms safety margin, and the result was 0; TeaseScript rejects a zero timeout (#531), so the button keeps the 10 ms.
showButton "Again", timeout: 10 ms
let pause = randomInteger(0..3) + 1
sexscriptLegacyShowButton("Later", pause)
let elapsed = showButton "Done", timeout: 30 s
if elapsed >= 30 s or instant > 0 {
  say prose "Too slow", instant
}
openUrl("https://example.com")
let start = getAbsoluteDateTime().toSeconds()
if ready and sure {
  say prose "Starting ${count} rounds at ${start}", instant
}
// showPopup() returned the seconds until the player closed it.
let late = toInteger(showPopup("Come here!") / 1 s)
if late > 60 {
  say prose "What took you so long?", instant
}
function title {
  wait 1 s
  return "Ready?"
}
let slow = toInteger(showPopup(title()) / 1 s)
// getImage() took a webcam picture and returned its path, or null.
// NOTE SX_CAMERA_FALLBACK line 26: getImage() fell back to a file chooser titled with its message when no webcam worked; takePhoto() only uses the camera and returns null instead, and the Player decides how the photo is taken.
let photo: string? = takePhoto()
if photo != null {
  showImage photo
}
// With the accepted forms selected, getBooleans asks every question in one form and getFile opens the file chooser.
let kit = askBooleans prose "Which toys do you have?", texts: ["Paddle", "Crop"], prefill: [true, false]
if kit[1] == true {
  say prose "Bring the crop", instant
}
// NOTE SX_FILE_TITLE line 31: getFile() titled its file chooser with this message; chooseFile() has no title.
let picture = chooseFile()
if picture == null {
  say prose "No photo", instant
}
exit
