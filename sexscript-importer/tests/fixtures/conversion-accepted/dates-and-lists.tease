function sexscriptLegacyConcat(lists) {
  let combined = []
  for list in lists {
    for item in list {
      combined.add(item)
    }
  }
  return combined
}
let text = "Start"
text = "${text} and more"
let menu = ["Back"]
let extra = ["One", "Two"]
menu = sexscriptLegacyConcat([["Back"], extra, ["Last"]])
menu = sexscriptLegacyConcat([menu, extra])
menu.add("Tail")
let n = 1
n += 2
let dateValue = getDateTime()
let month = dateValue.month
let hour = getDateTime().hour
let dow = getDateTime().weekdayNumber % 7 + 1
let dayOfYear = (getDate() - toDate("${getDate().year}-01-01")).days + 1
// NOTE SX_ROUNDING_TIES line 15: Java Math.round() rounds .5 toward positive infinity (-1.5 becomes -1); TeaseScript round() rounds ties away from zero (-1.5 becomes -2, V30 §13).
let days = round(n / 2)
// NOTE SX_SYSTEM_EXIT line 16: System.exit() closed the legacy application; TeaseScript exit ends the session but leaves the Player open.
if hour > 22 {
  exit
}
// Java date patterns: the ISO date is a machine format, other patterns are shown in the player's local form.
let stamp = getDate().toISO()
// NOTE SX_DATE_FORMAT line 19: Java formatted the current time with the pattern "HH:mm"; formatTime() shows the player's local form instead (#532).
say "Status of ${stamp} at ${getTime().formatTime()}, day ${dayOfYear}"
