// Inputs that pre-fill a value the player can accept or change.
let level = 3
say "What is your name?"
let name = askText default: "slave"
let newLevel = askInteger("Set your level", default: level)
say "Your weight in kg?"
let weight = askNumber default: 70.5
// Legacy showed any default as text.
say "Your code?"
let code = askText default: "${level}"
say "${name}: level ${newLevel}, ${weight} kg, code ${code}"
