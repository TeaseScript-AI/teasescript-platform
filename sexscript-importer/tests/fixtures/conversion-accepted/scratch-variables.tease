// A variable reused for values of several types, each assigned before it is read, splits by type.
let responseBoolean = false
let responseNumber = 0
let response = ""
function askReady {
  say "Ready?"
  responseBoolean = (choose yes: "Yes", no: "No") == "yes"
  if responseBoolean {
    say "Ready"
  }
}
function askCount {
  say "How many?"
  responseNumber = choose 0: "One", 1: "Two"
  say "Picked ${responseNumber + 1}"
}
response = "Start"
say response
askReady()
askCount()
// An empty-text placeholder that later holds a list starts as an empty list.
// NOTE SX_PLACEHOLDER_TYPE line 16: Groovy started 'lines' as empty text and later stored a list (string[]); TeaseScript variables keep one type, so it starts as the empty value of that type, which differs only where the empty text was read.
let lines: string[] = []
function fill {
  lines = ["Kneel", "Wait"]
}
fill()
say lines.join(", ")
// A list that starts empty and is filled by position grows at its end.
let rounds = []
let i = 0
while i < 3 {
  // NOTE SX_LIST_GROWTH line 22: Groovy grew this list when writing at or past its end, padding with null; a TeaseScript position must exist, so a write at the end appends, which differs only for a position beyond the end.
  if i < rounds.length {
    rounds[i] = i * 2
  } else {
    rounds.add(i * 2)
  }
  i += 1
}
say "Rounds ${rounds.length}"
// A function nothing calls never ran in Groovy, so what it cannot convert does not block the script.
function debugImages {
  // NOTE SX_UNDEFINED_VARIABLE line 26: missingCount is never assigned in this script or its package; SexScript failed with a missing property whenever this ran. Nothing in the package calls this function, so Groovy never ran this code.
  // | for (int n = 1; n <= missingCount; n++) show("Image ${n}")
}
