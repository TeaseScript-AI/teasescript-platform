// Text handling with text operations.
let line = "  write this line  "
let typed = line.trim()
say "Characters: ${typed.length}"
say "${typed.uppercase()} / ${typed.lowercase()}"
say "ok".uppercaseFirst()
if typed.startsWith("write") and not typed.endsWith("!") {
  say typed.replace("line", "sentence")
}
say typed.replace(" ", "_")
// NOTE SX_SPLIT_TRAILING_EMPTY line 11: Java split() drops trailing empty parts; TeaseScript split() keeps them.
let parts = "red,green,blue".split(",")
say "${parts[1]} ${typed.substring(0, 5)}"
if "Yes".lowercase() == "YES".lowercase() {
  say "same"
}
say "x".replace("x", "$&")
if typed.contains("this") {
  say "At ${typed.indexOf("this")}"
}
// Groovy showed a whole list as [a, b].
let items = ["kneel", "wait"]
say "Items: [${items.join(", ")}], joined: ${items.join(", ")} or ${items.join("")}"
let mixed = [1, 2.5, true]
say "Mixed: [${mixed.join(", ")}]"
say "[${items.join(", ")}]"
