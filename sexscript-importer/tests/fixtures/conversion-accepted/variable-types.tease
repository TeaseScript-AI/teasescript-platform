// A variable that starts with a whole number and later holds fractions widens to a number by itself (#504 option B).
let tempo = 1
tempo = 0.75
let delay = 2
delay = delay / 4
let weights: number[] = [1, 2]
weights.add(2.5)
// A variable that is later set to null gets an optional type.
let mood: string? = "calm"
if tempo < 1 {
  mood = null
}
// Groovy integer declarations truncate every number they store.
let half = toInteger(7 / 2)
let rounds = 1
rounds = toInteger(rounds + tempo)
let steps = 10
steps = toInteger(steps / 3)
say "Tempo ${tempo}, delay ${delay}, ${weights.length} weights, mood ${mood}"
say "Half ${half}, rounds ${rounds}, steps ${steps}"
// A value of unknown type is truncated too, and an integer read from storage is declared and checked.
function fraction {
  return 3.5
}
let whole = toInteger(fraction())
whole = toInteger(fraction() + 1)
save 4 as "x.count"
let stored: integer = load "x.count"
// Another storage read may hold a fraction, which Groovy truncated.
save 2.5 as "x.ratio"
let ratio = toInteger(load "x.ratio")
say "Ratio ${ratio}"
// A variable that starts as null keeps the type of its first value.
let later = null
later = 1
later = 2.5
say "Whole ${whole}, stored ${stored}, later ${later}"
// A position that may hold a fraction truncates when it indexes a list, as Groovy did.
let names = ["first", "second"]
let position = 0
position = position + 0.5
say names[toInteger(position)]
