// A declaration of several variables takes each from its position in the values, null past the end.
function tilePosition(index) {
  return [index % 3, toInteger(index / 3)]
}
let values = tilePosition(5)
let column = sexscriptLegacyItemAt(values, 0)
let row = sexscriptLegacyItemAt(values, 1)
say "Column ${column}, row ${row}"
exit
