// A countdown redrawn in a busy loop becomes a visible timer.
let startTime = getAbsoluteDateTime().toSeconds()
let waitedTime = getAbsoluteDateTime().toSeconds() - startTime
// NOTE SX_BUSY_COUNTDOWN line 4: The legacy loop redrew a countdown as fast as it could until the time was up; it became a visible timer over the same time, whose display replaces the redrawn text.
timer 5 s
say "Time is up"
// A limit given at run time may be already reached, such as a negative typed time: the loop did not run then.
function waitFor(limit) {
  let started = getAbsoluteDateTime().toSeconds()
  let waited = getAbsoluteDateTime().toSeconds() - started
  // NOTE SX_BUSY_COUNTDOWN line 15: The legacy loop redrew a countdown as fast as it could until the time was up; it became a visible timer over the same time, whose display replaces the redrawn text.
  if limit > 0 {
    timer limit s
  }
}
waitFor(2)
waitFor(-1)
// A variable that starts as null takes the clock's seconds, so the time between two readings is a number.
let before = 0
before = getAbsoluteDateTime().toSeconds()
let after = getAbsoluteDateTime().toSeconds()
if after - before >= 0 {
  say "Measured"
}
// A loop that only counts adds the count at once where its range is not empty.
function addPoints(i) {
  let p = 0
  if floor(i) >= 1 {
    p += floor(i)
  }
  say "Points ${p}"
}
addPoints(1000000)
// A loop that polls the clock with nothing that waits, as ZapEdgeStrip's dice roll, waits a tenth of a second each
// pass where it reads the clock again, and shows its texts in one message that changes in place.
let rollUntil = getAbsoluteDateTime().toSeconds() + 2
let rolled = 0
let now = getAbsoluteDateTime().toSeconds()
let frame2: messageHandle? = null
while now < rollUntil {
  wait 0.1 s
  rolled = randomInteger(0..6) + 1
  if frame2 == null {
    frame2 = say "Rolling ${rolled}", instant
  } else {
    frame2.text = "Rolling ${rolled}"
  }
  now = getAbsoluteDateTime().toSeconds()
}
say "You rolled ${rolled}"
// So does one whose condition reads the clock itself, as Nim's closing window.
let windowEnd = getAbsoluteDateTime().toSeconds() + 3
let frame3: messageHandle? = null
while getAbsoluteDateTime().toSeconds() < windowEnd {
  wait 0.1 s
  if frame3 == null {
    frame3 = say "Now's your chance!", instant
  } else {
    frame3.text = "Now's your chance!"
  }
}
// A loop whose body waits already is left as it is.
let paced = getAbsoluteDateTime().toSeconds() + 2
while getAbsoluteDateTime().toSeconds() < paced {
  say "Tick"
  wait 1 s
}
// A pass that may continue, or whose wait may not run, waits at its start, so no pass skips it; a number it shows is
// the message's text.
let polls = 0
let pollEnd = getAbsoluteDateTime().toSeconds() + 1
let frame4: messageHandle? = null
while getAbsoluteDateTime().toSeconds() < pollEnd {
  wait 0.1 s
  polls += 1
  if frame4 == null {
    frame4 = say polls, instant
  } else {
    frame4.text = "${polls}"
  }
  if polls < 0 {
    wait 1 s
  }
  if polls % 2 == 0 {
    continue
  }
  if frame4 == null {
    frame4 = say "Odd ${polls}", instant
  } else {
    frame4.text = "Odd ${polls}"
  }
}
// The clock read through a function, and a wait in a function the loop calls, count too; that wait stays.
function clockNow {
  return getAbsoluteDateTime().toSeconds()
}
function beat {
  say "Beat"
  wait 1 s
}
let beatEnd = clockNow() + 2
while clockNow() < beatEnd {
  beat()
}
// A new message's name stays apart from a loop's variable.
let frameEnd = getAbsoluteDateTime().toSeconds() + 1
let frame5: messageHandle? = null
while getAbsoluteDateTime().toSeconds() < frameEnd {
  wait 0.1 s
  for frame in [1, 2] {
    if frame5 == null {
      frame5 = say "Frame", instant
    } else {
      frame5.text = "Frame"
    }
  }
}
exit
