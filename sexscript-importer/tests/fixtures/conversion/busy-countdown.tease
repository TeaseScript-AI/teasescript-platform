let before = getAbsoluteDateTime()
before = getAbsoluteDateTime()
let after = getAbsoluteDateTime()
if after - before >= 0 s {
  say prose "Measured", instant
}
// A loop that only counts adds the count at once where its range is not empty.
function addPoints(i) {
  let p = 0
  p += abs(floor(i) - 1) + 1
