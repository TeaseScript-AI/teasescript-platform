}
let resting = askBoolean "Rest?"
let guardEnd = getAbsoluteDateTime().toSeconds() + 1
// NOTE SX_CLOCK_LOOP line 105: The legacy loop polled the clock until the time was up, and a pass of it may wait for nothing; a TeaseScript clock advances only at waits, so a pass after one in which the clock did not advance starts with a wait of a tenth of a second.
