// A pass that may continue, or whose wait may not run, waits at its start where the clock did not advance before.
let polls = 0
let pollEnd = getAbsoluteDateTime().toSeconds() + 1
// NOTE SX_CLOCK_LOOP line 57: The legacy loop polled the clock until the time was up, and a pass of it may wait for nothing; a TeaseScript clock advances only at waits, so a pass after one in which the clock did not advance starts with a wait of a tenth of a second.
let passClock3: absoluteDateTime? = null
while getAbsoluteDateTime().toSeconds() < pollEnd {
