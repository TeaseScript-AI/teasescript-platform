    wait 0.1 s
  }
  passClock3 = getAbsoluteDateTime()
  polls += 1
  say polls
  if polls < 0 {
    wait 1 s
  }
  if polls % 2 == 0 {
    continue
  }
  say "Odd ${polls}"
}
// The clock read through a function, and a wait in a function the loop calls, count too; that wait stays.
function clockNow {
