function sexscriptLegacyShowButton(text, timeout) {
  if timeout == 0 {
    showButton text, timeout: 10 ms
    return 0
  }
  return (showButton text, timeout: timeout) / 1 s
}
function sexscriptLegacyTruth(value) {
  if value is boolean {
    return value
  }
  if value is number {
    return value != 0
  }
  if value is string {
    return value != ""
  }
  if value is list or value is set {
    return value.length > 0
  }
  if value is dict {
    return value.length > 0
  }
  if value is object {
    return value != {}
  }
  return value != null
}
// A button's seconds compared with a number stay its duration, compared with seconds.
if (showButton "Done", timeout: 30) >= 30 s {
  say "Too slow."
}
// A variable that holds only a button's seconds, compared with numbers or waited for, holds the duration.
let beg = showButton "Please"
if beg < 15 s {
  say "Beg harder."
}
let pause = showButton "Pause"
wait pause
// Whole seconds (a Groovy int) compare alike with < and >= against a whole number.
let t = showButton "Done, Miss."
while t >= 60 s {
  say "That took far too long. Again!"
  t = showButton "Done, Miss."
}
// Where a plain number is needed the seconds stay: text, arithmetic, a computed number, or whole seconds by <=.
let took = (showButton "Finished") / 1 s
say "You took ${took} seconds."
let total = (showButton "Next") / 1 s + 10
let limit = 20
let stopped = (showButton "Stop", timeout: limit) / 1 s
if stopped < limit {
  say "Stopped early."
}
let quick = toInteger((showButton "Go") / 1 s)
if quick <= 5 {
  say "Quick."
}
// A parameter's default stays as written, so the variable it reads keeps the seconds.
let reaction = (showButton "Ready") / 1 s
function check(quickValue = reaction < 15) {
  if sexscriptLegacyTruth(quickValue) {
    say "Quick."
  }
}
check()
// A timeout known only at runtime may be zero, where the legacy button stayed for 10 ms and gave 0 seconds.
let none = randomInteger(0..1)
sexscriptLegacyShowButton("Now", none)
let quickest = sexscriptLegacyShowButton("Faster", none)
say "You took ${quickest} seconds."
exit
