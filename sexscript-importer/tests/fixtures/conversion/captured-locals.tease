// cannot keep apart, and so may a function that calls itself: their locals stay.
let saved = null
function create(start) {
  let count = toInteger(start)
  // TODO SX_CAPTURING_CLOSURE line 44: This closure value captures local count of its enclosing function; TeaseScript has no closures, so pass that state explicitly.
  // | def bump = { -> count++ }
  let bump = null
  saved = bump
  say prose "Count ${count}", instant
}
create(1)
// A closure value that only reads the locals it captures, and that its function only calls, gets them as parameters,
// also in a function that runs again while it runs (fight_arena's menu, whose `args` reads the player's choice).
let nested = null
function labelCallback5(prefix, items, pick, depth) {
  return "${prefix} ${items[pick]} at ${depth}"
}
function showMenu(items, depth) {
  let pick = 0
  while pick < items.length {
    say prose labelCallback5("Item", items, pick, depth), instant
    if depth > 0 {
      sexscriptLegacyCall(nested, [["inner"], depth - 1])
    }
    pick += 1
  }
}
nested = "showMenu"
showMenu(["a", "b"], 1)
// A text without a value that the function compares, here with a variable that holds null, stays a local, and its
// setter a TODO: the script variable would start as the empty text.
function chooseValue {
  let pick = null
  // TODO SX_CAPTURING_CLOSURE line 67: This closure value captures local pick of its enclosing function; TeaseScript has no closures, so pass that state explicitly.
  // | def set = { -> pick = "x" }
  let setValue = null
  let none = null
  if pick == none {
    say prose "Unset", instant
  } else {
    say prose "Set", instant
  }
  sexscriptLegacyCall(setValue, [])
}
chooseValue()
chooseValue()
// A local that another block of its function declares again, such as another `case`, lifts where the declarations
// agree on its type: each sets the one script variable where it stands (Farkel's Roxana challenge).
let challengeMistakes = 5
let challengeStep = 0
function mistakeCallback6(it = null) {
  challengeMistakes += 1
  challengeStep = challengeMistakes
  return challengeStep
}
function challenge(who) {
  switch who {
    case "a" {
      challengeMistakes = 0
      challengeStep = 0
      mistakeCallback6()
      mistakeCallback6()
      say prose "Mistakes ${challengeMistakes} ${challengeStep}", instant
    }
    case "b" {
      challengeMistakes = 5
      challengeMistakes += 1
      say prose "Other ${challengeMistakes}", instant
    }
  }
}
challenge("a")
challenge("b")
challenge("a")
