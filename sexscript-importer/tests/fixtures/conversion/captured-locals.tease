// Calls the function an action ID names. Unlike Groovy, extra arguments are ignored and an unknown action returns null.
function sexscriptLegacyCall(action, args) {
  if action == "showMenu" {
    showMenu(args[0], args[1])
    return
  }
}
// A closure value that reads or sets locals of its function, or its parameters, converts with them as script
// variables under new names: the function sets each where it declared it, and copies a parameter in as it starts
// (ShockQuiz's settings, whose closures set its `txt`).
let configureTxt = ""
let configureCount = 0
function askCallback1(it = null) {
  configureTxt = "Rounds ${configureCount}"
  configureCount += 1
  say configureTxt
}
function configure(start) {
  configureTxt = ""
  configureCount = toInteger(start)
  askCallback1()
  askCallback1()
  say "${configureTxt} ${configureCount}"
}
configure(2)
function shoutCallback2(labelValue, suffix) {
  // NOTE SX_PLUS_OPERAND_TYPE line 23: Groovy + operands are not proven numeric; TeaseScript + adds two numbers or joins two texts or two lists, not mixed values. Use interpolation if this joins text.
  say labelValue + suffix
}
function optionsCallback2(labelValue2) {
  let suffix = "!"
  return shoutCallback2(labelValue2, suffix)
}
// A closure value inside a closure value gets the locals of the closures around it the same way, here as parameters,
// since it only reads them.
function menu {
  let labelValue3 = "Pick"
  optionsCallback2(labelValue3)
}
menu()
function tellCallback4(it, seen) {
  say "Seen ${seen}"
}
// A closure that only reads a local declared anew on each pass of a loop gets it as a parameter, as each pass's closure
// saw its own.
function perPass {
  for i in 0..2 {
    let seen = i
    tellCallback4(null, seen)
  }
}
perPass()
// A closure value that something keeps may run while another call of its function runs, which one script variable
// cannot keep apart, and so may a function that calls itself: their locals stay.
let saved = null
function create(start) {
  let count = toInteger(start)
  // TODO SX_CAPTURING_CLOSURE line 44: This closure value captures local count of its enclosing function; TeaseScript has no closures, so pass that state explicitly.
  // | def bump = { -> count++ }
  let bump = null
  saved = bump
  say "Count ${count}"
}
create(1)
// A closure value that only reads the locals it captures, and that its function only calls, gets them as parameters,
// also in a function that runs again while it runs (fight_arena's menu, whose `args` reads the player's choice).
let nested = null
function labelCallback5(prefix, items, pick, depth) {
  return "${prefix} ${items[pick]} at ${depth}"
}
function showMenu(items, depth) {
  let pick = 0
  while pick < items.length {
    say labelCallback5("Item", items, pick, depth)
    if depth > 0 {
      sexscriptLegacyCall(nested, [["inner"], depth - 1])
    }
    pick += 1
  }
}
nested = "showMenu"
showMenu(["a", "b"], 1)
// A closure whose converted body has an error stays as it was, unconverted, so that the script keeps compiling.
let tuneNote = "low"
function tune {
  tuneNote = "low"
  // TODO SX_CAPTURING_CLOSURE line 66: This closure value captures local note of its enclosing function; TeaseScript has no closures, so pass that state explicitly.
  // | def raise = { -> note = note.unknownMethod() }
  let raise = null
  sexscriptLegacyCall(raise, [])
  say "Tuned"
}
tune()
exit
