// Calls the function an action ID names. Unlike Groovy, extra arguments are ignored and an unknown action returns null.
function sexscriptLegacyCall(action, args) {
  if action == "showMenu" {
    showMenu(args[0], args[1])
    return
  }
}
// A closure value that reads or sets locals of its function, or its parameters, converts with them as script
// variables under new names: the function sets each where it declared it, and copies a parameter in as it starts
// (ShockQuiz's settings, whose closures set its `txt`).
let configureTxt = ""
let configureCount = 0
function askCallback1(it = null) {
  configureTxt = "Rounds ${configureCount}"
  configureCount += 1
  say prose configureTxt, instant
}
function configure(start) {
  configureTxt = ""
  configureCount = toInteger(start)
  askCallback1()
  askCallback1()
  say prose "${configureTxt} ${configureCount}", instant
}
configure(2)
function shoutCallback2(labelValue, suffix) {
  // NOTE SX_PLUS_OPERAND_TYPE line 23: Groovy + operands are not proven numeric; TeaseScript + adds two numbers or joins two texts or two lists, not mixed values. Use interpolation if this joins text.
  say prose labelValue + suffix, instant
}
function optionsCallback2(labelValue2) {
  let suffix = "!"
  return shoutCallback2(labelValue2, suffix)
}
// A closure value inside a closure value gets the locals of the closures around it the same way, here as parameters,
// since it only reads them.
function menu {
  let labelValue3 = "Pick"
  optionsCallback2(labelValue3)
}
menu()
function tellCallback4(it, seen) {
  say prose "Seen ${seen}", instant
}
// A closure that only reads a local declared anew on each pass of a loop gets it as a parameter, as each pass's closure
// saw its own.
function perPass {
  for i in 0..2 {
    let seen = i
    tellCallback4(null, seen)
  }
}
perPass()
