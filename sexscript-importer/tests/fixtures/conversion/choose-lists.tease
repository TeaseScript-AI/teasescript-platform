function sexscriptLegacyMenuOptions(texts, first) {
  let optionsValue = []
  let position = first
  for text in texts {
    optionsValue.add({ value: position, text: text })
    position += 1
  }
  return optionsValue
}
// Menus built from runtime lists: written options keep their index, list elements follow.
let offenses = ["Being late", "Being rude"]
offenses.add("Lying")
say "What do you confess?"
let pick = choose 0: "Back", sexscriptLegacyMenuOptions(offenses, 1)
if pick > 0 {
  say "You confessed: ${offenses[pick - 1]}"
}

let levels = ["Low", "High"]
say "Which level?"
let level = choose sexscriptLegacyMenuOptions(levels, 0)
say "Level ${levels[level]}"

let toys = [
  { lbl: "Plug", id: "plug" },
  { lbl: "Clamps", id: "clamps" }
]
let menuTexts = []
for it in toys {
  menuTexts.add(it.lbl)
}
let toy = toys[(choose sexscriptLegacyMenuOptions(menuTexts, 0))].id
say "Toy: ${toy}"

let again = 0
while again == 0 {
  say "Again?"
  again = choose 0: "Back", sexscriptLegacyMenuOptions(levels, 1)
}

// The same menu reached again with other option texts.
let options = ["Low", "High"]
for roundValue in 1..=2 {
  say "Pick one"
  let picked = choose sexscriptLegacyMenuOptions(options, 0)
  say "Picked ${options[picked]}"
  options = ["Plug", "Clamps"]
}
// Written options after a runtime list join it, so their positions follow the list's.
let mistresses = ["Vera", "Anna"]
say "Who will see you?"
let pickMistress = choose sexscriptLegacyMenuOptions(mistresses + ["Back"], 0)
if pickMistress == mistresses.length {
  say "Back"
} else {
  say "Mistress ${mistresses[pickMistress]}"
}
// Records added to a list with a field that is null in some of them: Groovy read each record's own field.
let resets: object[] = []
resets.add({ lbl: "Full reset", ID: 2 })
resets.add({ lbl: "Back", ID: null })
say "Reset?"
let menuTexts2 = []
for it in resets {
  menuTexts2.add(it.lbl)
}
let reset: integer? = resets[(choose sexscriptLegacyMenuOptions(menuTexts2, 0))].ID
say "Reset ${reset}"
// Records put in front of a list by concatenation count too.
let choices: object[] = [{ lbl: "Stroked", act: "stroked" }]
choices = [{ lbl: "Nothing", act: null }] + choices
say "Choices ${choices.length}"
// A menu over a list that a loop builds asks its question after the loop, also one that a ternary computes.
let strict = askBoolean "Strict?"
let tasks = [
  { name: "Kneel" },
  { name: "Crawl" }
]
let conditional = "Pick one"
if strict {
  conditional = "Pick, now."
}
let menuTexts3 = []
for it in tasks {
  menuTexts3.add(it.name)
}
say conditional
let task = choose sexscriptLegacyMenuOptions(menuTexts3, 0)
say "Task ${task}"
// A field that some records leave null may be null where it is read, and its truth is a plain test.
let picked: integer? = 1
while picked != null and picked != 0 {
  let menuTexts4 = []
  for it in resets {
    menuTexts4.add(it.lbl)
  }
  say "Again?"
  picked = resets[(choose sexscriptLegacyMenuOptions(menuTexts4, 0))].ID
  if picked != null and picked != 0 {
    say "Reset ${picked}"
  }
}
// simpletimer: a menu over a list a loop built with one option for each saved timer after "New" names a timer where
// its position is above 0.
let timers = [
  { name: "Short" },
  { name: "Long" }
]
let timerNames = ["*** New ***"]
for timerValue in timers {
  timerNames.add(timerValue.name)
}
say "Which timer?"
let timerChoice = choose sexscriptLegacyMenuOptions(timerNames, 0)
if timerChoice != 0 {
  say "Timer ${timers[timerChoice - 1].name}"
}
// DisciplineClinic's pending offenses: a counter from 0 that only grows reads the list while it is below its size.
let pendingOffenses = ["late", "rude"]
let p = pendingOffenses.length
p = 0
while p < pendingOffenses.length {
  if load("pending.${pendingOffenses[p]}", default: false) == true {
    say "Pending: ${pendingOffenses[p]}"
  }
  p += 1
}
exit
