function sexscriptLegacyShuffled(itemsValue) {
  let shuffled = itemsValue
  let index = shuffled.length - 1
  while index > 0 {
    let other = randomInteger(0..=index)
    let swap = shuffled[index]
    shuffled[index] = shuffled[other]
    shuffled[other] = swap
    index -= 1
  }
  return shuffled
}
function sexscriptLegacyListMax(itemsValue2) {
  if itemsValue2.length == 0 {
    return null
  }
  let best = itemsValue2.first
  for item in itemsValue2 {
    if item > best {
      best = item
    }
  }
  return best
}
function sexscriptLegacyItemAt(listValue, position) {
  if position < 0 {
    return listValue[listValue.length + position]
  }
  if position >= listValue.length {
    return null
  }
  return listValue[position]
}
let items = ["kneel", "wait", "count"]
let upper = []
for it in items {
  upper.add("${it}!")
}
let longOnes = []
for item in items {
  if item.length > 4 {
    longOnes.add(item)
  }
}
let found = null
for it in items {
  if it == "wait" {
    found = it
    break
  }
}
let anyCount = false
for it in items {
  if it == "count" {
    anyCount = true
    break
  }
}
let total = 0
for item in [1, 2, 3] {
  total += item
}
for it in 0..3 {
  say "Round ${it}"
}
repeat 2 {
  say "Again"
}
for i in 0..items.length {
  let item = items[i]
  say "${i}: ${item}"
}
items = sexscriptLegacyShuffled(items)
items.removeAt(0)
items.remove("wait")
let pairs = [
  [1, 2],
  [3, 4]
]
pairs.remove([1, 2])
let numbers = [5, 6]
say "Pairs left: ${pairs.length}, took ${numbers.removeAt(0)}"
say "Best: ${sexscriptLegacyListMax([3, 7, 5])}"
let bigger = max(total, 4)
if items.length == 0 {
  say "Nothing left"
}
// A loop that reads its own target keeps the old value until the result is complete.
let again = true
let anyResult = false
for it in [1, 2] {
  if again {
    anyResult = true
    break
  }
}
again = anyResult
let rounds = 2
for it in 0..rounds {
  say "Round"
}
say "Second ${[1, 2, 3][[1, 2, 3].length - 2]}"
// A position compared with null reads null past the end, as Groovy did.
let hand = ["Ace", "King"]
// NOTE SX_INDEX_PAST_END line 28: This position can be one past the end of the list, where Groovy read null; a helper reads null there too.
if sexscriptLegacyItemAt(hand, 2) != null {
  say "Third card"
} else {
  say "Two cards"
}
// A list that only ever starts empty grows at its end, also by a computed position.
let shoe = []
for d in 0..2 {
  for c in 0..2 {
    // NOTE SX_LIST_PADDING line 31: Groovy grew this list when writing past its end, padding it with null up to the position; the conversion pads it with 0, which Groovy truth treats like null, since nothing compares its elements with null.
    while shoe.length <= d * 2 + c {
      shoe.add(0)
    }
    shoe[d * 2 + c] = c
  }
}
say "Shoe ${shoe.length}"
// A division of values not proven numbers sets a number.
let odds: number = 0
let parts = [3, 4]
odds = parts[0] / parts[1]
say "Odds ${odds}"
// Positions computed from values of unknown type, and a literal position past a literal list, grow the list.
function joinDecks(first, second, offset) {
  let joined = []
  for i in 0..2 {
    // NOTE SX_LIST_GROWTH line 41: Groovy grew this list when writing at or past its end, padding with null; a TeaseScript position must exist, so a write at the end appends, which differs only for a position beyond the end.
    if i < joined.length {
      joined[i] = first[i]
    } else {
      joined.add(first[i])
    }
  }
  for i in 0..2 {
    // NOTE SX_PLUS_OPERAND_TYPE line 42: Groovy + operands are not proven numeric; TeaseScript + adds two numbers or joins two texts or two lists, not mixed values. Use interpolation if this joins text.
    // NOTE SX_LIST_GROWTH line 42: Groovy grew this list when writing at or past its end, padding with null; a TeaseScript position must exist, so a write at the end appends, which differs only for a position beyond the end.
    if i + offset < joined.length {
      joined[i + offset] = second[i]
    } else {
      joined.add(second[i])
    }
  }
  return joined
}
let labels = ["< Previous", "Next >"]
labels.add("Exit")
say "Decks ${joinDecks([1, 2], [3, 4], 2).length} ${labels.length}"
// A list filled from its end, or past its end, gets padding up to the position, as Groovy padded it with null: 0 where
// nothing compares its elements with null, and null where something does.
let slots = []
let k = 2
while k >= 0 {
  // NOTE SX_LIST_PADDING line 51: Groovy grew this list when writing past its end, padding it with null up to the position; the conversion pads it with 0, which Groovy truth treats like null, since nothing compares its elements with null.
  while slots.length <= k {
    slots.add(0)
  }
  slots[k] = k * 10
  k -= 1
}
let seats = []
// NOTE SX_LIST_PADDING line 53: Groovy grew this list when writing past its end, padding it with null up to the position; the conversion pads it the same way.
while seats.length <= 1 {
  seats.add(null)
}
seats[1] = "Ann"
// NOTE SX_INDEX_PAST_END line 54: This position can be one past the end of the list, where Groovy read null; a helper reads null there too.
if sexscriptLegacyItemAt(seats, 0) == null {
  say "Seat 0 is free"
}
// A write that reads the same position first needs no padding: the position exists already.
k = 0
while k < 3 {
  slots[k] = slots[k] + 1
  k += 1
}
say "Slots ${slots.length} ${seats.length}"
// collect() without a closure collects each element as it is.
let positions = []
for item in 0..=2 {
  positions.add(item)
}
say "Positions ${positions.length}"
let rows = []
let collectResult = []
for item in "a,b".split(",") {
  collectResult.add(item)
}
rows.add(collectResult)
say "Rows ${rows.length}"
// A list of positions sets each of them to the one value (campdrain), and reads the list of their elements
// (Concentration).
let stages = ["warm", "warm", "warm", "warm"]
for position in [1, 3] {
  stages[position] = "slow"
}
let paces = [240, 240, 240]
let value = 100 + randomInteger(0..20)
for position2 in [0, 2] {
  paces[position2] = value
}
function firstPaces(all) {
  return [all[0], all[1]]
}
// NOTE SX_LENGTH_RECEIVER line 71: Groovy size() also worked on a map; text, lists, and dicts have a length, but if this value is an object with fixed properties, length stops the script.
say "Stages [${stages.join(", ")}] [${paces.join(", ")}] ${firstPaces(paces).length}"
// A queue starts as an empty list, whose size reads as the list's (LLM_Mistress).
let replies = []
if replies.length == 0 {
  say "No replies yet"
}
// An any() whose result goes unused is a loop: a true result, returned or last, stops it, as in campdrain's drains.
let drainSpeed = 0
for stroke in 1..=2 {
  say "Stroke ${stroke}"
  if load("training.edge", default: false) == true {
    if askBoolean "Over the edge?" {
      break
    }
    save false as "training.edge"
    drainSpeed = 5
    break
  }
}
say "Speed ${drainSpeed}"
// A write into a list inside a list changes the outer list itself, also where its position may be -1, as Battleship's
// board of shots.
let shots = [
  [0, 0],
  [0, 0]
]
let letters = "AB"
let column = -1
let cell = askText("Shoot (A1 to B2):", prefill: "A1").replace("\n", " ")
if cell.length == 2 {
  column = letters.indexOf(cell.substring(0, 1))
}
if column < 0 {
  column = 0
}
shots[column][0] = 1
say "Shot ${shots[0][0]}"
exit
