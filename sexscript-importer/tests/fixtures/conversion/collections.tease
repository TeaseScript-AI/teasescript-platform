function sexscriptLegacyShuffled(itemsValue) {
  let shuffled = itemsValue
  let index = shuffled.length - 1
  while index > 0 {
    let other = randomInteger(0..=index)
    let swap = shuffled[index]
    shuffled[index] = shuffled[other]
    shuffled[other] = swap
    index -= 1
  }
  return shuffled
}
function sexscriptLegacyListMax(itemsValue2) {
  if itemsValue2.length == 0 {
    return null
  }
  let best = itemsValue2.first
  for item in itemsValue2 {
    if item > best {
      best = item
    }
  }
  return best
}
function sexscriptLegacyMax(first, second) {
  if first >= second {
    return first
  }
  return second
}
function sexscriptLegacyItemAt(listValue, position) {
  if position < 0 {
    return listValue[listValue.length + position]
  }
  if position >= listValue.length {
    return null
  }
  return listValue[position]
}
let items = ["kneel", "wait", "count"]
let upper = []
for it in items {
  upper.add("${it}!")
}
let longOnes = []
for item in items {
  if item.length > 4 {
    longOnes.add(item)
  }
}
let found = null
for it in items {
  if it == "wait" {
    found = it
    break
  }
}
let anyCount = false
for it in items {
  if it == "count" {
    anyCount = true
    break
  }
}
let total = 0
for item in [1, 2, 3] {
  total += item
}
for it in 0..3 {
  say "Round ${it}"
}
repeat 2 {
  say "Again"
}
for i in 0..items.length {
  let item = items[i]
  say "${i}: ${item}"
}
items = sexscriptLegacyShuffled(items)
items.removeAt(0)
items.remove("wait")
let pairs = [
  [1, 2],
  [3, 4]
]
pairs.remove([1, 2])
let numbers = [5, 6]
say "Pairs left: ${pairs.length}, took ${numbers.removeAt(0)}"
say "Best: ${sexscriptLegacyListMax([3, 7, 5])}"
let bigger = sexscriptLegacyMax(total, 4)
if items.length == 0 {
  say "Nothing left"
}
// A loop that reads its own target keeps the old value until the result is complete.
let again = true
let anyResult = false
for it in [1, 2] {
  if again {
    anyResult = true
    break
  }
}
again = anyResult
let rounds = 2
for it in 0..rounds {
  say "Round"
}
say "Second ${[1, 2, 3][[1, 2, 3].length - 2]}"
// A position compared with null reads null past the end, as Groovy did.
let hand = ["Ace", "King"]
// NOTE SX_INDEX_PAST_END line 28: This position can be one past the end of the list, where Groovy read null; a helper reads null there too.
if sexscriptLegacyItemAt(hand, 2) != null {
  say "Third card"
} else {
  say "Two cards"
}
// A list that only ever starts empty grows at its end, also by a computed position.
let shoe = []
let d = 0
while d < 2 {
  let c = 0
  while c < 2 {
    // NOTE SX_LIST_GROWTH line 31: Groovy grew this list when writing at or past its end, padding with null; a TeaseScript position must exist, so a write at the end appends, which differs only for a position beyond the end.
    if d * 2 + c < shoe.length {
      shoe[d * 2 + c] = c
    } else {
      shoe.add(c)
    }
    c += 1
  }
  d += 1
}
say "Shoe ${shoe.length}"
// A division of values not proven numbers sets a number.
let odds: number = 0
let parts = [3, 4]
odds = parts[0] / parts[1]
say "Odds ${odds}"
// Positions computed from values of unknown type, and a literal position past a literal list, grow the list.
function joinDecks(first, second, offset) {
  let joined = []
  let i = 0
  while i < 2 {
    // NOTE SX_LIST_GROWTH line 41: Groovy grew this list when writing at or past its end, padding with null; a TeaseScript position must exist, so a write at the end appends, which differs only for a position beyond the end.
    if i < joined.length {
      joined[i] = first[i]
    } else {
      joined.add(first[i])
    }
    i += 1
  }
  i = 0
  while i < 2 {
    // NOTE SX_PLUS_OPERAND_TYPE line 42: Groovy + operands are not proven numeric; TeaseScript + adds two numbers or joins two texts or two lists, not mixed values. Use interpolation if this joins text.
    // NOTE SX_LIST_GROWTH line 42: Groovy grew this list when writing at or past its end, padding with null; a TeaseScript position must exist, so a write at the end appends, which differs only for a position beyond the end.
    if i + offset < joined.length {
      joined[i + offset] = second[i]
    } else {
      joined.add(second[i])
    }
    i += 1
  }
  return joined
}
let labels = ["< Previous", "Next >"]
// NOTE SX_LIST_GROWTH line 46: Groovy grew this list when writing at or past its end, padding with null; a TeaseScript position must exist, so a write at the end appends, which differs only for a position beyond the end.
if 2 < labels.length {
  labels[2] = "Exit"
} else {
  labels.add("Exit")
}
say "Decks ${joinDecks([1, 2], [3, 4], 2).length} ${labels.length}"
exit
