speaker system {
  title: "System"
}
function sexscriptLegacyAskOnce(key, question) {
  if load(key, default: null) == null {
    save (askText as system question) as key
  }
  return load key, default: null
}
function sexscriptLegacyDeviceId {
  if load("system.deviceId", default: null) == null {
    save "${randomInteger(0..2147483647)}" as "system.deviceId"
  }
  return load "system.deviceId", default: null
}
// Information the player's computer provided is asked once from the player, as the system speaker, and saved.
// NOTE SX_OS_INFO line 2: System.getProperty("user.name") read the player's account name from the computer, which a browser does not provide; the player is asked once, as the system speaker, and the answer is saved as "intro.name".
say "Hello ${sexscriptLegacyAskOnce("intro.name", "What is your name?")}"
// NOTE SX_OS_INFO line 3: System.getProperty("user.home") read the player's home folder from the computer, which a browser does not provide; the player is asked once, as the system speaker, and the answer is saved as "system.homeFolder".
say "Your files are in ${sexscriptLegacyAskOnce("system.homeFolder", "Which folder is your home folder?")}"
// NOTE SX_OS_INFO line 4: The legacy script read the full path of the player's folder on the computer, which a browser does not provide; the player is asked once, as the system speaker, and the answer is saved as "system.playerFolder".
let folder = sexscriptLegacyAskOnce("system.playerFolder", "Which folder holds your SexScripts player?")
say "The player runs from ${folder}"
// A network hardware address used as an ID becomes a random ID, made once.
// NOTE SX_OS_INFO line 7: The legacy script read the network hardware addresses of the computer as an ID, which a browser does not provide; a random ID, made once and saved, stands in for them.
let addresses = [sexscriptLegacyDeviceId()]
let id = "${addresses[0]}_${randomInteger(0..1000)}"
save id as "training.id"
// An email cannot be sent from here; the player is told so.
// NOTE SX_EMAIL line 11: useEmailAddress() opened the computer's email program with this address, which a browser package cannot do: the player's email address is asked once as the system speaker, and a system notice says that the email is not sent.
sexscriptLegacyAskOnce("system.emailAddress", "What is your email address?")
say as system "Sending email is not available here. The original would have opened an email to author@example.org in your email program."
exit
