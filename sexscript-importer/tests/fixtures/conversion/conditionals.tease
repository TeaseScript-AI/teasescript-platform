function sexscriptLegacyTruth(value) {
  if value is boolean {
    return value
  }
  if value is number {
    return value != 0
  }
  if value is string {
    return value != ""
  }
  if value is list or value is set {
    return value.length > 0
  }
  if value is dict {
    return value.length > 0
  }
  if value is object {
    return value != {}
  }
  return value != null
}
let rounds = randomInteger(0..10)
let mood = "playful"
if rounds > 5 {
  mood = "strict"
}
let bonus = 0
if rounds > 8 {
  bonus = randomInteger(0..3)
}
if rounds == 0 {
  say "None"
} else if rounds == 1 {
  say "One round"
} else {
  say "Many rounds"
}
let labelValue: string? = null
if labelValue == null or labelValue == "" {
  labelValue = "pet"
}
say "Mood ${mood}, bonus ${bonus}, ${labelValue}"
// A value of unproven type, such as a parameter, is true as Groovy found it: not null, false, zero, or empty.
function finish(message) {
  if sexscriptLegacyTruth(message) {
    say message
  }
}
finish("Done")
finish("")
// A closure case is a condition on the switched value, which Groovy evaluated once.
let switchValue1 = randomInteger(0..4)
if switchValue1 < 2 {
  say "Stop!"
} else if switchValue1 == 2 {
  say "Again"
} else {
  say "Go on"
}
exit
