function sexscriptLegacyValue(value) {
  return value
}
function sexscriptLegacyLoadInteger(key, whenMissing = null) {
  let value = load key, default: null
  if value == null {
    return whenMissing
  }
  return sexscriptLegacyValue(toInteger(value))
}
function sexscriptLegacyListPart(value) {
  if value is list {
    return value
  }
  return [value]
}
function sexscriptLegacyRepeatList(items, times) {
  let result = []
  let roundValue = 0
  while roundValue < times {
    result += items
    roundValue += 1
  }
  return result
}
let text = "Start"
text += " and more"
let menu = ["Back"]
let extra = ["One", "Two"]
menu = ["Back"] + extra + ["Last"]
menu += extra
menu.add("Tail")
let n = 1
n += 2
let dateValue = getDateTime()
let month = dateValue.month
let hour = getDateTime().hour
let dow = getDateTime().weekdayNumber % 7 + 1
let dayOfYear = (getDate() - toDate("${getDate().year}-01-01")).days + 1
let sameDay = (toDate(dateValue) - toDate("${toDate(dateValue).year}-01-01")).days + 1
// NOTE SX_ROUNDING_TIES line 16: Java Math.round() rounds .5 toward positive infinity (-1.5 becomes -1); TeaseScript round() rounds ties away from zero (-1.5 becomes -2, V30 §13).
let days = round(n / 2)
// NOTE SX_SYSTEM_EXIT line 17: System.exit() closed the legacy application; TeaseScript exit ends the session but leaves the Player open.
if hour > 22 {
  exit
}
// Java date patterns: the ISO date is a machine format, other patterns are shown in the player's local form.
let stamp = getDate().toISO()
// NOTE SX_DATE_FORMAT line 20: Java formatted the current time with the pattern "HH:mm"; formatTime() shows the player's local form instead (#532).
say "Status of ${stamp} at ${getTime().formatTime()}, day ${dayOfYear} ${sameDay}"
// A date built from Unix seconds is the current moment minus the seconds since then, shown in the local date form.
let lockedSince = sexscriptLegacyLoadInteger("training.lockedSince", 1790000000)
// NOTE SX_DATE_FROM_SECONDS line 24: Workaround: TeaseScript builds no timestamp from a Unix number (#532), so the moment is the current timestamp minus the seconds since then; Java's pattern "dd, MMM, yyyy" becomes the player's local date form.
say "Locked since ${(getTimestamp() - (getTimestamp().toSeconds() - toInteger(lockedSince)) * 1 s).formatDate()}"
// A list + a value that may be a list or one element appends at runtime what Groovy appended.
function pickAll(impl) {
  return ([] + sexscriptLegacyListPart(impl)).length
}
say "Picked ${pickAll(["paddle", "cane"])} ${pickAll("belt")}"
// Groovy text * n and list * n repeat the text or the list's elements, a fractional n cut to whole times.
let chant = sexscriptLegacyRepeatList(["toy"], 2) + ["pet"]
let laughs = 2.5
// NOTE SX_LIST_JOIN line 31: The element types of this list are not proven; if it holds lists or maps, TeaseScript join() stops the script, where Groovy printed them as [a, b].
say "${chant.join(" ")} ${"ha".repeat(toInteger(laughs))}"
// The sum of a list that may be empty adds up in a whole number, and is null without elements, as Groovy's was.
let dayCount = askInteger "How many days?", default: 0
let collectResult = []
for day in 0..dayCount {
  collectResult.add(day * 2)
}
let sumTotal = 0
for item in collectResult {
  sumTotal += item
}
let total: integer? = sumTotal
if collectResult.length == 0 {
  total = null
}
say "Total ${total}"
exit
