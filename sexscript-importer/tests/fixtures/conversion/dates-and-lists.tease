let text = "Start"
text = "${text} and more"
let menu = ["Back"]
let extra = ["One", "Two"]
menu = ["Back"] + extra + ["Last"]
menu += extra
menu.add("Tail")
let n = 1
n += 2
let dateValue = getDateTime()
let month = dateValue.month
let hour = getDateTime().hour
let dow = getDateTime().weekdayNumber % 7 + 1
let dayOfYear = (getDate() - toDate("${getDate().year}-01-01")).days + 1
let sameDay = (toDate(dateValue) - toDate("${toDate(dateValue).year}-01-01")).days + 1
// NOTE SX_ROUNDING_TIES line 16: Java Math.round() rounds .5 toward positive infinity (-1.5 becomes -1); TeaseScript round() rounds ties away from zero (-1.5 becomes -2, V30 §13).
let days = round(n / 2)
// NOTE SX_SYSTEM_EXIT line 17: System.exit() closed the legacy application; TeaseScript exit ends the session but leaves the Player open.
if hour > 22 {
  exit
}
// Java date patterns: the ISO date is a machine format, other patterns are shown in the player's local form.
let stamp = getDate().toISO()
// NOTE SX_DATE_FORMAT line 20: Java formatted the current time with the pattern "HH:mm"; formatTime() shows the player's local form instead (#532).
say "Status of ${stamp} at ${getTime().formatTime()}, day ${dayOfYear} ${sameDay}"
// A date built from Unix seconds is the current moment minus the seconds since then, shown in the local date form.
let lockedSince = load "training.lockedSince", default: 1790000000
// NOTE SX_DATE_FROM_SECONDS line 24: Workaround: TeaseScript builds no timestamp from a Unix number (#532), so the moment is the current timestamp minus the seconds since then; Java's pattern "dd, MMM, yyyy" becomes the player's local date form.
say "Locked since ${(getTimestamp() - (getTimestamp().toSeconds() - toInteger(lockedSince)) * 1 s).formatDate()}"
exit
