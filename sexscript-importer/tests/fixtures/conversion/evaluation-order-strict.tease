let value = "old"
function change {
  value = "new"
  return true
}
let earlier = value
let conditional = "no"
if change() == true {
  conditional = "yes"
}
say prose "${earlier}${conditional}", instant
function yesText {
  say prose "Before", instant
  return "Yes"
}
let option = yesText()
say prose "Question", instant
let result = askBoolean yesText: option
function getRandom(maxValue) {
  return maxValue - 1
}
let xs = [1, 2, 3]
say prose "Pick ${xs[getRandom(xs.length)]}", instant
let count = 0
let ready = false
// NOTE SX_NULL_ONLY_VARIABLE line 11: question is never given a value in the legacy script, so it only held null; the conversion leaves it out and reads null where it was read.
let answer = askText().replace("\n", " ")
say prose "Ready?", instant
let ignoredAnswer1 = askBoolean
let match = 1
if count == match {
  say prose "matched", instant
} else if [1, 2].contains(count) {
  say prose "small", instant
}
exit
