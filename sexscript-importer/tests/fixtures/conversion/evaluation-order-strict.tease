let value = "old"
function change {
  value = "new"
  return true
}
let earlier = value
let conditional = "no"
if change() == true {
  conditional = "yes"
}
say "${earlier}${conditional}"
function yesText {
  say "Before"
  return "Yes"
}
let option = yesText()
say "Question"
let result = (choose yes: option, no: "No") == "yes"
function getRandom(maxValue) {
  return maxValue - 1
}
let xs = [1, 2, 3]
say "Pick ${xs[getRandom(xs.length)]}"
