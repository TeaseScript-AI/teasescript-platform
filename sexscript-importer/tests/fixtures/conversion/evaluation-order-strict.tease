let value = "old"
function change {
  value = "new"
  return true
}
let earlier = value
let conditional = "no"
if change() == true {
  conditional = "yes"
}
say "${earlier}${conditional}"
function yesText {
  say "Before"
  return "Yes"
}
let option = yesText()
let result = askBoolean "Question", yesText: option
function getRandom(maxValue) {
  return maxValue - 1
}
let xs = [1, 2, 3]
say "Pick ${xs[getRandom(xs.length)]}"
let count = 0
let ready = false
let question = null
if question != null {
  say question
}
let answer = askText().replace("\n", " ")
let ignoredAnswer1 = askBoolean "Ready?"
let match = 1
if count == match {
  say "matched"
} else if [1, 2].contains(count) {
  say "small"
}
exit
