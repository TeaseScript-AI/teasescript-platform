let flag = false
function change {
  flag = true
  return ""
}
let earlier = change()
let conditional = "no"
if flag {
  conditional = "yes"
}
say "${earlier}${conditional}"
let conditional2 = false
if conditional2 {
  if flag {
    conditional2 = true
  } else {
    conditional2 = false
  }
}
say conditional2
let conditional3 = false
if conditional3 {
  say "Never ask"
  conditional3 = askText() != ""
}
if conditional3 {
  say "yes"
}
let value = "old"
let answer = "yes"
if flag != true {
  answer = value
}
let conditional4 = "C"
if flag {
  conditional4 = "B"
}
let combined = "A${conditional4}"
say "${combined}${answer}"
let n = 0
function bump {
  n += 1
  return "prefill"
}
