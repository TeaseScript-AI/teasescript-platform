say "Strict?"
if (choose yes: "Yes", no: "No") == "yes" {
  say "Strict"
} else {
  say "Gentle"
}
let i: number = 0
while i < 2 {
  say "Round"
  say "Next"
  i = askNumber
}
// An increment used as a value follows the statement when nothing else in it reads the variable.
let rules = ["Kneel", "Wait"]
let r = 0
say rules[r]
r += 1
