function sexscriptLegacyValue(value) {
  return value
}
// A question that && or || guards is asked only where Groovy's short circuit reached it.
// NOTE SX_LOAD_OPEN_NULL line 2: Legacy read null for a missing key and filled the value in before using it, which the compiler cannot prove, so this read keeps that null of an open type, checked where it is used, and its key has no declared type.
let name = load "training.name", default: sexscriptLegacyValue(null)
while true {
  let answered = false
  if name == null {
    answered = true
  } else {
    say "Is ${name} your name?"
    answered = (choose yes: "Yes", no: "No") != "yes"
  }
  if not answered {
    break
  }
  name = askText "What is your name?", default: "slave"
}
let conditional = name.length > 3
if conditional {
  say "May I shorten it?"
  conditional = (choose yes: "Yes", no: "No") == "yes"
}
if conditional {
  say "Hello, ${name.substring(0, 3)}"
}
say "Hello, ${name}"
exit
