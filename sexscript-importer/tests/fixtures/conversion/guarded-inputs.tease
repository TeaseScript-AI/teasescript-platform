// A question that && or || guards is asked only where Groovy's short circuit reached it.
let name = load "training.name", default: ""
while true {
  let answered = false
  if name == "" {
    answered = true
  } else {
    say prose "Is ${name} your name?", instant
    answered = not askBoolean()
  }
  if not answered {
    break
  }
  say prose "What is your name?", instant
  name = askText(prefill: "slave").replace("\n", " ")
}
let conditional = name.length > 3
if conditional {
  say prose "May I shorten it?", instant
  conditional = askBoolean
}
if conditional {
  say prose "Hello, ${name.substring(0, 3)}", instant
}
say prose "Do you remember the contract?", instant
let conditional2 = askBoolean() or true
if conditional2 {
  say prose "Did you read it?", instant
  conditional2 = askBoolean
}
if conditional2 {
  say prose "Will you take the consequences?", instant
  conditional2 = askBoolean
}
if conditional2 {
  say prose "Then we begin.", instant
}
say prose "Hello, ${name}", instant
exit
