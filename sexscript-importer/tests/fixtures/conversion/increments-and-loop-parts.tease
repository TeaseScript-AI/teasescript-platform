// A C-style loop may leave out its start or name the counter without a value; neither part does anything.
let count = 3
let turn = 0
while count > 0 {
  say prose "Count ${count}", instant
  count -= 1
}
while turn < 2 {
  say prose "Turn ${turn}", instant
  turn += 1
}
// As a statement, a prefix increment changes the variable as a postfix one does.
turn += 1
// An increment may change a list element or a property.
let tally = [0, 0, 0, 0]
tally[turn] += 1
tally[0] -= 1
let stats = { score: 1 }
// NOTE SX_SHARED_MAP_WRITE line 13: Groovy maps are shared by reference; if this map came from a list, a parameter, or another variable, the TeaseScript write changes only this copy (ADR 0014).
stats.score += 1
// A computed index is computed once, before the update when it has effects.
tally[turn - 1] += 1
function slot(value) {
  return value % 4
}
let index = slot(7)
tally[index] += 1
say prose "Tally ${tally[3]} ${tally[0]}, score ${stats.score}", instant
// A later loop in a nested block may declare the counter of an earlier loop again.
for i in 0..2 {
  say prose "Warm up ${i}", instant
}
if askBoolean "Again?" {
  for i in 0..3 {
    say prose "Again ${i}", instant
  }
}
// A prefix increment inside an expression changes the variable before the statement; for (;;) loops until a break.
let lives = 3
lives += 1
let capped = min(lives, 10)
while true {
  lives -= 1
  if lives < 2 {
    break
  }
}
say prose "Capped ${capped}, lives ${lives}", instant
// A for-in loop whose body is a single statement without braces.
let cards = [2, 3, 4]
let score = 0
for card in cards {
  score += card
}
say prose "Score: ${score}", instant
// A range up to a value that may hold a fraction iterates up to the whole number below it, as Groovy did.
let swats = 17
let perCheek = swats / 2
let swatTo = floor(perCheek)
for swatOffset in 0..=floor(abs(swatTo - 1)) {
  let swat = 1 + swatOffset * sign(swatTo - 1)
  say prose "Swat ${swat}", instant
}
// An increment in an argument of a function that reads the counter keeps the old value first and counts before the
// call, as Groovy did (Domme2's rules); one that the statement assigns over counts first (ShockReflex's power level).
let rules = ["Kneel", "Wait"]
let ruleNumber = 0
function showRule(text) {
  say prose "Rule ${ruleNumber}: ${text}", instant
}
for it in rules {
  let ruleNumberBefore = ruleNumber
  ruleNumber += 1
  showRule(rules[ruleNumberBefore])
}
let powerLevel = 4
powerLevel += 1
powerLevel = toInteger(min(powerLevel, 5))
say prose "Power ${powerLevel}", instant
// A conditional start or step of a C-style for is computed first, as in a statement (MatchDares' shuffled deck).
let deckStart = askInteger "Shuffle?", prefill: 1
let card = 3
if deckStart == 1 {
  card = 2
}
while card <= 5 {
  say prose "Card ${card}", instant
  if deckStart == 1 {
    card += 1
  } else {
    card += 2
  }
}
// A counter declared without a value that only loops use, each of which sets it first, is declared by each loop.
function findFirst(listValue, from) {
  if from < 0 {
    // NOTE SX_LENGTH_RECEIVER line 58: Groovy size() also worked on a map; text, lists, and dicts have a length, but if this value is an object with fixed properties, length stops the script.
    let at = listValue.length - 1
    while at > 0 {
      if listValue[at] > 2 {
        return at
      }
      at -= 1
    }
    return -1
  }
  // NOTE SX_LENGTH_RECEIVER line 61: Groovy size() also worked on a map; text, lists, and dicts have a length, but if this value is an object with fixed properties, length stops the script.
  let at = from
  while at < listValue.length {
    if listValue[at] > 2 {
      return at
    }
    at += 1
  }
  return -1
}
say prose "First ${findFirst([1, 3, 5], 0)}", instant
// A counter whose loop sets it with a conditional, or that a closure's default reads, stays declared where it was.
let roundValue = 0
if randomInteger(0..1) == 0 {
  roundValue = 1
} else {
  roundValue = 2
}
while roundValue < 3 {
  say prose "Round ${roundValue}", instant
  roundValue += 1
}
let lap = 0
function lastLap(seen = lap) {
  return seen
}
lap = 0
while lap < 2 {
  say prose "Lap ${lap}", instant
  lap += 1
}
say prose "Last lap ${lastLap()}", instant
exit
