// Inputs that pre-fill a value the player can accept or change.
let level = 3
say "What is your name?"
let name = askText default: "slave"
say "Set your level"
let newLevel = askInteger default: level
say "Your weight in kg?"
let weight = askNumber default: 70.5
// Legacy showed any default as text, a list as [a, b].
say "Your code?"
let code = askText default: "${level}"
let toys = ["plug", "clamps"]
say "Which toys?"
let wanted = askText default: "[${toys.join(", ")}]"
say "${name}: level ${newLevel}, ${weight} kg, code ${code}, toys ${wanted}"
