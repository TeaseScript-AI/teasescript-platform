function sexscriptLegacyAskInteger(prefill) {
  if prefill is number {
    if prefill % 1 == 0 {
      return askInteger default: floor(prefill)
    }
  }
  return askInteger
}
// Inputs that pre-fill a value the player can accept or change.
let level = 3
say "What is your name?"
let name = askText default: "slave"
say "Set your level"
let newLevel = askInteger default: level
say "Your weight in kg?"
let weight = askNumber default: 70.5
// Legacy showed any default as text, a list as [a, b].
say "Your code?"
let code = askText default: "${level}"
let toys = ["plug", "clamps"]
say "Which toys?"
let wanted = askText default: "[${toys.join(", ")}]"
// An integer input's default that may hold a fraction asks without it then; Groovy found no method for a fraction.
let total = 0
total += level / 2
// NOTE SX_INPUT_PREFILL line 13: getInteger() pre-filled its field with this value, also when it was null; a TeaseScript default must be a whole number, so a helper asks without the default when it is not.
say "How many did you do?"
let counted = sexscriptLegacyAskInteger(total)
say "${name}: level ${newLevel}, ${weight} kg, code ${code}, toys ${wanted}, ${counted} done"
exit
