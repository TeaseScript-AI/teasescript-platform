say "What is your name?"
let name = askText
say "Your weight?"
let weight = askNumber default: 0
say "Hello ${name}, you said ${weight}."
say "Choose a task"
let task = choose 0: "Kneel", 1: "Wait", 2: "Count"
while true {
  say "Ready?"
  if (choose 0: "No", 1: "Yes") != 0 {
    break
  }
  say "Then wait."
  timer 10
}
wait 500 ms
if name != "" {
  say "Good, ${name}"
}
// The question of an endless loop's condition is asked again in every round.
let round = 0
while true {
  say "Round ${round}"
  let ignoredAnswer1 = askText
  round += 1
  if round == 2 {
    break
  }
}
