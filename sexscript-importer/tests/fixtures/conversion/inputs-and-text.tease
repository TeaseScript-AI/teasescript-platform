say "What is your name?"
let name = askText
// NOTE SX_INPUT_PREFILL line 2: getFloat() pre-filled its field with a default value; TeaseScript single-field input has no prefill, so the player must type it.
say "Your weight?"
let weight = askNumber
say "Hello ${name}, you said ${weight}."
say "Choose a task"
let task = choose 0: "Kneel", 1: "Wait", 2: "Count"
while true {
  say "Ready?"
  if (choose 0: "No", 1: "Yes") != 0 {
    break
  }
  say "Then wait."
  timer 10
}
wait 500 ms
if name != "" {
  say "Good, ${name}"
}
