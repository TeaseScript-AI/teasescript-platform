let name = askText("What is your name?").replace("\n", " ")
let weight = askNumber "Your weight?", prefill: 0
say "Hello ${name}, you said ${weight}."
say "Choose a task"
let task = choose 0: "Kneel",
  1: "Wait",
  2: "Count"
while true {
  say "Ready?"
  if (choose 0: "No", 1: "Yes") != 0 {
    break
  }
  say "Then wait."
  timer 10 s
}
wait 500 ms
if name != "" {
  say "Good, ${name}"
}
// The question of an endless loop's condition is asked again in every round.
let roundValue = 0
while true {
  let ignoredAnswer1 = askText "Round ${roundValue}"
  roundValue += 1
  if roundValue == 2 {
    break
  }
}
// A question in a variable that never holds null needs no test before it is shown, also when the variable holds a
// list elsewhere.
// NOTE SX_UNION_TYPE line 19: Groovy let 'question' hold values of several types; TeaseScript declares it 'string | string[]' (ADR 0021 §3), so a use that needs one of these types must test it first, as in: if question is string { ... }
let question: string | string[] = "Ready?"
function menu {
  question = ["Yes", "No"]
}
question = "Kneel?"
let kneel = askBoolean question
// A question read from storage may be null, which kept the current text, so it is still tested.
let stored = load "question", default: ""
if stored != "" {
  say stored
}
let answer = askText().replace("\n", " ")
// A question that may be null elsewhere needs no test right after it was set to text.
stored = "Ready now?"
let ready = askBoolean stored
// A character of a text is its one-character substring, also counted from the end.
let code = askText("Square?", prefill: "B4").replace("\n", " ")
say "Row ${code.substring(0, 1)}, column ${code.substring(code.length - 1)}"
// Button texts that call a function are computed before the question, in order, as Groovy evaluated them first.
function honorific {
  return "Miss"
}
let question2 = "Ready, ${honorific()}?"
let option = "Yes, ${honorific()}"
if askBoolean question2, yesText: option {
  say "Good."
}
// A range goes through its values with their positions.
let position = 0
for value in 5..=6 {
  say "${position}: ${value}"
  position += 1
}
// FirstTimeCuckold episode 2: a button text that reads a stored name shows an empty text for a missing one, as the
// legacy button did, also where it is an askBoolean's noText.
if askBoolean "Who controls the key?", yesText: "I do", noText: "${load("cuckold.hotwife", default: "")} has it" {
  say "Fine."
}
// show() returned null, so a menu whose message is show(text) showed the text and then its options.
let menuText = "Main menu"
say menuText
let menuChoice = choose 0: "Start", 1: "End"
say "Chose ${menuChoice}"
// A gauge wait of a negative number of seconds did not wait at all, so seconds not certain to be at least 0 count
// from 0; a literal, a random number, and their sums are certain.
let penalty = [-60, 0]
penalty[0] = penalty[0] + 30
timer max(penalty[0], 0) s
timer (randomInteger(0..3) + 1) s
say "Gauges done"
exit
