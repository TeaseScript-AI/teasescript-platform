function sexscriptLegacyArray(size, value) {
  let items = []
  repeat size {
    items.add(value)
  }
  return items
}
let seen = sexscriptLegacyArray(3, null)
seen[1] = true
if seen[0] != true {
  say "First time"
}
let weights = sexscriptLegacyArray(2, 0)
weights[0] = weights[0] + 1.5
say "Count ${weights.length}"
