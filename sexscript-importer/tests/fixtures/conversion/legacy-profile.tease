function sexscriptLegacyValue(value) {
  return value
}
speaker system {
  title: "System"
}
function sexscriptLegacyAskProfile {
  let savedName: string? = load "intro.name", default: null
  if savedName == null {
    save (askText as system "What is your name?", default: "Slave") as "intro.name"
  }
  let savedFemale: boolean? = load "intro.female", default: null
  if savedFemale == null {
    say as system "Are you a woman ?"
    save (choose yes: "Yes", no: "No") == "yes" as "intro.female"
  }
  let savedLikemale: boolean? = load "intro.likemale", default: null
  if savedLikemale == null {
    // NOTE SX_LOAD_OPEN_NULL: Legacy read null for a missing key; nothing tells this key's type where a load could declare it, so this read keeps that null of an open type, checked where it is used.
    if load("intro.likefemale", default: sexscriptLegacyValue(null)) == true {
      say as system "Are you also attracted to men ?"
      save (choose yes: "Yes", no: "No") == "yes" as "intro.likemale"
    } else {
      save true as "intro.likemale"
    }
  }
  let profileToysFields = dict{}
  let profileToysIndex = 0
  for profileToysKey in ["toys.dildo"] {
    if load(profileToysKey, default: null) == null {
      profileToysFields[profileToysKey] = { value: false, text: ["dildo"][profileToysIndex] }
    }
    profileToysIndex += 1
  }
  if profileToysFields.length > 0 {
    let profileToysAnswers = askForm as system "What do you have in your toy chest ?", fields: profileToysFields
    for profileToysKey in profileToysAnswers {
      save profileToysAnswers[profileToysKey] as profileToysKey
    }
  }
}
// NOTE SX_LEGACY_PROFILE: The legacy desktop player's intro and options asked the player's profile (intro.female, intro.likemale, intro.name, toys.dildo) once; this package asks what is missing and saves it under the same keys; storage is per package, so each package asks once.
sexscriptLegacyAskProfile()
// The legacy desktop intro asked the player's name and gender once; a package that only reads them asks once.
let gender = "boy"
if load("intro.female", default: false) == true {
  gender = "girl"
}
say "Hello, ${load("intro.name", default: "")}, my good ${gender}"
if load("intro.likemale", default: false) == true {
  say "You like men too"
}
if load("toys.dildo", default: false) != true {
  say "A dildo or dildo alternative is needed"
}
exit
