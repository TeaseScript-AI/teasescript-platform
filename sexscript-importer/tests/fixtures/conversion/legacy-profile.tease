speaker system {
  title: "System"
}
function sexscriptLegacyAskBooleansSystem(message, texts, defaults) {
  let selected = []
  let index = 0
  for text in texts {
    selected.add(index < defaults.length and defaults[index] == true)
    index += 1
  }
  say as system message
  let done = false
  while not done {
    let buttons = []
    index = 0
    for text in texts {
      let mark = "☐"
      if selected[index] {
        mark = "☑"
      }
      buttons.add({ value: index, text: "${mark} ${text}" })
      index += 1
    }
    buttons.add({ value: texts.length, text: "Done" })
    let picked = choose buttons
    if picked == texts.length {
      done = true
    } else {
      selected[picked] = not selected[picked]
    }
  }
  return selected
}
function sexscriptLegacyAskProfile {
  if load("intro.name") == null {
    save (askText as system "What is your name?", default: "Slave") as "intro.name"
  }
  if load("intro.female") == null {
    say as system "Are you a woman ?"
    save (choose yes: "Yes", no: "No") == "yes" as "intro.female"
  }
  if load("intro.likemale") == null {
    if load("intro.likefemale") == true {
      say as system "Are you also attracted to men ?"
      save (choose yes: "Yes", no: "No") == "yes" as "intro.likemale"
    } else {
      save true as "intro.likemale"
    }
  }
  let profileToysKeys: string[] = []
  let profileToysNames: string[] = []
  let profileToysDefaults: boolean[] = []
  let profileToysIndex = 0
  for profileToysKey in ["toys.dildo"] {
    if load(profileToysKey) == null {
      profileToysKeys.add(profileToysKey)
      profileToysNames.add(["dildo"][profileToysIndex])
      profileToysDefaults.add(false)
    }
    profileToysIndex += 1
  }
  if profileToysKeys.length > 0 {
    let profileToysAnswers = sexscriptLegacyAskBooleansSystem("What do you have in your toy chest ?", profileToysNames, profileToysDefaults)
    profileToysIndex = 0
    for profileToysKey in profileToysKeys {
      save profileToysAnswers[profileToysIndex] as profileToysKey
      profileToysIndex += 1
    }
  }
}
// NOTE SX_LEGACY_PROFILE: The legacy desktop player's intro and options asked the player's profile (intro.female, intro.likemale, intro.name, toys.dildo) once; this package asks what is missing and saves it under the same keys; storage is per package, so each package asks once.
sexscriptLegacyAskProfile()
// The legacy desktop intro asked the player's name and gender once; a package that only reads them asks once.
let gender = "boy"
if load("intro.female") == true {
  gender = "girl"
}
say "Hello, ${load("intro.name")}, my good ${gender}"
if load("intro.likemale") == true {
  say "You like men too"
}
if load("toys.dildo") != true {
  say "A dildo or dildo alternative is needed"
}
exit
