function sexscriptLegacyAskBooleans(message, texts, defaults) {
  let answers = []
  let confirmed = false
  while not confirmed {
    answers = []
    say message
    let index = 0
    for text in texts {
      let yes = "Yes"
      let no = "No (preset)"
      if index < defaults.length and defaults[index] == true {
        yes = "Yes (preset)"
        no = "No"
      }
      say text
      answers.add((choose yes: yes, no: no) == "yes")
      index += 1
    }
    confirmed = (choose confirm: "Confirm", change: "Change answers") == "confirm"
  }
  return answers
}
function sexscriptLegacyAskProfile {
  if (load "intro.name") == null {
    say "What is your name, here ?"
    save askText default: "Slave" as "intro.name"
  }
  if (load "intro.female") == null {
    say "Are you a woman ?"
    save (choose yes: "Yes", no: "No") == "yes" as "intro.female"
  }
  if (load "intro.likemale") == null {
    if (load "intro.likefemale") == true {
      say "Are you also attracted to men ?"
      save (choose yes: "Yes", no: "No") == "yes" as "intro.likemale"
    } else {
      save true as "intro.likemale"
    }
  }
  let profileToysKeys: string[] = []
  let profileToysNames: string[] = []
  let profileToysDefaults: boolean[] = []
  let profileToysIndex = 0
  for profileToysKey in ["toys.dildo"] {
    if (load profileToysKey) == null {
      profileToysKeys.add(profileToysKey)
      profileToysNames.add(["dildo"][profileToysIndex])
      profileToysDefaults.add(false)
    }
    profileToysIndex += 1
  }
  if profileToysKeys.length > 0 {
    let profileToysAnswers = sexscriptLegacyAskBooleans("What do you have in your toy chest ?", profileToysNames, profileToysDefaults)
    profileToysIndex = 0
    for profileToysKey in profileToysKeys {
      save profileToysAnswers[profileToysIndex] as profileToysKey
      profileToysIndex += 1
    }
  }
}
// NOTE SX_LEGACY_PROFILE: The legacy desktop player's intro and options asked the player's profile (intro.female, intro.likemale, intro.name, toys.dildo) once; this package asks what is missing here and saves it under the same keys, so other packages reuse the answers.
sexscriptLegacyAskProfile()
// The legacy desktop intro asked the player's name and gender once; a package that only reads them asks once.
let gender = "boy"
if (load "intro.female") == true {
  gender = "girl"
}
say "Hello, ${load "intro.name"}, my good ${gender}"
if (load "intro.likemale") == true {
  say "You like men too"
}
if (load "toys.dildo") != true {
  say "A dildo or dildo alternative is needed"
}
exit
