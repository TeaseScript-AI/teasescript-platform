function sexscriptLegacyRandom(limit) {
  if limit == null {
    return randomInteger(0..100)
  }
  let bound = limit - limit % 1
  if bound > 0 {
    return randomInteger(0..bound)
  }
  if bound < 0 {
    return -randomInteger(0..-bound)
  }
  return 0
}
// NOTE SX_BINDING_VARIABLE: Groovy kept counter, level, which functions assign without a declaration, in the script's binding that every function shares; they are declared at the top of the script with an empty value.
let counter = 0
let level = null
// A closure named like a SexScript method calls that method inside its own body, where the variable is not defined yet.
function getRandom(low, high) {
  // NOTE SX_PLUS_OPERAND_TYPE line 2: Groovy + operands are not proven numeric; TeaseScript + adds two numbers or joins two texts or two lists, not mixed values. Use interpolation if this joins text.
  return low + sexscriptLegacyRandom(high - low)
}
say "Roll ${getRandom(3, 6)}"
// A closure of one parameter called without an argument gets null.
function greet(who) {
  if who == null {
    say "Hello"
  } else {
    say "Hello ${who}"
  }
}
greet(null)
// A local closure named sleep is called instead of Groovy sleep(milliseconds).
function sleep {
  say "You fall asleep."
}
sleep()
// A flag that later holds a number is false at 0, as Groovy truth was.
// NOTE SX_UNION_TYPE line 11: Groovy let 'playing' hold values of several types; TeaseScript declares it 'boolean | integer' (ADR 0021 §3), so a use that needs one of these types must test it first, as in: if playing is boolean { ... }
let playing: boolean | integer = true
while (playing is boolean and playing == true) or (playing is number and playing != 0) {
  say "Stop?"
  if (choose yes: "Yes", no: "No") == "yes" {
    playing = 0
  }
}
// A variable a closure assigns without a declaration lived in the script binding that every closure shares.
function countUp {
  counter = 0
  counter = counter + 1
}
countUp()
say "Counted ${counter}"
// Another closure's parameter of the same name, or an implicit `it`, declares it only inside that closure.
let mood: string? = "calm"
function setMood {
  level = "high"
  mood = level
}
function describe(levelValue) {
  say "Level ${levelValue}"
}
function again(it = null) {
  it = "x"
  say it
}
setMood()
describe(level)
again()
exit
