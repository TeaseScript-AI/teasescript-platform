// Groovy 2.5 push() puts the value first, as a stack's push; leftShift() appends like <<.
let rules = ["Kneel"]
rules = ["Listen"] + rules
rules.add("Obey")
say prose "First rule: ${rules[0]}, last: ${rules[2]}", instant
// addAll() appends another list's elements in place.
let extras = ["Kneel"]
extras.addAll(["Wait", "Listen"])
say prose "${extras.length} rules", instant
exit
