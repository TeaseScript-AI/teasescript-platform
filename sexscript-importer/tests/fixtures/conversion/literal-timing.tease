function sexscriptLegacyPlainText(value) {
  return "${value}".replace(/\*|~~|\[\/?u\]|\[color=[^\]]*\]|\[\/color\]/, "")
}
// Literal timing (owner decision 2026-10-11): every shown text is said at once, as legacy show() displayed it, and
// every legacy wait stays with its exact duration, also in milliseconds, around buttons, asks, media, and loops.
showButton "Start"
say prose "Do ten push-ups now.", instant
wait 30 s
say prose "Well done.", instant
wait 2 s
say prose "Breathe.", instant
wait 1500 ms

// Before a button.
say prose "Ready?", instant
wait 1 s
showButton "Yes"

// Across other statements and branches.
say prose "Good.", instant
wait 1 s
let reps = 20
say prose "Now hold it.", instant
wait 30 s
if reps > 10 {
  say prose "Steady.", instant
  wait 1 s
}
say prose "Now relax.", instant
wait 20 s
say prose "Look at me.", instant
wait 1 s
showButton "Done"
say prose "Stay there.", instant
wait 30 s

// A count without letters, and a loop's tick after a text that the loop builds anew each pass.
say prose "3", instant
wait 1 s
say prose "2", instant
wait 1 s
let left = 3
while left > 0 {
  say prose "Starting in ${left}", instant
  wait 1 s
  left -= 1
}
// A text with paragraphs is one message, said at once, and the wait after it stays whole.
say prose """
  First paragraph has a few words.

  Second paragraph.

  Last one.
""", instant
wait 20 s
say prose """
  One.

  Two.

  Three.

  Four.

  Five.
""", instant
wait 5 s

// A computed wait, and a run of waits; a sum takes parentheses before its unit.
let n = askInteger prose "How long?", prefill: 3
say prose "Waiting ${n} seconds.", instant
wait n s
say prose "Hold it.", instant
wait (15 + randomInteger(0..35)) s
say prose "Pause", instant
wait 1 s
wait 2 s
say prose "Done.", instant

// Beats, numbers, and an animation, whose steps change one message.
say prose "Get ready.", instant
wait 1 s
say prose "10", instant
wait 3 s
say prose 5, instant
wait 1 s
say prose "Good.", instant
wait 1 s
let line = say prose "Wait.", instant
wait 1 s
line.text += "."
wait 1 s
line.text += "."
wait 1 s
// A tick with paragraphs.
left = 3
while left > 0 {
  say prose """
    Starting soon.

    Starting in ${left}
  """, instant
  wait 1 s
  left -= 1
}
// DisciplineClinic Punish spank(): a sound that starts between a stroke's text and its wait keeps its place.
let message = "Right cheek"
let counting = false
let tempTime = 0.5
for tempSpankCount in 1..=3 {
  if counting {
    say prose "[size=x-large]**${message}**[/size]", instant
  } else {
    say prose """
      [size=x-large]**${message}**[/size]
      [size=x-large]**.${tempSpankCount}.**[/size]
    """, instant
  }
  playAudio async "DisciplinePack/hand${1 + randomInteger(0..3)}.wav"
  wait tempTime s
}
// DisciplineClinic Punish: a long text with paragraphs before a run of waits.
say prose """
  You've created a bunch of paperwork for me to document this.

  So you can expect me to be extra strict this time
""", instant
wait 4 s
wait 3 s
// Domme3 maintenance: a text with paragraphs before a button.
say prose "You did well. \n\nI'm proud of you! \n\nGet dressed.", instant
wait 7 s
showButton "Thanks, Miss."
// Domme3 punishment: a text with paragraphs before a call that may say a text.
function counted(messageValue) {
  say prose """
    ${messageValue}

    0
  """, instant
  wait 3 s
}
say prose "These last fifteen ... \n\nwill be slower ... \n\nand harder!", instant
wait 7 s
counted("Alternating cheeks.")
// BreatheAcademy waitWithCountDownSound: a countdown with a step between its text and its computed wait.
function countDown(text, timeValue, speed) {
  let leftValue = timeValue / speed
  let itTo = floor(timeValue / speed)
  for itOffset in 0..=floor(abs(itTo - 1)) {
    say prose """
      ${text}

      ${toInteger(leftValue * speed)} seconds
    """, instant
    leftValue -= 1
    wait speed s
  }
}
countDown("Hold your breath", 3, 0.5)
// BreatheAcademy showDynamically: a text typed out a character at a time.
let textSpeed = 2
let typed = ""
for c in sexscriptLegacyPlainText("Ready").split("") {
  typed = "${typed}${c}"
  say prose typed, instant
  wait (1 / textSpeed) s
}
// A step of a count between a text and a short literal wait.
let breaths = 0
say prose "Breathe in slowly.", instant
breaths += 1
wait 2 s
// A clock reading between a text and its wait.
say prose "Keep holding until the wait is over.", instant
let started = getAbsoluteDateTime()
wait 2 s
let elapsed = getAbsoluteDateTime() - started
if elapsed < 2 s {
  say prose "Too soon", instant
} else {
  say prose "Held", instant
}
// A text that only switch cases set is said where it is not empty, and its wait stays on every path.
let tick = ""
for nValue in 0..2 {
  switch nValue {
    case 0 {
      tick = "Tick ${nValue}"
    }
    default {
      tick = "Tock ${nValue}"
    }
  }
  if tick != "" {
    say prose tick, instant
  }
  wait 0.5 s
}
let reply = ""
switch randomInteger(0..3) {
  case 0 {
    reply = "Good."
  }
  case 1 {
    reply = "Again."
  }
}
if reply != "" {
  say prose reply, instant
}
wait 2 s
say prose "Done", instant
// A sound between such a text and its wait.
let cue = ""
switch randomInteger(0..2) {
  case 0 {
    cue = "Listen."
  }
}
if cue != "" {
  say prose cue, instant
}
playAudio async "beat.wav"
wait 2 s
say prose "Heard", instant
exit
