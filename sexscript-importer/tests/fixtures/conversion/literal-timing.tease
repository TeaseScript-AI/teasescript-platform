function sexscriptLegacyPlainText(value) {
  let text = "${value}".replace("**", "").replace("~~", "").replace("[u]", "").replace("[/u]", "").replace("[/color]", "")
  let start = text.indexOf("[color=")
  while start >= 0 {
    let endValue = text.indexOf("]")
    if endValue < start {
      return text.replace("*", "")
    }
    text = "${text.substring(0, start)}${text.substring(endValue + 1)}"
    start = text.indexOf("[color=")
  }
  return text.replace("*", "")
}
// Literal timing (owner decision 2026-10-11): every shown text is said at once, as legacy show() displayed it, and
// every legacy wait stays with its exact duration, also in milliseconds, around buttons, asks, media, and loops.
showButton "Start"
say "Do ten push-ups now.", instant
wait 30 s
say "Well done.", instant
wait 2 s
say "Breathe.", instant
wait 1500 ms

// Before a button.
say "Ready?", instant
wait 1 s
showButton "Yes"

// Across other statements and branches.
say "Good.", instant
wait 1 s
let reps = 20
say "Now hold it.", instant
wait 30 s
if reps > 10 {
  say "Steady.", instant
  wait 1 s
}
say "Now relax.", instant
wait 20 s
say "Look at me.", instant
wait 1 s
showButton "Done"
say "Stay there.", instant
wait 30 s

// A count without letters, and a loop's tick after a text that the loop builds anew each pass.
say "3", instant
wait 1 s
say "2", instant
wait 1 s
let left = 3
while left > 0 {
  say "Starting in ${left}", instant
  wait 1 s
  left -= 1
}
// A split text: each paragraph is said at once, and the wait after it stays whole.
say "First paragraph has a few words.", instant
say "Second paragraph.", instant
say "Last one.", instant
wait 20 s
say "One.", instant
say "Two.", instant
say "Three.", instant
say "Four.", instant
say "Five.", instant
wait 5 s

// A computed wait, and a run of waits; a sum takes parentheses before its unit.
let n = askInteger "How long?", prefill: 3
say "Waiting ${n} seconds.", instant
wait n s
say "Hold it.", instant
wait (15 + randomInteger(0..35)) s
say "Pause", instant
wait 1 s
wait 2 s
say "Done.", instant

// Beats, numbers, and an animation, whose steps change one message.
say "Get ready.", instant
wait 1 s
say "10", instant
wait 3 s
say 5, instant
wait 1 s
say "Good.", instant
wait 1 s
let line = say "Wait.", instant
wait 1 s
line.text += "."
wait 1 s
line.text += "."
wait 1 s
// A split tick.
left = 3
while left > 0 {
  say "Starting soon.", instant
  say "Starting in ${left}", instant
  wait 1 s
  left -= 1
}
// DisciplineClinic Punish spank(): a sound that starts between a stroke's text and its wait keeps its place.
let message = "Right cheek"
let counting = false
let tempTime = 0.5
for tempSpankCount in 1..=3 {
  if counting {
    say "[size=x-large]**${message}**[/size]", instant
  } else {
    say """
      [size=x-large]**${message}**[/size]
      [size=x-large]**.${tempSpankCount}.**[/size]
    """, instant
  }
  playAudio async "DisciplinePack/hand${1 + randomInteger(0..3)}.wav"
  wait tempTime s
}
// DisciplineClinic Punish: a long split text before a run of waits.
say "You've created a bunch of paperwork for me to document this.", instant
say "So you can expect me to be extra strict this time", instant
wait 4 s
wait 3 s
// Domme3 maintenance: a split text before a button.
say "You did well.", instant
say "I'm proud of you!", instant
say "Get dressed.", instant
wait 7 s
showButton "Thanks, Miss."
// Domme3 punishment: a split text before a call that may say a text.
function counted(messageValue) {
  say "${messageValue}", instant
  say "0", instant
  wait 3 s
}
say "These last fifteen ...", instant
say "will be slower ...", instant
say "and harder!", instant
wait 7 s
counted("Alternating cheeks.")
// BreatheAcademy waitWithCountDownSound: a countdown with a step between its text and its computed wait.
function countDown(text, timeValue, speed) {
  let leftValue = timeValue / speed
  let itTo = floor(timeValue / speed)
  for itOffset in 0..=floor(abs(itTo - 1)) {
    let it = 1 + itOffset * sign(itTo - 1)
    say "${text}", instant
    say "${toInteger(leftValue * speed)} seconds", instant
    leftValue -= 1
    wait speed s
  }
}
countDown("Hold your breath", 3, 0.5)
// BreatheAcademy showDynamically: a text typed out a character at a time.
let textSpeed = 2
let typed = ""
for c in sexscriptLegacyPlainText("Ready").split("") {
  typed = "${typed}${c}"
  say typed, instant
  wait (1 / textSpeed) s
}
// A step of a count between a text and a short literal wait.
let breaths = 0
say "Breathe in slowly.", instant
breaths += 1
wait 2 s
// A clock reading between a text and its wait.
say "Keep holding until the wait is over.", instant
let started = getAbsoluteDateTime().toSeconds()
wait 2 s
let elapsed = getAbsoluteDateTime().toSeconds() - started
if elapsed < 2 {
  say "Too soon", instant
} else {
  say "Held", instant
}
// A text that only switch cases set is said where it is not empty, and its wait stays on every path.
let tick = ""
for nValue in 0..2 {
  switch nValue {
    case 0 {
      tick = "Tick ${nValue}"
    }
    default {
      tick = "Tock ${nValue}"
    }
  }
  if tick != "" {
    say tick, instant
  }
  wait 0.5 s
}
let reply = ""
switch randomInteger(0..3) {
  case 0 {
    reply = "Good."
  }
  case 1 {
    reply = "Again."
  }
}
if reply != "" {
  say reply, instant
}
wait 2 s
say "Done", instant
// A sound between such a text and its wait.
let cue = ""
switch randomInteger(0..2) {
  case 0 {
    cue = "Listen."
  }
}
if cue != "" {
  say cue, instant
}
playAudio async "beat.wav"
wait 2 s
say "Heard", instant
exit
