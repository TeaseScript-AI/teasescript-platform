// NOTE SX_HTML_LAYOUT: Legacy show() rendered HTML; the text keeps bold, italic, colour, size, and line breaks as message markup, and drops layout such as TEXTFORMAT, FONT FACE, ALIGN, and the size an editor gave all text (2 texts in this file).
// DisciplineClinic Punish spank(): a local text that never changes, inside an HTML span, joins the span's own text,
// so the span settles around its line breaks and its paragraphs are messages of their own.
let counting = false
function spank(message, spot) {
  say "[size=x-large]**${message}**[/size]"
  say "[size=x-large]**.......**[/size]"
  // A variable that every show wraps in its size and <b> again keeps neither of its own.
  if spot != "cheek" {
    message = "Center cheek, Alternate sides"
  }
  if counting {
    say "[size=x-large]**${message}**[/size]"
  } else {
    say """
      [size=x-large]**${message}**[/size]
      [size=x-large]**.1.**[/size]
    """
  }
}
spank("Right cheek", "cheek")
// Domme SMinder: the Flash editor writes a FACE and its size 6 around every paragraph, which add nothing; its larger
// size stays.
say """
  [color=#ff0000][size=x-large]**Not interested!**[/size][/color]
  [color=#ffffff]You have been blocked.[/color]
"""
say "[color=#ffffff]Swipe again.[/color]"
exit
