// NOTE SX_HTML_LAYOUT: Legacy show() rendered HTML; the text keeps bold, italic, colour, and line breaks as message markup, and drops layout tags such as TEXTFORMAT, FONT FACE and SIZE, and ALIGN (4 texts in this file).
// DisciplineClinic Punish spank(): a local text that never changes, inside an HTML span, joins the span's own text,
// so the span settles around its line breaks and its paragraphs are messages of their own.
let counting = false
function spank(message, spot) {
  say "**${message}**"
  say "**.......**"
  // A variable that every show wraps in <b> again keeps no <b> of its own.
  if spot != "cheek" {
    message = "Center cheek, Alternate sides"
  }
  if counting {
    say "**${message}**"
  } else {
    say """
      **${message}**
      **.1.**
    """
  }
}
spank("Right cheek", "cheek")
exit
