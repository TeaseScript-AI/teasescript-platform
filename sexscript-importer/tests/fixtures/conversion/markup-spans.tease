// NOTE SX_HTML_LAYOUT: Legacy show() rendered HTML; the text keeps bold, italic, colour, size, and line breaks as message markup, and drops layout such as TEXTFORMAT, ALIGN, and FONT FACE with the size an editor writes beside it (1 text in this file).
// DisciplineClinic Punish spank(): a local text that never changes, inside an HTML span, joins the span's own text,
// so the span settles around its line breaks and its paragraphs are messages of their own.
let counting = false
function spank(message, spot) {
  say "[size=x-large]**${message}**[/size]"
  say "[size=x-large]**.......**[/size]"
  // A variable that every show wraps in its size and <b> again keeps neither of its own.
  if spot != "cheek" {
    message = "Center cheek, Alternate sides"
  }
  if counting {
    say "[size=x-large]**${message}**[/size]"
  } else {
    say """
      [size=x-large]**${message}**[/size]
      [size=x-large]**.1.**[/size]
    """
  }
}
spank("Right cheek", "cheek")
// Milovana: the Flash editor wraps every paragraph in a FONT with its FACE and default size, which is no emphasis.
say "[color=#000000]You think I have all day to wait for you?[/color]"
exit
