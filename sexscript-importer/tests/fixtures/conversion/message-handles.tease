// An animation, texts that each add only punctuation with only waits between them, is one message whose text each
// step changes in place; the waits between the steps stay as they are, also short ones.
let line = say "Wait.", instant
wait 1
line.text += " ."
wait 1
line.text += " ."
wait 1
let line2 = say "Thinking .", instant
wait 0.5
line2.text = "Thinking  .."
wait 0.5
// A loop that shows the line said before it again with a new count changes that line in place.
let message = "Count them."
let x = 0
let counter = say """
  ${message}

  ${x}
""", instant
wait 3000 ms
for it in 1..=3 {
  x += 1
  counter.text = """
    ${message}

    ${x}
  """
  playAudio "swat.wav"
  wait 1000 ms
}
let counter2 = say "20 jerks", instant
let i = 19
while i > 17 {
  counter2.text = "${i} jerks"
  wait 1
  i -= 1
}
// A loop whose text is no new count of the line before it says each text as a message of its own.
say "Get ready!"
for s in 1..=2 {
  say "Shock ${s} of 2", instant
  wait 5
}
exit
