speaker system {
  title: "System"
}
function sexscriptLegacyAskBooleansSystem(message, texts, defaults) {
  let selected = []
  let index = 0
  for text in texts {
    selected.add(index < defaults.length and defaults[index] == true)
    index += 1
  }
  say as system message
  let done = false
  while not done {
    let buttons = []
    index = 0
    for text in texts {
      let mark = "☐"
      if selected[index] {
        mark = "☑"
      }
      buttons.add({ value: index, text: "${mark} ${text}" })
      index += 1
    }
    buttons.add({ value: texts.length, text: "Done" })
    let picked = choose buttons
    if picked == texts.length {
      done = true
    } else {
      selected[picked] = not selected[picked]
    }
  }
  return selected
}
function sexscriptLegacyAskProfile {
  let profileToysKeys: string[] = []
  let profileToysNames: string[] = []
  let profileToysDefaults: boolean[] = []
  let profileToysIndex = 0
  for profileToysKey in ["toys.crop", "toys.paddle"] {
    if load(profileToysKey) == null {
      profileToysKeys.add(profileToysKey)
      profileToysNames.add(["crop / cane", "paddle"][profileToysIndex])
      profileToysDefaults.add(false)
    }
    profileToysIndex += 1
  }
  if profileToysKeys.length > 0 {
    let profileToysAnswers = sexscriptLegacyAskBooleansSystem("What do you have in your toy chest ?", profileToysNames, profileToysDefaults)
    profileToysIndex = 0
    for profileToysKey in profileToysKeys {
      save profileToysAnswers[profileToysIndex] as profileToysKey
      profileToysIndex += 1
    }
  }
}
// NOTE SX_LEGACY_PROFILE: The legacy desktop player's intro and options asked the player's profile (toys.crop, toys.paddle) once; this package asks what is missing here and saves it under the same keys, so other packages reuse the answers.
sexscriptLegacyAskProfile()
function sexscriptLegacyLoadFirstTrue(keys) {
  for key in keys {
    let value = load key
    if value == true {
      return key
    }
  }
  return null
}
function sexscriptLegacyArray(size, value) {
  let items = []
  repeat size {
    items.add(value)
  }
  return items
}
// A list that the code compares with null keeps its null start, since null and an empty list differ there.
let answers: string[]? = null
function fill {
  answers = ["Yes", "No"]
}
if answers == null {
  say "Nothing loaded yet"
}
fill()
if answers != null {
  say answers[0]
}
// loadFirstTrue gives null when no key holds true, so the variable it sets may hold null.
let implement: string? = "hand"
implement = sexscriptLegacyLoadFirstTrue(["toys.paddle", "toys.crop"])
say "You get the ${implement}"
// One list of keys, passed as a Java array, is the list of keys itself.
let paddles = ["toys.paddle", "toys.hairbrush"]
// NOTE SX_JAVA_ARRAY_CONVERSION line 13: A Java String[] converted every written value to its element type (truncating or rounding numbers, turning values into text); this list keeps values as written.
let noKeys = sexscriptLegacyArray(0, null)
let spanker: string? = sexscriptLegacyLoadFirstTrue(paddles)
say "Spanker ${spanker}"
exit
