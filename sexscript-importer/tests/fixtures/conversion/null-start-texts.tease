function sexscriptLegacyCastText(value): string? {
  if value == null {
    return null
  }
  return toString(value)
}
// A text or a flag declared as null, or without a value, whose later values all have one type starts empty: no code
// compares it with null or passes it on, and Groovy truth treats null like the empty text and false.
let name = ""
function ask {
  name = askText("Your name?").replace("\n", " ")
}
let finished = false
if name == "" {
  ask()
}
if askBoolean "Finished?" {
  finished = true
}
if not finished {
  say prose "Keep going, ${name}", instant
}
// A text that a function can show before its first value showed null in Groovy; it shows nothing now.
// NOTE SX_NULL_START_EMPTY line 10: Groovy showed mood as null until its first value; it starts as the empty text here, so a text shown before then says nothing.
let mood = ""
function report {
  say prose "Mood: ${mood}", instant
}
report()
mood = "calm"
report()
// A text whose value the code passes on, or that a switch matches against null, keeps its null start.
let toy: string? = null
if askBoolean "A toy?" {
  toy = "paddle"
}
let chosen: string? = toy
let room: string? = null
if askBoolean "Inside?" {
  room = "hall"
}
if room == null {
  say prose "Nowhere", instant
} else {
  say prose "In the ${room}", instant
}
say prose "Using the ${chosen}", instant
// So does one that the code compares with a value that may be empty, or that a parameter takes as its default, and one
// that a String cast copies, which keeps null as Groovy's did.
let nick: string? = null
let copied: string? = sexscriptLegacyCastText(nick)
nick = "Kim"
if copied == nick {
  say prose "Same nick", instant
}
let answer: string? = null
if answer == "" {
  say prose "No answer", instant
}
answer = askText("Answer?").replace("\n", " ")
let hint: string? = null
function remind(text = hint) {
  say prose "Hint: ${text}", instant
}
hint = "Look up"
remind()
// One that the script sets before every read, in the block that reads it or one around it, never shows its start, so it
// starts empty also where the code passes it on or tests it for null.
let gag = ""
if askBoolean "A gag?" {
  gag = "ball"
  let worn = gag
  if gag != null {
    say prose "Wearing the ${worn}", instant
  }
}
exit
