speaker system {
  title: "System"
}
function sexscriptLegacyMaskUrl(url) {
  let parts = "${url}".split("?")
  if parts.length < 2 {
    return "${url}"
  }
  let masked = []
  for pair in parts[1].split("&") {
    let field = pair.split("=")[0]
    let name = field.lowercase()
    if name.contains("key") or name.contains("token") or name.contains("pass") or name.contains("secret") or name.contains("auth") {
      masked.add("${field}=…")
    } else {
      masked.add(pair)
    }
  }
  return "${parts[0]}?${masked.join("&")}"
}
// An online service cannot answer here: a system notice shows the request, with secret values hidden, and the
// read is empty, as when the service answered nothing.
let userId = load "training.id"
let request = "https://example.org/cases.php?id=${userId}&apikey=SECRET&version=3"
// NOTE SX_ONLINE_REQUEST line 5: The legacy script read this web address from an online service, which a package cannot reach; a system notice shows the request, with secret values hidden, and the read is empty, as when the service answered nothing.
say as system "Online feature not available here. The original would have requested: GET ${sexscriptLegacyMaskUrl(request)}"
let answer = ""
if answer == "" {
  say "We are having trouble connecting to the internet."
}
// NOTE SX_ONLINE_REQUEST line 7: The legacy script read this web address from an online service, which a package cannot reach; a system notice shows the request, with secret values hidden, and the read is empty, as when the service answered nothing.
say as system "Online feature not available here. The original would have requested: GET http://example.org/api?token=…&page=1"
let page = ""
say "Page ${page}"
// A function that talks to an online service, such as a language model, shows its request and fails as offline.
// NOTE SX_ONLINE_REQUEST line 10: This function made a request to an online service, which a package cannot do; a system notice shows the request, with secret values hidden, and the function returns as when the request failed.
function ask(prompt) {
  say as system "Online feature not available here. The original would have requested: POST http://localhost:1234/v1/chat/completions"
  return null
}
say "Reply: ${ask("Hello")}"
// A request whose address the function declared shows that address.
// NOTE SX_ONLINE_REQUEST line 19: This function made a request to an online service, which a package cannot do; a system notice shows the request, with secret values hidden, and the function returns as when the request failed.
function ping {
  say as system "Online feature not available here. The original would have requested: GET http://localhost:1234/ping"
  return null
}
say "Ping ${ping()}"
exit
