speaker system {
  title: "System"
}
// A program the package holds cannot start from here: a system notice says so, and a puzzle asks whether it was solved.
say "Solve the puzzle before the time runs out"
// NOTE SX_EXTERNAL_PROGRAM_NOTICE line 3: useFile() started the program files/Puzzle Challenge/1.exe on the player's computer, which a package cannot do; a system notice says so, and the player says whether the puzzle was solved.
say as system "The puzzle (1.exe) is not available here. Solve it in your mind, or skip it."
let puzzleSolved = choose solved: "Puzzle solved", unsolved: "Not solved"
say "Tell me when you have done the puzzle"
// NOTE SX_EXTERNAL_PROGRAM_NOTICE line 5: useFile() started the program files/tools/timer.exe on the player's computer, which a package cannot do; a system notice says so.
say as system "The program timer.exe that the original started is not available here."
exit
