function sexscriptLegacyValue(value) {
  return value
}
function sexscriptLegacyLoadInteger(key, whenMissing = null) {
  let value = load key
  if value == null {
    return whenMissing
  }
  return sexscriptLegacyValue(toInteger(value))
}
// The legacy display showed one text, so a blank line separated what becomes one message per paragraph, each with
// the Player's reading time.
let name = "Ann"
say "Do you deserve a break?"
say "Well, ${name}, let's check."
say "You are late."
say "Kneel."
// An ask's question keeps its last paragraph; the others are said before the ask.
say "These are the rules."
say "Count every stroke."
let strokes = askInteger "How many strokes?", default: 5
// Blank lines that lay out columns, a ruled line, or a block of values stay in one message.
say """
  Your status:

  Strokes:   ${strokes}
  Rounds:    3
"""
say """
  LEVEL 1

  ----------

  Fight!
"""
say """
  ROUND OVER

  Score: ${strokes}.

  Rounds left = 2
"""
// A list of links is no block of values, and a single paragraph loses the blank lines around it.
say "Links:"
say """
  http://example.com/a
  http://example.com/b
"""
say "Hello."
// What the statement runs before its ask stays before the ask's question.
function warmUp {
  say "Stretch first."
  return 1
}
say "Next round."
say "How many more?"
let more = warmUp() + askInteger()
// The photo an ask asks for keeps its last paragraph as its message.
// NOTE SX_FILE_PHOTO line 22: getFile() let the player pick any file with this title; scripts use it for a photo of the player, so askImage() asks for an image with this message, which the player answers with an image file or the camera; a chooser the player cancelled gave null, which askImage() does not.
say "Smile."
let photo = askImage("Take a photo of yourself.")
// A blank line in a value built at runtime stays.
let note = """
  first

  second
"""
say note
// A form's question keeps its first paragraph, the intro, and says the others after the form's fields as its outro.
let pics = load("game.pics", default: false) == true
let rounds = sexscriptLegacyLoadInteger("game.rounds")
if rounds == null or rounds == 0 {
  rounds = 3
}
// NOTE SX_SETTINGS_FORM line 30: The legacy script asked these 2 settings one after the other and saved each; one form asks them together, with each question as the field's description.
let settings = askForm "Settings", fields: {
  pics: { type: "boolean", value: pics, text: "Pics", options: [
    { value: true, text: "Yes" },
    { value: false, text: "No" }
  ], description: "Take pictures?" },
  rounds: { type: "integer", value: rounds, text: "Rounds", description: "How many rounds?" }
}, outro: """
  You can change how the game plays.

  Each setting is saved at once.
"""
pics = settings.pics
save pics as "game.pics"
rounds = settings.rounds
save rounds as "game.rounds"
say "Pictures ${pics}, rounds ${rounds}"
// A form whose later paragraphs are computed with an effect keeps its question whole: the outro would be computed after
// the fields.
function mood {
  pics = false
  return "Be honest."
}
// NOTE SX_SETTINGS_FORM line 39: The legacy script asked these 2 settings one after the other and saved each; one form asks them together, with each question as the field's description.
let settings2 = askForm """
  More settings

  ${mood()}
""", fields: {
  pics: { type: "boolean", value: pics, text: "Pics", options: [
    { value: true, text: "Yes" },
    { value: false, text: "No" }
  ], description: "Take pictures now?" },
  rounds: { type: "integer", value: rounds, text: "Rounds", description: "Rounds now?" }
}
pics = settings2.pics
save pics as "game.pics"
rounds = settings2.rounds
save rounds as "game.rounds"
exit
