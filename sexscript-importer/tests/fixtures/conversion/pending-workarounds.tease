speaker system {
  title: "System"
}
function sexscriptLegacyAskBooleans(message, texts, defaults) {
  let selected = []
  let index = 0
  for text in texts {
    selected.add(index < defaults.length and defaults[index] == true)
    index += 1
  }
  say message
  while true {
    let buttons = []
    index = 0
    for text in texts {
      let mark = "☐"
      if selected[index] {
        mark = "☑"
      }
      buttons.add({ value: index, text: "${mark} ${text}" })
      index += 1
    }
    buttons.add({ value: texts.length, text: "Done" })
    let picked = choose buttons
    if picked == texts.length {
      return selected
    }
    selected[picked] = not selected[picked]
  }
}
// Accepted TeaseScript that main does not implement yet becomes a workaround in implemented TeaseScript.
// getBooleans: a menu of the items with their state marked, which a click switches until "Done".
// NOTE SX_ASK_BOOLEANS_WORKAROUND line 3: Workaround for askBooleans(), which main does not implement yet: a menu of the items with their state marked, which a click switches until "Done". Switch back to askBooleans(message:, texts:, defaults:) when it is implemented.
let toys = sexscriptLegacyAskBooleans("Which toys do you have?", ["Paddle", "Crop"], [true, false])
if toys[0] == true {
  say "Fetch the paddle"
}
// showPopup: the message in the chat and an OK button, also where the legacy script timed the popup.
// NOTE SX_POPUP_WORKAROUND line 6: Workaround for showPopup, which main does not implement yet: the message in the chat and an OK button. Switch back to showPopup when it is implemented.
say "Time for a break"
showButton "OK"
// NOTE SX_POPUP_ELAPSED line 7: showPopup() returned the seconds until the player closed the popup; TeaseScript popups return nothing, so the time is measured with getTimestamp().toSeconds(), in whole seconds.
// NOTE SX_POPUP_WORKAROUND line 7: Workaround for showPopup, which main does not implement yet: the message in the chat and an OK button. Switch back to showPopup when it is implemented.
let popupStart = getTimestamp().toSeconds()
say "Kneel until you close this"
showButton "OK"
let seconds = getTimestamp().toSeconds() - popupStart
say "You knelt ${seconds} seconds"
// useUrl: the link in the chat and a button to continue.
// NOTE SX_OPEN_URL_WORKAROUND line 10: Workaround for openUrl(), which main does not implement yet: the link in the chat, which the player can open, and a button to continue. Switch back to openUrl() when it is implemented.
say as system "Open this link: https://example.com/rules"
showButton "Continue"
// getFile asked for a photo of the player, which takePhoto() takes; it gives null as a cancelled chooser did.
// NOTE SX_FILE_PHOTO line 12: getFile() let the player pick any file with this title; scripts use it for a photo of the player, so askImage() asks for an image with this message, which the player answers with an image file or the camera; a chooser the player cancelled gave null, which askImage() does not.
let photo = askImage("Pick a photo of yourself")
if photo == null {
  say "No photo, then"
}
exit
