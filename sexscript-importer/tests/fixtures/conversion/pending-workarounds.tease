// Accepted TeaseScript that main does not implement yet becomes a workaround in implemented TeaseScript, and forms
// that main implements now are native.
// getBooleans: a form of toggles; its Cancel, which gave null, where the next statement tests the answers for null.
let toys = askBooleans prose "Which toys do you have?", texts: ["Paddle", "Crop"], prefill: [true, false]
let clothes = [false]
let owned = [{ label: "Collar" }]
let collectResult = []
for it in owned {
  collectResult.add(it.label)
}
let answers: boolean[]? = askBooleans prose "What do you own?", texts: collectResult, prefill: clothes, cancel: "Cancel"
if answers != null {
  clothes = answers
  save clothes[0] as "clothes.collar"
} else {
  say prose "Nothing changed", instant
}
let gags: boolean[]? = askBooleans prose "Which gags do you have?", texts: ["Ball gag"], prefill: [false], cancel: "Cancel"
if gags == null or gags[0] == false {
  say prose "No gag today", instant
}
if toys[0] == true {
  say prose "Fetch the paddle", instant
}
// showPopup is native; the legacy result was the whole seconds until the player closed the popup.
showPopup "Time for a break"
let seconds = toInteger(showPopup("Kneel until you close this") / 1 s)
say prose "You knelt ${seconds} seconds", instant
// useUrl is openUrl(); an address without its scheme gets https://, and empty text opened nothing.
openUrl("https://example.com/rules")
// NOTE SX_OPEN_URL_SCHEME line 19: useUrl() named this address without its scheme, which the computer's browser completed; openUrl() opens it with https://.
openUrl("https://cornertime.github.io")
// NOTE SX_OPEN_URL_EMPTY line 20: useUrl() of empty text opened no page, so nothing opens here.
// getFile asked for a photo of the player, which takePhoto() takes; it gives null as a cancelled chooser did.
// NOTE SX_FILE_PHOTO line 22: getFile() let the player pick any file with this title; scripts use it for a photo of the player, so askImage() asks for an image with this message, which the player answers with an image file or the camera, or skips, which gives null, as a chooser the player cancelled did.
let photo = askImage prose ("Pick a photo of yourself", allowSkip: true)
// Without a title, there is nothing to say before the request.
// NOTE SX_FILE_PHOTO line 24: getFile() let the player pick any file with this title; scripts use it for a photo of the player, so askImage() asks for an image with this message, which the player answers with an image file or the camera; a chooser the player cancelled gave null, which askImage() does not.
let another = askImage()
if photo == null {
  say prose "No photo, then", instant
}
exit
