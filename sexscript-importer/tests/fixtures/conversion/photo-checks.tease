// A photo the script tests for null keeps the script's own handling of a photo that did not come.
// NOTE SX_DATA_FOLDER line 2: getDataFolder() was the legacy player's data folder on the player's computer; package paths start at the package root, so it is empty text here.
let dir = ""
// A copy below the data folder keeps the photo's reference under that path, and its size is a valid photo's.
function keepOutfit(photo) {
  // NOTE SX_PHOTO_COPY line 5: Legacy code copied this photo to images/outfit/last.jpg, which a package cannot write; the photo's reference is saved for that path, and showing the path shows the photo.
  save photo as "sexscript.image.${dir}images/outfit/last.jpg"
  // NOTE SX_PHOTO_SIZE line 6: Legacy code read the byte size of a file, which photo code compared with a threshold to detect a broken webcam picture; a package cannot read file sizes, and a photo the player took counts as valid, so the size reads as 1000000 bytes.
  if 1000000 < 15000 {
    say prose "Your camera gave a broken picture.", instant
  }
}
// NOTE SX_CAMERA_FALLBACK line 8: getImage() fell back to a file chooser titled with its message when no webcam worked; takePhoto() only uses the camera and returns null instead, and the Player decides how the photo is taken.
let proof: string? = takePhoto()
if proof == null {
  say prose "No photo, no outfit check.", instant
} else {
  showImage proof
  keepOutfit(proof)
}
// A photo the script uses without a test ends the session where none came, as the legacy script failed there.
// NOTE SX_CAMERA_FALLBACK line 15: getImage() fell back to a file chooser titled with its message when no webcam worked; takePhoto() only uses the camera and returns null instead, and the Player decides how the photo is taken.
let face: string? = takePhoto()
// NOTE SX_PHOTO_MISSING_END line 16: getImage() gave null when neither the webcam nor the file chooser gave a picture, and the script then failed where it used it; the session ends here when no photo comes.
if face == null {
  exit
}
say prose "Your photo: ${face.lowercase()}", instant
// A photo taken in a loop ends the session where a use of it after the loop finds none: a later pass may take one.
let shot: string? = ""
for it in 0..2 {
  // NOTE SX_CAMERA_FALLBACK line 19: getImage() fell back to a file chooser titled with its message when no webcam worked; takePhoto() only uses the camera and returns null instead, and the Player decides how the photo is taken.
  shot = takePhoto()
}
// NOTE SX_PHOTO_MISSING_END line 20: getImage() gave null when neither the webcam nor the file chooser gave a picture, and the script then failed where it used it; the session ends here when no photo comes.
if shot == null {
  exit
}
say prose "Last photo: ${shot.lowercase()}", instant
// What the script does between a photo and its use still happens, also setting the variable to a text, which needs no
// test.
let image: string? = takePhoto()
say prose "Continue", instant
image = "fallback"
say prose image.lowercase(), instant
exit
