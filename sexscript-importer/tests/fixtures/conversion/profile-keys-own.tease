// A script with its own user.* setup, as SexScriptsEnhancedMenu's, keeps its keys.
say prose "Are you a woman?", instant
save askBoolean as "user.female"
if load("user.female", default: false) {
  say prose "Hello, lady.", instant
}
say prose "You need a punishment, ${load("user.boygirl", default: "")}.", instant
exit
