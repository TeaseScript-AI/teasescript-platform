function sexscriptLegacyRandom(limit) {
  let bound = toInteger(limit otherwise 100)
  if bound > 0 {
    return randomInteger(0..bound)
  }
  if bound < 0 {
    return -randomInteger(0..-bound)
  }
  return 0
}
let lines: string[] = []
let line = ""
lines = ["Good.", "Very good.", "Keep going."]
line = lines.random
say prose line, instant
say prose "Count: ${lines.length}", instant
// getRandom(0) returned 0; randomInteger() rejects the empty range.
let packs = 1
let pack = sexscriptLegacyRandom(packs - 1)
wait (randomInteger(0..5) + 2) s
// DisciplineClinic's picture counts: every write gives a positive whole number, so randomInteger() draws as
// getRandom() did.
let introPics = 1
if packs > 0 {
  introPics = 3
}
say prose "Picture ${randomInteger(0..introPics) + 1}", instant
// A count that starts at 0, as in DCAfterDark/Chanta.groovy, keeps the helper.
let otherPics = 0
if packs > 0 {
  otherPics = 4
}
say prose "Other ${sexscriptLegacyRandom(otherPics)}", instant
exit
