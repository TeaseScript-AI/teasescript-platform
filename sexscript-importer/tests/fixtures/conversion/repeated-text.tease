// The legacy display showed one text at a time, so a script repeated a message to extend it; the Player keeps earlier
// messages, so a text says only what it adds to the one just before it, with whitespace, line breaks, and the earlier
// text's final punctuation ignored.
say prose "I will decide when you get to cum from now on.", instant
wait 5 s
say prose "Do you accept?", instant
if askBoolean {
  say prose "Good.", instant
}
// Growing dots, which only add punctuation between waits, are an animation: one message whose text each step changes.
let line = say prose "Deciding.", instant
wait 1 s
line.text += "."
wait 1 s
line.text += "."
wait 1 s
// A question that repeats the text before it asks without saying it again.
say prose "How many days?", instant
let days = askInteger prefill: 3
// Interpolations compare when they interpolate the same value; an image in between keeps the text.
say prose "Your name?", instant
let name = askText(prefill: "pet").replace("\n", " ")
say prose "Hello ${name}.", instant
showImage "kneel.jpg"
say prose "Kneel.", instant
say prose "Hello ${days}. Kneel.", instant
// A text that only shares the beginning of a word, or follows another statement, stays whole.
say prose "Wait", instant
say prose "Waiting for you", instant
let count = days + 1
say prose "Waiting for you, ${count} days", instant
// A photo request whose title repeats the text before it says the title once, as its question.
say prose "Show me how you kneel.", instant
// NOTE SX_FILE_PHOTO line 31: getFile() let the player pick any file with this title; scripts use it for a photo of the player, so askImage() asks for an image with this message, which the player answers with an image file or the camera; a chooser the player cancelled gave null, which askImage() does not.
showImage askImage("Show me how you kneel.")
// An empty text only cleared the legacy display, so it is not said, also through a variable that stays empty.
let pickedColor = choose 0: "Red", 1: "Blue"
say prose "Color ${pickedColor}", instant
// An exact repeat between waits goes, and the waits around it join.
say prose "Processing.", instant
wait 5 s
wait 5 s
// A variable that starts empty and gets its text in switch cases is said where it is not empty: no case may apply,
// where legacy only cleared the display (Domme2's menu greetings).
let greeting = ""
switch randomInteger(0..2) {
  case 0 {
    greeting = "Did you behave yourself?"
  }
  case 1 {
    greeting = "Back already?"
  }
}
if greeting != "" {
  say prose greeting, instant
}
let picked = choose 0: "Ask", 1: "Chores"
say prose "Picked ${picked}", instant
exit
