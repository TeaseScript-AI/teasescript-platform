speaker system {
  title: "System"
}
function sexscriptLegacyMaskUrl(url) {
  let parts = "${url}".split("?")
  if parts.length < 2 {
    return "${url}"
  }
  let masked = []
  for pair in parts[1].split("&") {
    let field = pair.split("=")[0]
    let name = field.lowercase()
    if name.contains("key") or name.contains("token") or name.contains("pass") or name.contains("secret") or name.contains("auth") {
      masked.add("${field}=…")
    } else {
      masked.add(pair)
    }
  }
  return "${parts[0]}?${masked.join("&")}"
}
// A download into the package cannot happen here: a system notice shows the request, with secret values hidden, and
// the function answers as when the download failed.
// NOTE SX_ONLINE_REQUEST line 3: This function downloaded a web address into a file, which a package cannot do; a system notice shows the request, with secret values hidden, and the function returns as when the request failed.
function downloadFile(link, file) {
  say as system "Online feature not available here. The original would have requested: GET ${sexscriptLegacyMaskUrl(link)}"
  return false
}
if not downloadFile("http://example.org/update.txt?token=abc", "tasks.txt") {
  say "The tasks stay as they were"
}
// Managing the installed scripts is not possible from a package; a system notice says so, and the session ends.
// NOTE SX_DATA_FOLDER line 12: getDataFolder() was the legacy player's data folder on the player's computer; package paths start at the package root, so it is empty text here.
let dir = "scripts/"
// NOTE SX_SCRIPT_MANAGER line 13: eachFile() went through the installed scripts of the legacy player to manage them, which a package cannot do; a system notice says so, and the session ends.
say as system "Managing the installed scripts is not available here: scripts cannot be listed, changed, or removed from a package."
exit
