// Calls the function an action ID names. Unlike Groovy, extra arguments are ignored and an unknown action returns null.
function sexscriptLegacyCall(action, args) {
  if action == "scriptCallback3" {
    scriptCallback3()
    return
  }
}
// BanjoRPG's world: variables that start as null and that one later statement sets to a closure, before which the
// script calls nothing, call their closure's function directly, which takes the variable's name.
function enterWorld(room) {
  if room == "end" {
    worldEnd("quitmenu")
  } else {
    worldTown(room)
  }
}
function worldTown(loadroom) {
  say "Town: ${loadroom}"
  return worldEnd("defeated")
}
function worldEnd(reason) {
  say "The end: ${reason}"
}
enterWorld("gates")
// A variable that the script may call before it is set keeps the dispatcher, which finds it null there.
let worldCave = null
enterWorld("end")
function scriptCallback3 {
  say "Cave"
}
worldCave = "scriptCallback3"
sexscriptLegacyCall(worldCave, [])
exit
