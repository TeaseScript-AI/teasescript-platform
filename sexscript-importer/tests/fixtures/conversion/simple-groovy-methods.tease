function sexscriptLegacyRandom(limit) {
  if limit == null {
    return randomInteger(0..100)
  }
  let bound = limit - limit % 1
  if bound > 0 {
    return randomInteger(0..bound)
  }
  if bound < 0 {
    return -randomInteger(0..-bound)
  }
  return 0
}
function sexscriptLegacyItems(value) {
  if value is string {
    return value.split("")
  }
  return value
}
function sexscriptLegacyItemAt(listValue, positionValue) {
  if positionValue >= listValue.length {
    return null
  }
  return listValue[positionValue]
}
