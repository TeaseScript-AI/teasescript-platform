let sexscriptBackgroundSounds = []
function sexscriptLegacyPlayBackgroundSound(file, passes) {
  if file == null {
    sexscriptLegacyStopBackgroundSounds()
    return
  }
  if passes < 1 {
    return
  }
  let sound = playAudio(file: file, async: true, repeat: passes times)
  sexscriptBackgroundSounds.add(sound)
}
function sexscriptLegacyStopBackgroundSounds {
  for sound in sexscriptBackgroundSounds {
    sound.stop()
  }
  sexscriptBackgroundSounds = []
}
// Background sounds overlap; playBackgroundSound(null) stops all of them.
sexscriptLegacyPlayBackgroundSound("rain.wav", 1)
sexscriptLegacyPlayBackgroundSound("bell.wav", 2)
let answer = 0
while answer < 5 {
  answer = answer + 2
}
// The sound starts again before every round of the endless loop.
while true {
  sexscriptLegacyPlayBackgroundSound("tick.wav", 1)
  say "Tick"
  if answer > 3 {
    break
  }
}
sexscriptLegacyStopBackgroundSounds()
// show() returns nothing, so Groovy discarded the appended text.
// NOTE SX_DISCARDED_CONCATENATION line 13: Groovy appended text to the result of show(), which returns nothing, and discarded it; the appended text was never shown and is dropped here.
say "Quiet now."
function finish {
  say "Bye"
  // NOTE SX_SYSTEM_EXIT line 16: System.exit() closed the legacy application; TeaseScript exit ends the session but leaves the Player open.
  exit
}
finish()
