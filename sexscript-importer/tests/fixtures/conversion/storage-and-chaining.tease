---
title: "Training"
author: "Anna"
description: "A short session"
keywords: "training"
---
// Legacy setInfos(): API version 9, status "working", color 0x000000, language "EN"

let visits = load "training.visits", default: 0
save visits + 1 as "training.visits"
let title = load "training.title"
if title == null or title == "" {
  title = "pet"
}
if (load "training.finished") == true {
  say "Welcome back, ${title}"
  goto "finished.tease"
}
delete "training.old"
say "Visit ${visits + 1}"
exit
