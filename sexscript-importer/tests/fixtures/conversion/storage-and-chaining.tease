---
title: "Training"
author: "Anna"
description: "A short session"
keywords: "training"
---
// Legacy setInfos(): API version 9, status "working", color 0x000000, language "EN"

function sexscriptLegacyCompare(left, right) {
  if left == null {
    if right == null {
      return 0
    }
    return -1
  }
  if right == null {
    return 1
  }
  if left < right {
    return -1
  }
  if left > right {
    return 1
  }
  return 0
}
let visits = load "training.visits", default: 0
save visits + 1 as "training.visits"
let elvisValue = load "training.title"
let title = "pet"
if elvisValue != null and elvisValue != "" {
  title = elvisValue
}
if (load "training.finished") == true {
  say "Welcome back, ${title}"
  goto "finished.tease"
}
delete "training.old"
say "Visit ${visits + 1}"
// A read into a variable whose type cannot hold null keeps its value where the key is missing.
let greeting = "Mistress"
// NOTE SX_LOAD_KEEPS_VALUE line 14: Groovy stored null in 'greeting' when this key was missing, which the variable's type cannot hold; the variable keeps its value then.
greeting = load "training.greeting", default: greeting
say "Hello ${greeting}"
// Groovy ordered a missing storage value, null, below every value.
if sexscriptLegacyCompare(load "training.level", 3) < 0 {
  say "Still a beginner"
}
// A read from the legacy online service, too.
// NOTE SX_ONLINE_STORAGE line 19: The legacy online service kept this value on a server, shared by the script's players and sessions; it is kept in the package's storage here (owner decision 2026-10-05), so only this player's sessions share it.
let record = load "training.record"
if sexscriptLegacyCompare(record, 10) >= 0 {
  say "A new record"
}
// A variable of a block keeps its own null tests: the first streak is never compared with null.
say "Keep the streak?"
if (choose yes: "Yes", no: "No") == "yes" {
  let streak = 0
  // NOTE SX_LOAD_KEEPS_VALUE line 24: Groovy stored null in 'streak' when this key was missing, which the variable's type cannot hold; the variable keeps its value then.
  streak = load "training.streak", default: streak
  say "Streak ${streak + 1}"
} else {
  let streak: integer? = 0
  streak = load "training.streak"
  if streak == null {
    say "No streak"
  }
}
exit
