function sexscriptLegacyBooleanText(value) {
  return "${value}".lowercase() == "true"
}
function sexscriptLegacyValue(value) {
  return value
}
function sexscriptLegacyText(value): string? {
  if value == null or value == "" {
    return null
  }
  return "${value}"
}
// A read whose null the script never tests gets the empty value of the type legacy read as its default, text for
// loadString and false for loadBoolean; a plain load gets the one the saves under its key give.
let name = load "game.name", default: ""
say "Hello ${name}"
let sound = load "game.sound", default: false
if sound == true {
  say "The sound is on."
}
let rounds = load "game.rounds", default: 0
say "Rounds won: ${rounds}"
function reset {
  save 0 as "game.rounds"
}
// A missing text reads as the empty text, which its null tests test for; another value keeps its null.
let level = load "game.level", default: ""
if level == "" {
  level = "easy"
  save level as "game.level"
}
say "Level ${level}"
let savedSeen: boolean? = load "game.seen", default: null
if savedSeen == null {
  save true as "game.seen"
}
// A copy of the text, or a parameter it is passed to, may hold null from elsewhere too, so its tests take both; the
// text that loadString read of a key the package saves numbers under keeps its null.
let stored = load "game.stored", default: ""
let copy = stored
if copy == null or copy == "" {
  say "Nothing stored."
}
function check(value) {
  if value == null or value == "" {
    say "Nothing given."
  }
}
check(load("game.given", default: ""))
if load("game.mode", default: "") == "" {
  say "No mode."
}
// A null saved under the key removes it, so the key reads as the empty text again.
function resetMode {
  delete "game.mode"
}
// NOTE SX_LOAD_STRING_TEXT line 28: loadString() read the stored value as text, and the package saves a number or a boolean under this key, so the value is turned into text.
let version: string = "${load("game.version", default: sexscriptLegacyValue(""))}"
if version == "" {
  say "No version."
}
function upgrade {
  save 2 as "game.version"
}
// A list of lists the saves give a key reads as an empty list.
let grid = load "game.grid", default: []
// NOTE SX_LENGTH_RECEIVER line 33: Groovy size() also worked on a map; text, lists, and dicts have a length, but if this value is an object with fixed properties, length stops the script.
say "Rows: ${grid.length}"
function reset2 {
  save [[0]] as "game.grid"
}
// A number a built-in computes with was there, or legacy failed, so it reads as 0 where missing, as Domme3's start time.
let started = load "game.started", default: 0
let startedDay = toInteger(started) / 86400
let since = getTimestamp().toSeconds() - started
say "Day ${startedDay}, ${since} s ago"
function restart {
  save getTimestamp().toSeconds() as "game.started"
}
// A text or a flag read of a key that values of another type are saved under too reads the value as stored and turns
// it into text, or into true only for "true".
// NOTE SX_LOAD_STRING_TEXT line 43: loadString() read the stored value as text, and the package saves values of another type under this key too, so the value is read as stored and turned into text; a missing value is the empty text.
let pick = "${load("game.pick", default: sexscriptLegacyValue(""))}"
say "Pick ${pick}"
function roll {
  save randomInteger(0..6) as "game.pick"
}
// NOTE SX_LOAD_BOOLEAN_TEXT line 46: loadBoolean() read the stored value as text, true only for "true", and the package saves values of another type under this key too, so the value is read the same way; a missing value reads as false.
let savedVolume: integer? = load "game.volume", default: null
if sexscriptLegacyBooleanText(savedVolume) == true {
  say "Loud."
}
function setVolume {
  save randomInteger(0..10) as "game.volume"
}
// A null the script sets a text variable to is the empty text too; a value of a type that the importer cannot tell
// keeps the read of an open type.
let dompic: string = load "game.dompic", default: ""
say "Reset the picture?"
if (choose yes: "Yes", no: "No") == "yes" {
  dompic = ""
}
if dompic == "" {
  say "No picture."
}
function pickOutfit {
  return { set: "first" }
}
// NOTE SX_LOAD_OPEN_NULL line 54: Legacy read null for a missing text, the empty text here; the script gives this variable values of a type the compiler cannot tell too, so the read keeps an open type, checked where it is used.
let outfit = sexscriptLegacyValue(load("game.outfit", default: ""))
if outfit == null or outfit == "" {
  outfit = pickOutfit()
}
// A legacy text read of a computed key is text too.
let names = ["a", "b"]
let n = 0
while n < 2 {
  names[n] = load "game.name${n}", default: ""
  n += 1
}
say names.join(", ")
// A flag read of a key that a text variable is saved under too reads as the flag's text.
let answer = load "game.answer", default: ""
// NOTE SX_LOAD_BOOLEAN_TEXT line 62: loadBoolean() read the stored value as text, true only for "true", and the package saves values of another type under this key too, so the value is read the same way; a missing value reads as false.
if sexscriptLegacyBooleanText(load("game.flag", default: "")) == true {
  say "Flagged."
}
function keepAnswer {
  save answer as "game.flag"
}
exit
