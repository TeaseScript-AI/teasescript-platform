function sexscriptLegacyBooleanText(value) {
  return "${value}".lowercase() == "true"
}
// NOTE SX_LOAD_KEY_DECLARED: Declares the types of storage keys whose reads keep null where none of them could declare it; nothing calls this function, so its reads never run.
global function sexscriptLegacyKeyTypes {
  let savedAnyText: string? = load "game.anyText", default: null
}
function sexscriptLegacyValue(value) {
  return value
}
function sexscriptLegacyLoadInteger(key, whenMissing = null) {
  let value = load key, default: null
  if value == null {
    return whenMissing
  }
  return sexscriptLegacyValue(toInteger(value))
}
function sexscriptLegacyItemAt(listValue, position) {
  if position < 0 {
    return listValue[listValue.length + position]
  }
  if position >= listValue.length {
    return null
  }
  return listValue[position]
}
function sexscriptLegacyText(value): string? {
  if value == null {
    return null
  }
  return "${value}"
}
// A read whose null the script never tests gets the empty value of the type legacy read as its default, text for
// loadString and false for loadBoolean; a plain load gets the one the saves under its key give.
let name = load "game.name", default: ""
say "Hello ${name}"
let sound = load "game.sound", default: false
if sound == true {
  say "The sound is on."
}
let rounds = load "game.rounds", default: 0
say "Rounds won: ${rounds}"
function reset {
  save 0 as "game.rounds"
}
// A missing text reads as the empty text, which its null tests test for; another value keeps its null.
let level = load "game.level", default: ""
if level == "" {
  level = "easy"
  save level as "game.level"
}
say "Level ${level}"
let savedSeen: boolean? = load "game.seen", default: null
if savedSeen == null {
  save true as "game.seen"
}
// A text that the script copies, or passes to a script function, keeps legacy null, and so do the tests of the copy
// and of the parameter; the text that loadString read of a key the package saves numbers under keeps its null.
let stored: string? = load "game.stored", default: null
let copy = stored
if copy == null {
  say "Nothing stored."
}
function check(value) {
  if value == null {
    say "Nothing given."
  }
}
let savedGiven: string? = load "game.given", default: null
check(savedGiven)
check(3)
if load("game.mode", default: "") == "" {
  say "No mode."
}
// A null saved under the key removes it, so the key reads as the empty text again.
function resetMode {
  delete "game.mode"
}
// NOTE SX_LOAD_STRING_TEXT line 29: loadString() read the stored value as text, and the package saves a number or a boolean under this key, so the value is turned into text.
let version: string = "${load("game.version", default: sexscriptLegacyValue(""))}"
if version == "" {
  say "No version."
}
function upgrade {
  save 2 as "game.version"
}
// A list of lists the saves give a key reads as an empty list.
let grid = load "game.grid", default: []
// NOTE SX_LENGTH_RECEIVER line 34: Groovy size() also worked on a map; text, lists, and dicts have a length, but if this value is an object with fixed properties, length stops the script.
say "Rows: ${grid.length}"
function reset2 {
  save [[0]] as "game.grid"
}
// A number a built-in computes with was there, or legacy failed, so it reads as 0 where missing, as Domme3's start time.
let started = load "game.started", default: 0
let startedDay = toInteger(started) / 86400
let since = getAbsoluteDateTime().toSeconds() - started
say "Day ${startedDay}, ${since} s ago"
function restart {
  save getAbsoluteDateTime().toSeconds() as "game.started"
}
// A text or a flag read of a key that values of another type are saved under too reads the value as stored and turns
// it into text, or into true only for "true".
// NOTE SX_LOAD_STRING_TEXT line 44: loadString() read the stored value as text, and the package saves values of another type under this key too, or reads it as one, so the value is read as stored and turned into text; a missing value is the empty text where the value stays in the read or its variable, and null where it goes on.
let pick = "${load("game.pick", default: sexscriptLegacyValue(""))}"
say "Pick ${pick}"
function roll {
  save randomInteger(0..6) as "game.pick"
}
// NOTE SX_LOAD_BOOLEAN_TEXT line 47: loadBoolean() read the stored value as text, true only for "true", and the package saves values of another type under this key too, or reads it as one, so the value is read the same way; a missing value reads as false.
let savedVolume: integer? = load "game.volume", default: null
if sexscriptLegacyBooleanText(savedVolume) == true {
  say "Loud."
}
function setVolume {
  save randomInteger(0..10) as "game.volume"
}
// A null the script sets a text variable to is the empty text too; a value of a type that the importer cannot tell
// keeps the read of an open type.
let dompic = load "game.dompic", default: ""
if askBoolean "Reset the picture?" {
  dompic = ""
}
if dompic == "" {
  say "No picture."
}
function pickOutfit {
  return { set: "first" }
}
let savedOutfit: string? = load "game.outfit", default: null
let outfit = sexscriptLegacyValue(savedOutfit)
if outfit == null {
  outfit = pickOutfit()
}
// A legacy text read of a computed key is text too.
let names = ["a", "b"]
for n in 0..2 {
  names[n] = load "game.name${n}", default: ""
}
say names.join(", ")
// A flag read of a key that a text variable is saved under too reads as the flag's text.
let answer = load "game.answer", default: ""
// NOTE SX_LOAD_BOOLEAN_TEXT line 63: loadBoolean() read the stored value as text, true only for "true", and the package saves values of another type under this key too, or reads it as one, so the value is read the same way; a missing value reads as false.
if sexscriptLegacyBooleanText(load("game.flag", default: "")) == true {
  say "Flagged."
}
function keepAnswer {
  save answer as "game.flag"
}
// A function's own variable is apart from another function's of the same name.
function readName {
  let ret = load "game.player", default: "Guest"
  return ret
}
function decide {
  let ret = null
  ret = askBoolean "Ready?"
  return ret
}
say "${readName()} ${decide()}"
// A read of a computed key has no type, also where it keeps its null.
let slot = 2
let saved = load "game.slot${slot}", default: null
if saved == null {
  say "Empty slot."
}
let counted: integer | string | null = 0
// NOTE SX_LOAD_KEEPS_VALUE line 74: Groovy stored null in 'counted' when this key was missing, which the variable's type cannot hold; the variable keeps its value then.
counted = load "game.count${slot}", default: counted
// A read of a computed key into a variable of a known type reads that type's empty value where the script uses it up,
// and makes the variable optional where it keeps its null; an item of a list of a known type reads the item type's
// empty value, also where the script tests it for null.
let stage: integer = sexscriptLegacyLoadInteger("game.stage${slot}", 0)
say "Stage ${stage + 1}"
let owned = load "toys.item${slot}", default: false
if owned == true {
  say "Owned."
}
let bonus = 0
// NOTE SX_LOAD_KEEPS_VALUE line 83: Groovy stored null in 'bonus' when this key was missing, which the variable's type cannot hold; the variable keeps its value then.
bonus = load "game.bonus${slot}", default: bonus
// NOTE SX_PLUS_OPERAND_TYPE line 84: Groovy + operands are not proven numeric; TeaseScript + adds two numbers or joins two texts or two lists, not mixed values. Use interpolation if this joins text.
say "Bonus ${bonus + 1}"
let best: integer? = 0
best = load "game.best${slot}", default: null
if best == null {
  say "No best."
}
let picks = ["a", "b"]
picks[0] = load "game.pick${slot}", default: ""
// NOTE SX_INDEX_PAST_END line 90: This position can be one past the end of the list, where Groovy read null; a helper reads null there too.
if sexscriptLegacyItemAt(picks, 0) == null {
  say "No pick."
}
let counts = [1, 2]
counts[1] = load "game.count${slot}", default: 0
// NOTE SX_PLUS_OPERAND_TYPE line 93: Groovy + operands are not proven numeric; TeaseScript + adds two numbers or joins two texts or two lists, not mixed values. Use interpolation if this joins text.
say "Count ${counts[1] + 1}"
// A text that a function returns keeps legacy null, and so do the tests of the call, of a parameter's default, and of a
// copy that the script sets to null.
function readNote {
  let savedNote: string? = load "game.note", default: null
  return savedNote
}
if readNote() == null {
  say "No note."
}
function noted(note, missing = note == null) {
  return missing
}
say "Missing ${noted(load("game.note", default: null))}"
let noteCopy = readNote()
noteCopy = null
if noteCopy == null {
  say "Cleared."
}
// So does a returned text whose function may give a value the importer cannot tell too.
// NOTE SX_LOAD_OPEN_NULL line 104: Legacy read null for a missing key; nothing tells this key's type where a load could declare it, so this read keeps that null of an open type, checked where it is used.
let oldHints = load "game.oldHints", default: sexscriptLegacyValue(null)
function readHint {
  if askBoolean "A hint?" {
    let savedHint: string? = load "game.hint", default: null
    return savedHint
  }
  return oldHints
}
if readHint() == null {
  say "No hint."
}
// A variable is apart from another of the same name in another block.
function work {
  if askBoolean "Read?" {
    let v = load "game.work", default: ""
    say "Work ${v}"
  }
  if askBoolean "Ask?" {
    let v = askText("Your name?", prefill: "x").replace("\n", " ")
    if v == null {
      say "No name."
    }
  }
}
work()
// A flag read of a key that the package saves text under, and reads as text too, reads the flag from the text.
save "true" as "game.choice"
let choiceText = load "game.choice", default: ""
// NOTE SX_LOAD_BOOLEAN_TEXT line 116: loadBoolean() read the stored value as text, true only for "true", and the package saves values of another type under this key too, or reads it as one, so the value is read the same way; a missing value reads as false.
if sexscriptLegacyBooleanText(load("game.choice", default: "")) == true {
  say "Chosen ${choiceText}"
}
// A text variable that also takes a script function's text, or a text method's, holds only text.
function defaultNick {
  return "Pet"
}
let nickname = load "game.nickname", default: ""
if nickname == "" {
  nickname = defaultNick()
}
nickname = nickname.trim()
say "Nick ${nickname}"
// A computed key's read that a list of a known type takes as a new item reads the items' empty value where missing.
let hints = ["first"]
hints.add(load("game.hint${slot}", default: ""))
say "Hints ${hints.length}"
// A parameter that a text is passed to tests for legacy null.
function describe(what) {
  if what == null {
    say "Nothing to wear."
  }
}
describe(outfit)
// A text that is a parameter's default is passed on, and keeps legacy null beside the variable's other values.
let mixedNote: string | integer | null = load "game.mixedNote", default: null
mixedNote = 2
function checkNote(item = mixedNote) {
  return item == ""
}
say "Note ${checkNote()} ${checkNote(null)}"
// A variable that such a text is copied into holds its null too, where no null test rules it out.
let firstPic: string? = load "game.firstPic", default: null
let shownPic: string? = "none"
if askBoolean "Show the first?" {
  shownPic = firstPic
}
say "Picture ${shownPic}"
// So does a parameter with a default of its own that a call passes such a text to, and a stored text of a key the
// package saves numbers under too, read through the text helper.
function described(value: string? = "none") {
  return value == null
}
let savedDescription: string? = load "game.description", default: null
say "No description ${described(savedDescription)}"
// NOTE SX_LOAD_STRING_TEXT line 144: loadString() read the stored value as text, and the package saves a number or a boolean under this key, so the value is turned into text.
let scoreText: string? = sexscriptLegacyText(load("game.scoreText", default: sexscriptLegacyValue(null)))
let scoreCopy: string? = scoreText
say "Score ${scoreCopy == null}"
function saveScore {
  save 10 as "game.scoreText"
}
// A parameter that a call passes such a text to only under a null test holds no null, unless the script set the text
// again, or called script code that may, before the call; a template the script wrote around a read keeps its text,
// also where it is copied.
function measure(measured = "fallback") {
  // NOTE SX_LENGTH_RECEIVER line 151: Groovy length() also worked on a map; text, lists, and dicts have a length, but if this value is an object with fixed properties, length stops the script.
  say "Size ${measured.length}"
}
let measuredText: string? = load "game.measured", default: null
if measuredText != null {
  measure(measuredText)
}
function recheck(checked: string? = "fallback") {
  say "Checked ${checked == null}"
}
let checkedText: string? = load "game.checked", default: null
if checkedText != null {
  checkedText = null
  recheck(checkedText)
}
let plainHint: string? = load "game.plainHint", default: null
function clearPlain {
  plainHint = null
}
function showPlain(shown: string? = "none") {
  say "Plain ${shown == null}"
}
if plainHint != null {
  clearPlain()
  showPlain(plainHint)
}
let againHint: string? = load "game.againHint", default: null
function clearAgain {
  againHint = null
  return true
}
function showAgain(againShown: string? = "none") {
  say "Again ${againShown == null}"
}
if againHint != null {
  if clearAgain() {
    showAgain(againHint)
  }
}
// A stored text that an Elvis copies into a variable of another type gives that variable both types and null.
let flagged: boolean | string | null = true
// NOTE SX_LOAD_STRING_TEXT line 175: loadString() read the stored value as text, and the package saves values of another type under this key too, or reads it as one, so the value is read as stored and turned into text; a missing value is the empty text where the value stays in the read or its variable, and null where it goes on.
// NOTE SX_LOAD_OPEN_NULL line 175: Legacy read null for a missing text, which this read keeps; the script gives this variable values of a type the compiler cannot tell too, so the read keeps an open type, checked where it is used.
let conditional = sexscriptLegacyValue(sexscriptLegacyText(load("game.flagged", default: sexscriptLegacyValue(null))))
if conditional == null or conditional == "" {
  conditional = flagged
}
flagged = conditional
// NOTE SX_LOAD_BOOLEAN_TEXT line 176: loadBoolean() read the stored value as text, true only for "true", and the package saves values of another type under this key too, or reads it as one, so the value is read the same way; a missing value reads as false.
// NOTE SX_LOAD_OPEN_NULL line 176: Legacy read null for a missing key; nothing tells this key's type where a load could declare it, so this read keeps that null of an open type, checked where it is used.
say "Flagged ${flagged} ${sexscriptLegacyBooleanText(load("game.flagged", default: sexscriptLegacyValue(null)))}"
// NOTE SX_LOAD_OPEN_NULL line 177: Legacy read null for a missing key; nothing tells this key's type where a load could declare it, so this read keeps that null of an open type, checked where it is used.
let written = "${load("game.written", default: sexscriptLegacyValue(null))}"
let writtenCopy = written
say "Written ${writtenCopy}"
// An object's field that a text is set into takes the empty text of a missing one, as a list's item does.
let profile = { name: "Guest" }
// NOTE SX_SHARED_MAP_WRITE line 182: Groovy maps are shared by reference; if this map came from a list, a parameter, or another variable, the TeaseScript write changes only this copy (ADR 0014).
profile.name = load "game.profileName", default: ""
say "Profile ${profile.name}"
// A list of one function is apart from a list of the same name in another.
function firstItem {
  let items = ["a"]
  items[0] = load "game.item", default: ""
  return items[0]
}
function emptyItem {
  let items = [""]
  let v = items[0]
  return v == null
}
say "Item ${firstItem()} ${emptyItem()}"
// A computed key's read into an item of a list in a list reads the item's empty value where missing, and a list of
// one block is apart from a list of the same name in another.
let grids = [["old"]]
grids[0][0] = load "game.grid${slot}", default: ""
say "Grid ${grids[0][0]}"
function fillLists {
  if askBoolean "Words?" {
    let values = ["old"]
    values[0] = load "game.word${slot}", default: ""
    say "Word ${values[0]}"
  }
  if askBoolean "Numbers?" {
    let values = [1]
    say "Number ${values[0]}"
  }
}
fillLists()
// A variable that a read with a default starts, and that takes values of other types too, holds the read open to them.
let mood: boolean | string = sexscriptLegacyValue(load("game.mood", default: false))
mood = "calm"
function setMood {
  save true as "game.mood"
}
say "Mood ${mood}"
// A whole number that a number read is set to reads 0 where missing, where Groovy's int failed on null.
let laps = 0
laps = toInteger(load("game.laps", default: 0))
say "Laps ${laps}"
// An item of a list in a list reads the item type's empty value too, as does an item that add() appends.
let shelves = [["old"]]
shelves[0][0] = load "game.shelf${slot}", default: ""
shelves[0].add(load("game.extra${slot}", default: ""))
// NOTE SX_INDEX_PAST_END line 211: This position can be one past the end of the list, where Groovy read null; a helper reads null there too.
// NOTE SX_INDEX_PAST_END line 211: This position can be one past the end of the list, where Groovy read null; a helper reads null there too.
if sexscriptLegacyItemAt(shelves[0], 0) == null or sexscriptLegacyItemAt(shelves[0], 1) == null {
  say "Empty shelf."
}
// A text parameter that a call passes a value of a type the importer cannot tell to holds it open.
let anyValue = load "game.any${slot}", default: null
function checkAny(item = load("game.anyText", default: null)) {
  return item == ""
}
say "Any ${checkAny(anyValue)}"
exit
