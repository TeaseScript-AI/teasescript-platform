function sexscriptLegacyValue(value) {
  return value
}
function sexscriptLegacyLoadInteger(key, whenMissing = null) {
  let value = load key, default: null
  if value == null {
    return whenMissing
  }
  return sexscriptLegacyValue(toInteger(value))
}
// Legacy storage kept a list or a map as one key per element (key.0, key.name), which a save removed with the key
// and load() rebuilt; these two functions do the same, listing those keys under sexscriptLegacy.storedKeys.
function sexscriptLegacySave(key, value) {
  let stored: string[] = load "sexscriptLegacy.storedKeys", default: []
  let fresh: string[] = []
  let prefix = "${key}."
  delete key
  if value is list or value is dict {
    let names: string[] = [key]
    let values: list = [value]
    let position = 0
    while position < names.length {
      let name = names[position]
      let item = values[position]
      position += 1
      if item is list {
        let indexValue = 0
        for element in item {
          names.add("${name}.${indexValue}")
          values.add(element)
          indexValue += 1
        }
      } else if item is dict {
        for entry, inner in item {
          names.add("${name}.${entry}")
          values.add(inner)
        }
      } else {
        if item == null {
          save "null" as name
        } else {
          save item as name
        }
        fresh.add(name)
      }
    }
  } else if value != null {
    save value as key
    fresh.add(key)
  }
  let kept: string[] = []
  for name in stored {
    if (name == key or name.startsWith(prefix)) and not fresh.contains(name) {
      delete name
    } else {
      kept.add(name)
    }
  }
  for name in fresh {
    if not stored.contains(name) {
      kept.add(name)
    }
  }
  save kept as "sexscriptLegacy.storedKeys"
}
function sexscriptLegacyLoad(key, whenMissing = null) {
  let value = load key, default: null
  let present = value != null
  if value is string {
    if value.lowercase() == "null" {
      value = null
    }
  }
  if not present {
    let stored: string[] = load "sexscriptLegacy.storedKeys", default: []
    let prefix = "${key}."
    let parts: string[] = []
    for name in stored {
      if name.startsWith(prefix) {
        let part = name.substring(prefix.length)
        let dot = part.indexOf(".")
        if dot >= 0 {
          part = part.substring(0, dot)
        }
        if not parts.contains(part) {
          parts.add(part)
        }
      }
    }
    let numbered = true
    for part in parts {
      if part.length == 0 {
        numbered = false
      }
      let position = 0
      while position < part.length {
        if not "0123456789".contains(part.substring(position, position + 1)) {
          numbered = false
        }
        position += 1
      }
    }
    if parts.length > 0 and numbered {
      let items: list = []
      for part in parts {
        let indexValue = toInteger(part)
        while items.length <= indexValue {
          items.add(null)
        }
        items[indexValue] = sexscriptLegacyLoad("${prefix}${part}")
      }
      value = items
    } else if parts.length > 0 {
      let entries: dict = dict{}
      for part in parts {
        entries[part] = sexscriptLegacyLoad("${prefix}${part}")
      }
      value = entries
    }
  }
  if value == null {
    value = whenMissing
  }
  return value
}
// Where a package has keys that are one another's elements, a key whose computed part is a whole number, or an element
// of a list that only ever holds texts written out, cannot be such an element: it stays a plain save.
sexscriptLegacySave("club.level", 3)
sexscriptLegacySave("club.level.kink", 5)
save 2 as "club.punishmentsRemaining"
for i in 0..=1 {
  save i + 1 as "club.punishment${i}.count"
}
let days = ["monday", "friday"]
let index = randomInteger(0..2)
save 1 as "club.${days[index]}.visits"
say prose "Kink ${sexscriptLegacyLoadInteger("club.level.kink")} ${sexscriptLegacyLoadInteger("club.punishment1.count")}", instant
exit
