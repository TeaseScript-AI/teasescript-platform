function sexscriptLegacyItems(value) {
  if value is string {
    return value.split("")
  }
  return value
}
function sexscriptLegacyPlainText(value) {
  let text = "${value}".replace("**", "").replace("~~", "").replace("[u]", "").replace("[/u]", "").replace("[/color]", "")
  let start = text.indexOf("[color=")
  while start >= 0 {
    let endValue = text.indexOf("]")
    if endValue < start {
      return text.replace("*", "")
    }
    text = "${text.substring(0, start)}${text.substring(endValue + 1)}"
    start = text.indexOf("[color=")
  }
  return text.replace("*", "")
}
function sexscriptLegacyTextMinus(text, part) {
  let position = text.indexOf(part)
  if position < 0 {
    return text
  }
  return "${text.substring(0, position)}${text.substring(position + part.length)}"
}
let name = "Anna"
let count = 3
// NOTE SX_PLUS_OPERAND_TYPE line 3: Groovy + operands are not proven numeric; TeaseScript + adds two numbers or joins two texts or two lists, not mixed values. Use interpolation if this joins text.
say "Hello ${name}, you have ${count + 1} tasks."
say "Literal \${not interpolated} and \"quotes\""
say "Path C:\\temp\tTab"
// Text with HTML that a variable keeps or a function receives becomes markup where it is written.
let rulesTitle = """
  # Rules


"""
function announce(message) {
  say "${rulesTitle}${message}"
}
announce("You may **not** touch")
// A text shown character by character, as a typewriter effect, goes through its characters without markup markers.
function reveal(message) {
  let appeared = ""
  for c in sexscriptLegacyItems(sexscriptLegacyPlainText(message)) {
    appeared = "${appeared}${c}"
    say appeared
  }
}
reveal("You may **not** touch")
// A variable that starts as text joins every later part as text, also where a part's type is not proven.
let dialog = ""
let counts = [3, 5]
// NOTE SX_LOAD_KEEPS_VALUE line 22: Groovy stored null in 'dialog' when this key was missing, which the variable's type cannot hold; the variable keeps its value then.
dialog = load "training.greeting", default: dialog
dialog += """
  ${counts[1]} swats

"""
say dialog
// A text read by a range is the part from its first through its last position, also counted from the end; text minus a
// part drops its first occurrence; text times a count of unknown type repeats it.
let code = "ABCDOEFO"
let cut = 3
function stars(countValue) {
  return "*".repeat(toInteger(countValue))
}
say "${code.substring(0, 3)}${code.substring(code.length - 2)}${code.substring(1, cut)}${code.substring(cut)}${sexscriptLegacyTextMinus(code, "O")}${stars(cut)}"
exit
