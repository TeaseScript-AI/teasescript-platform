speaker system {
  title: "System"
}
function sexscriptLegacyAskBooleansSystem(message, texts, defaults) {
  let selected = []
  let index = 0
  for text in texts {
    selected.add(index < defaults.length and defaults[index] == true)
    index += 1
  }
  say as system message
  while true {
    let buttons = []
    index = 0
    for text in texts {
      let mark = "☐"
      if selected[index] {
        mark = "☑"
      }
      buttons.add({ value: index, text: "${mark} ${text}" })
      index += 1
    }
    buttons.add({ value: texts.length, text: "Done" })
    let picked = choose buttons
    if picked == texts.length {
      return selected
    }
    selected[picked] = not selected[picked]
  }
}
function sexscriptLegacyAskProfile {
  let profileToysKeys: string[] = []
  let profileToysNames: string[] = []
  let profileToysDefaults: boolean[] = []
  let profileToysIndex = 0
  for profileToysKey in ["toys.crop", "toys.paddle"] {
    if load(profileToysKey) == null {
      profileToysKeys.add(profileToysKey)
      profileToysNames.add(["crop / cane", "paddle"][profileToysIndex])
      profileToysDefaults.add(false)
    }
    profileToysIndex += 1
  }
  if profileToysKeys.length > 0 {
    let profileToysAnswers = sexscriptLegacyAskBooleansSystem("What do you have in your toy chest ?", profileToysNames, profileToysDefaults)
    profileToysIndex = 0
    for profileToysKey in profileToysKeys {
      save profileToysAnswers[profileToysIndex] as profileToysKey
      profileToysIndex += 1
    }
  }
}
// NOTE SX_LEGACY_PROFILE: The legacy desktop player's intro and options asked the player's profile (toys.crop, toys.paddle) once; this package asks what is missing here and saves it under the same keys, so other packages reuse the answers.
sexscriptLegacyAskProfile()
function sexscriptLegacyCompare(left, right) {
  if left == null {
    if right == null {
      return 0
    }
    return -1
  }
  if right == null {
    return 1
  }
  if left < right {
    return -1
  }
  if left > right {
    return 1
  }
  return 0
}
let n = randomInteger(0..3)
let days = load "x.days"
switch n {
  case 0 {
    say "Zero"
    if sexscriptLegacyCompare(days, 5) < 0 {
      say "Too early"
    } else {
      say "Changing"
    }
  }
  case 1 {
    say "One"
    say "or two"
  }
  case 2 {
    say "One or two"
  }
}
// A switch case that ends with break returns its last value from the function.
function labelValue(kind) {
  switch kind {
    case 1 {
      return "one"
    }
    default {
      return "many"
    }
  }
}
say labelValue(1)
// A case expression with effects needs the switch value kept; a list variable case tests membership.
let subject = 1
subject = randomInteger(0..3)
let options = [1, 2]
let switchValue1 = subject
if switchValue1 == randomInteger(0..3) {
  say "drawn"
} else if options.contains(switchValue1) {
  say "listed"
} else {
  say "other"
}
// A range bound known only at runtime may make the range run in either direction.
let top = 3
if (subject >= top and subject <= 1) or (subject <= top and subject >= 1) {
  say "in range"
}
// A list case matches any of its elements, as a case with several values.
switch n {
  case 0, 1 {
    say "low"
  }
  case 2..=3 {
    say "high"
  }
}
// A descending range matched in Groovy too, which a range case cannot express.
if n <= 3 and n >= 1 {
  say "one to three"
} else if n == 0 {
  say "zero"
}
// A case that falls through into a case whose own break sits in an if leaves the switch at that break as well.
switch randomInteger(0..2) {
  case 0 {
    if load("toys.paddle") == true {
      say "Fetch the paddle"
    } else if load("toys.crop") == true {
      say "Fetch the crop"
    }
  }
  default {
    if load("toys.crop") == true {
      say "Fetch the crop"
    }
  }
}
exit
