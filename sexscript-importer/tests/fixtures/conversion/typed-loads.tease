function sexscriptLegacyValue(value) {
  return value
}
function sexscriptLegacyLoadInteger(key, whenMissing = null) {
  let value = load key, default: null
  if value == null {
    return whenMissing
  }
  return sexscriptLegacyValue(toInteger(value))
}
function sexscriptLegacyLoadIntegerOr(key, whenMissing: integer): integer {
  let value = load key, default: null
  if value == null {
    return whenMissing
  }
  return toInteger(value)
}
function sexscriptLegacyLoadFloat(key, whenMissing = null) {
  let value = load key, default: null
  if value == null {
    return whenMissing
  }
  return sexscriptLegacyValue(toNumber(value))
}
function sexscriptLegacyText(value): string? {
  if value == null {
    return null
  }
  return "${value}"
}
function sexscriptLegacyCompare(left, right) {
  if left == null {
    if right == null {
      return 0
    }
    return -1
  }
  if right == null {
    return 1
  }
  if left < right {
    return -1
  }
  if left > right {
    return 1
  }
  return 0
}
// Legacy loadInteger() and loadFloat() parsed the stored text as a number, loadInteger() dropping the fraction toward
// zero; a missing key read null.
save "5.1" as "game.version"
let lastVersion = sexscriptLegacyLoadFloat("game.version", 0)
if lastVersion > 4 {
  say "Welcome back."
}
save 100.5 as "game.points"
let points = 80
let savedPoints: number? = load "game.points", default: null
if savedPoints != null {
  // NOTE SX_LOAD_KEEPS_VALUE line 9: Groovy stored null in 'points' when this key was missing, which the variable's type cannot hold; the variable keeps its value then.
  points = sexscriptLegacyLoadInteger("game.points", points)
}
say "You have ${points} points."
let missing = sexscriptLegacyLoadInteger("game.missing")
if missing == null {
  say "Nothing stored."
}
// A whole-number variable that reads a number widens to hold it.
let version: number = 0
function readVersion {
  // NOTE SX_LOAD_KEEPS_VALUE line 15: Groovy stored null in 'version' when this key was missing, which the variable's type cannot hold; the variable keeps its value then.
  version = sexscriptLegacyLoadFloat("game.version", version)
}
readVersion()
say "Version ${version}"
// Half of a stored whole number may hold a fraction, and so does what is left of it.
save 13 as "game.total"
function halves {
  let s1 = sexscriptLegacyLoadInteger("game.total")
  let s2: number = 0
  let s3: number = 0
  s2 = s1 / 2
  s3 = s1 - s2
  say "${s2} and ${s3}"
}
halves()
// A read whose key a call computes, with a fallback that may fail, computes the key once, in a variable of a name the
// script does not use.
let sexscriptLegacyKey1 = "taken"
function keyOf {
  return "game.points"
}
let sexscriptLegacyKey2 = keyOf()
let counted = sexscriptLegacyLoadInteger(sexscriptLegacyKey2, load(sexscriptLegacyKey2, default: 1 + 1))
say "${counted} ${sexscriptLegacyKey1}"
// A default that reads a variable the code between declares stays where it is, after that declaration.
let picture: string? = load "game.picture", default: ""
let saved: string? = load "game.savedPicture", default: null
if picture == null or picture == "" {
  picture = saved
}
say "Picture ${picture}"
// A read of the script's own with a default, which a whole-number default makes a whole number.
function loadIntegerVal(keyword, defaultValue) {
  let stored: integer? = sexscriptLegacyLoadInteger(keyword)
  if stored == null {
    return defaultValue
  } else {
    return stored
  }
}
let squares = null
if squares == null {
  squares = sexscriptLegacyLoadIntegerOr("game.squares", 0) + 1
  let limit = squares + 3
  say "Limit ${limit}"
}
// A default that is no whole number written as one, or a local that converts the read, keeps the script's own read.
let defaultNumber = 1.0
say "Decimal default ${loadIntegerVal("game.missing", defaultNumber)}"
function loadAsText(keyword, defaultValue) {
  let stored: string? = sexscriptLegacyText(sexscriptLegacyLoadInteger(keyword))
  if stored == null {
    return defaultValue
  } else {
    return stored
  }
}
say "Text ${loadAsText("game.squares", "none")}"
// A read that the function tests for null but then sets to a parameter's value or to text stays open: the value
// may be of another type, and the text needs no number at all.
function readDefault(key, fallbackValue) {
  let x = sexscriptLegacyLoadInteger(key)
  if x == null {
    say "Default"
    x = fallbackValue
  }
  return x
}
let counts = { count: 0 }
// NOTE SX_SHARED_MAP_WRITE line 74: Groovy maps are shared by reference; if this map came from a list, a parameter, or another variable, the TeaseScript write changes only this copy (ADR 0014).
counts.count = readDefault("game.missing", 7)
say "Count ${counts.count}"
function readText {
  let x = sexscriptLegacyLoadInteger("game.missing")
  if x != null {
    say "Saved"
  }
  x = "text"
  return x
}
say "Read ${readText()}"
// An integer answer kept in a local, whole arithmetic with a whole local, a remainder, a sign, and a question shown
// from the read keep it a whole number or
// null, so a caller that tests its own read for null gets a whole number back.
function fillLabel {
  say "Filling"
  return "label"
}
function readAsked {
  let x: integer? = sexscriptLegacyLoadInteger("game.missing")
  if x == null {
    let answer = askInteger "How many?", prefill: 3
    x = answer
  }
  let step = 1
  x = +((x + step) * 2 % 50)
  let question: integer? = x
  let prefill = fillLabel()
  if question != null {
    say question
  }
  let labelValue = askText(prefill: prefill).replace("\n", " ")
  return x
}
let asked: integer? = 0
asked = sexscriptLegacyLoadInteger("game.asked")
if asked == null {
  say "Nothing asked yet"
}
asked = readAsked()
say "Asked ${asked * 2}"
// A read that arithmetic uses where the function has not tested it stays open: Groovy failed there only at runtime,
// on the path where the key is missing.
function misbehaved {
  let summoned = sexscriptLegacyLoadInteger("game.summoned")
  let talked = 0
  if (summoned != null and summoned != 0) or talked != 0 {
    say "Penalty ${summoned * 10 + talked}"
  }
  if summoned != null and sexscriptLegacyCompare(summoned, 1) > 0 {
    say "Summoned ${summoned * 50}"
  }
  return talked
}
say "Talked ${misbehaved()}"
exit
