// Calls the function an action ID names. Unlike Groovy, extra arguments are ignored and an unknown action returns null.
function sexscriptLegacyCall(action, args): boolean | number | null {
  if action == "chanceOrFlag" {
    return chanceOrFlag(args[0])
  }
}
function sexscriptLegacyValue(value) {
  return value
}
function sexscriptLegacyLoadInteger(key, whenMissing = null) {
  let value = load key, default: null
  if value == null {
    return whenMissing
  }
  return sexscriptLegacyValue(toInteger(value))
}
function sexscriptLegacyLoadFloat(key, whenMissing = null) {
  let value = load key, default: null
  if value == null {
    return whenMissing
  }
  return sexscriptLegacyValue(toNumber(value))
}
function sexscriptLegacyText(value): string? {
  if value == null {
    return null
  }
  return "${value}"
}
function sexscriptLegacyListMinus(items, removed) {
  let kept = []
  for item in items {
    if not removed.contains(item) {
      kept.add(item)
    }
  }
  return kept
}
// A variable that starts with a whole number and later holds fractions widens to a number by itself (#504 option B).
let tempo: number = 1
tempo = 0.75
let delay: number = 2
delay = delay / 4
let weights: number[] = [1, 2]
weights.add(2.5)
// A variable that is later set to null gets an optional type.
let mood: string? = "calm"
if tempo < 1 {
  mood = null
}
// Groovy integer declarations truncate every number they store.
let half = toInteger(7 / 2)
let rounds = 1
rounds = toInteger(rounds + tempo)
let steps = 10
steps = toInteger(steps / 3)
say "Tempo ${tempo}, delay ${delay}, ${weights.length} weights, mood ${mood}"
say "Half ${half}, rounds ${rounds}, steps ${steps}"
// A value of unknown type is truncated too, and an integer read from storage is declared and checked.
function fraction {
  return 3.5
}
let whole = toInteger(fraction())
whole = toInteger(fraction() + 1)
save 4 as "x.count"
let stored: integer = sexscriptLegacyLoadInteger("x.count")
// Another storage read may hold a fraction, which Groovy truncated.
save 2.5 as "x.ratio"
let ratio = toInteger(sexscriptLegacyLoadFloat("x.ratio"))
say "Ratio ${ratio}"
// A number that starts as null, and that nothing compares with null, starts at 0.
let later: number = 0
later = 1
later = 2.5
say "Whole ${whole}, stored ${stored}, later ${later}"
// A position that may hold a fraction truncates when it indexes a list, as Groovy did.
let names = ["first", "second"]
let position: number = 0
position += 0.5
say names[toInteger(position)]
// Groovy pairs of a name and a level: a list of lists whose elements are text or whole numbers.
let offenses: (string | integer)[][] = [
  ["late", 2],
  ["rude", 4]
]
let single: (string | integer)[][] = [["missed", 1]]
say "First: ${offenses[0][0]}, then ${single[0][0]}"
// A list that starts with a null element takes text later.
let toys = [null]
toys[0] = "rope"
say toys[0]
// A list of text that later holds lists of text keeps both in a union of its elements.
// NOTE SX_UNION_TYPE line 48: Groovy gave the list 'words' elements of several types; TeaseScript declares it '(string | string[])[]' (ADR 0021 §3), so a use of an element that needs one of these types must keep it in a variable and test it first, as in: if item is string { ... }
let words: (string | string[])[] = ["Rub", "Caress"]
say "More?"
if (choose yes: "Yes", no: "No") == "yes" {
  words = [
    ["Pinch", "Twist"],
    ["them!"]
  ]
}
say "${words.length}"
// A variable declared String converted every value stored in it to text, and kept null.
let startDelay = sexscriptLegacyLoadInteger("training.startDelay")
let delayText: string? = null
if startDelay == null {
  delayText = "(not set)"
} else {
  delayText = sexscriptLegacyText(startDelay)
}
let roundCount = "3"
say "Delay ${delayText}, ${roundCount} rounds"
// A function whose returns mix types declares its result type, which TeaseScript does not infer, also where several
// returns share a type.
function chanceOrFlag(n): boolean | number {
  if n > 2 {
    return true
  }
  if n > 1 {
    return false
  }
  return 0.5
}
say "C ${chanceOrFlag(2)}"
// A variable that holds what a closure value returns takes the result type of the dispatcher that calls it.
let pick = "chanceOrFlag"
let picked: boolean | number | null = false
picked = sexscriptLegacyCall(pick, [3])
say "P ${picked}"
// A list that may become null, of elements no code shows, and a value that is first a number and then a date, are
// declared with types an annotation can write.
let picks: list | null = []
say "Clear?"
if (choose yes: "Yes", no: "No") == "yes" {
  picks = null
}
say "Cleared ${picks == null}"
// NOTE SX_UNION_TYPE line 79: Groovy let 'stamp' hold values of several types; TeaseScript declares it 'integer | datetime' (ADR 0021 §3), so a use that needs one of these types must test it first, as in: if stamp is integer { ... }
let stamp: integer | datetime = 0
stamp = getDateTime()
say "Stamped"
// A variable that holds one of two ranges starts as null, not as a list.
let span = null
say "Low?"
if (choose yes: "Yes", no: "No") == "yes" {
  span = 1..=3
} else {
  span = 4..=6
}
for n in span {
  say "N ${n}"
}
// A float parameter with a whole default takes fractions.
function fade(seconds: number = 0) {
  say "Fade ${seconds}"
}
fade(0.5)
// A function that ends in an endless loop returns only what its returns give.
function pickPage {
  while true {
    let pageValue = askInteger "Page?", default: 1
    if pageValue > 0 {
      return pageValue
    }
  }
}
let page = 9
page = pickPage()
// NOTE SX_PLUS_OPERAND_TYPE line 98: Groovy + operands are not proven numeric; TeaseScript + adds two numbers or joins two texts or two lists, not mixed values. Use interpolation if this joins text.
say "Page ${page + 1}"
// A local that a null test rules out in a branch holds no null there.
function joinNames {
  let all = "0"
  let next: string = "0"
  let i = 0
  while next != "" {
    next = load "names.${i}", default: sexscriptLegacyValue("")
    if next == "" {
      say "End"
    } else if all == "0" {
      all = next
    } else {
      all += ", ${next}"
    }
    i += 1
  }
  return all
}
let joined = joinNames()
// NOTE SX_LENGTH_RECEIVER line 112: Groovy length() also worked on a map; text, lists, and dicts have a length, but if this value is an object with fixed properties, length stops the script.
say "Names ${joined.length}"
// A function with a `return null` may give null where its other results have no known type.
let implement: string? = "nothing"
function pickOwned(keys) {
  for key in keys {
    if load(key, default: sexscriptLegacyValue(null)) != true {
      keys = sexscriptLegacyListMinus(keys, [key])
    }
  }
  // NOTE SX_LENGTH_RECEIVER line 117: Groovy isEmpty() also worked on a map; text, lists, and dicts have a length, but if this value is an object with fixed properties, length stops the script.
  if keys.length == 0 {
    return null
  }
  return keys.random
}
function chooseImplement {
  implement = pickOwned(["toys.paddle", "toys.ruler"])
}
chooseImplement()
if implement == "toys.paddle" {
  say "Paddle"
} else {
  say "No implement"
}
// A Groovy `double`, or a decimal literal such as `1.0`, takes fractions later.
let share = 1.0
let tally = 0.0
function scale(factor) {
  share = factor * 2
  // NOTE SX_PLUS_OPERAND_TYPE line 127: Groovy + operands are not proven numeric; TeaseScript + adds two numbers or joins two texts or two lists, not mixed values. Use interpolation if this joins text.
  tally = factor + 1
}
scale(0.25)
say "Share ${share} ${tally}"
exit
