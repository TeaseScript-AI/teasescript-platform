// A loop goes through, and a draw takes from, a range that ends at a whole number. One that may end at a fraction ends
// where Groovy stopped: n.times runs for the whole part of n, an inclusive range at the last whole number in it, an
// exclusive one before the first whole number past it; whole bounds stay as they are.
let half = 2.5
for it in 0..toInteger(half) {
  say prose "Tick ${it}", instant
}
let iTo = floor(half)
for iOffset in 0..=floor(abs(iTo)) {
  let i = iOffset * sign(iTo)
  say prose "Up to ${i}", instant
}
let itTo = ceil(half)
for itOffset in 0..ceil(abs(itTo)) {
  let it = itOffset * sign(itTo)
  say prose "Below ${it}", instant
}
// Java's nextInt took a whole number only, here one a variable that may hold a fraction holds.
let bound = 2.5
bound = 4
// NOTE SX_RANDOM_OBJECT line 13: Java's Random object kept its own sequence of random numbers; its draws come from the session's random numbers now, with the same distribution.
say prose "Drawn ${randomInteger(0..ceil(bound))}", instant
let whole = 3
for it in 0..whole {
  say prose "Again ${it}", instant
}
let iTo2 = whole
for iOffset2 in 0..ceil(abs(iTo2)) {
  let i = iOffset2 * sign(iTo2)
  say prose "Whole ${i}", instant
}
say prose "Drawn ${randomInteger(0..whole)}", instant
// A Groovy range ran down where its first bound was greater: written so, it is the list of its numbers (guillotine's
// countdown), and where only the values show it, a helper counts either way (Domme2's reward of 0 points ran twice).
for it in [3, 2, 1] {
  say prose "Down ${it}", instant
}
let rewardPoints = randomInteger(0..2)
let itTo2 = rewardPoints
for itOffset2 in 0..=floor(abs(itTo2 - 1)) {
  let it = 1 + itOffset2 * sign(itTo2 - 1)
  say prose "Stroke ${it}", instant
}
let kTo = rewardPoints
for kOffset in 0..ceil(abs(kTo)) {
  let k = kOffset * sign(kTo)
  say prose "Before ${k}", instant
}
// A range whose direction shows only at runtime is computed once, its first bound first, and one that starts at a
// fraction goes through the numbers a whole step from it.
let low = 1
function lift {
  low = 3
  return 4
}
let kFrom = low
let kTo2 = floor(lift())
for kOffset2 in 0..=floor(abs(kTo2 - kFrom)) {
  let k = kFrom + kOffset2 * sign(kTo2 - kFrom)
  say prose "Bound ${k}", instant
}
let start = 2.5
let stop = 5
let kFrom2 = start
let kTo3 = stop
for kOffset3 in 0..=floor(abs(kTo3 - kFrom2)) {
  let k = kFrom2 + kOffset3 * sign(kTo3 - kFrom2)
  say prose "Half ${k}", instant
}
exit
