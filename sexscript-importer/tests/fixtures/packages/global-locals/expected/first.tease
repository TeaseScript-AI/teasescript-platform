// Both scripts share these functions; one reads the script's lastTime, the other keeps a local of that name.
let lastTime = getTimestamp().toSeconds()
function elapsed {
  return getTimestamp().toSeconds() - lastTime
}
function remember {
  let lastTimeValue = getTimestamp().toSeconds()
  save lastTimeValue as "demo.lastTime"
}
remember()
say "Elapsed ${elapsed()}"
goto "second.tease"
