let tau = 2 * pi
// A static that operators compute from literals is a global, so the method that reads it is a global function too.
function turns(count) {
  return count * tau
}
showWait("Kneel")
rounds(3, "Stroke")
say prose "Twice ${twice(2)}", instant
say prose "Turns ${turns(2)}", instant
if percentChance(40) {
  say prose "Lucky", instant
}
start()
check("good")
goto "next.tease"
