// Calls the function an action ID names. Unlike Groovy, extra arguments are ignored and an unknown action returns null.
function sexscriptLegacyCall(action, args) {
  if action == "pauseCycle" {
    if args.length >= 2 {
      return pauseCycle(args[0], args[1])
    }
    return pauseCycle(args[0])
  }
  return null
}
let sexscriptBackgroundSounds = []
function sexscriptLegacyPlayBackgroundSound(file, passes) {
  if file == null {
    sexscriptLegacyStopBackgroundSounds()
    return
  }
  if passes < 1 {
    return
  }
  let sound = playAudio(file: file, async: true, repeat: passes times)
  sexscriptBackgroundSounds.add(sound)
}
function sexscriptLegacyStopBackgroundSounds {
  for sound in sexscriptBackgroundSounds {
    sound.stop()
  }
  sexscriptBackgroundSounds = []
}
function sexscriptLegacyRandom(limit) {
  if limit == null {
    return randomInteger(0..100)
  }
  let bound = limit - limit % 1
  if bound > 0 {
    return randomInteger(0..bound)
  }
  if bound < 0 {
    return -randomInteger(0..-bound)
  }
  return 0
}
function loadGreetingModule {
  // A module variable with the name of an object field stays separate from it.
  roundsInGreeting = 10
}
let roundsInGreeting = 0
function loadLaterModule {
  // Loaded after greeting.groovy, so this greet replaces the earlier one.
}
function greet {
  say "Hello again"
  pause()
}
function setupLaterModule(times = 2) {
  say "Setup ${times}"
}
function loadPauseModule {
  // Returning nothing on every path keeps the module's result fixed.
  if not enabled {
    return null
  }
  say "Pausing enabled"
}
function pause {
  wait sexscriptLegacyRandom(rounds - 2) + 1
  sexscriptLegacyStopBackgroundSounds()
}
