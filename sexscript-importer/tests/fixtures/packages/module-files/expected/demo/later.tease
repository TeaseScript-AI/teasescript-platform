global function loadLaterModule {
  // Loaded after greeting.groovy, so this greet replaces the earlier one.
}
global function greet {
  say prose "Hello again", instant
  if title == "" {
    save "Guest" as "demo.title"
  }
  pause()
}
global function setupLaterModule(times = 2) {
  say prose "Setup ${times}", instant
}
