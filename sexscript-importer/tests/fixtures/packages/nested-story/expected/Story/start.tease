// The story starts here and names the next chapter from the legacy scripts folder.
// NOTE SX_LAUNCH_MARKERS: The legacy player recorded each start of this script under "Story.start.launch.*", which the package reads; the script saves the first and last start time and the number of starts as it did.
if load("Story.start.launch.firsttime", default: null) == null {
  save getTimestamp().toSeconds() as "Story.start.launch.firsttime"
}
save getTimestamp().toSeconds() as "Story.start.launch.lasttime"
save load("Story.start.launch.nb", default: 0) + 1 as "Story.start.launch.nb"
say "The story begins."
goto "Story/middle.tease"
