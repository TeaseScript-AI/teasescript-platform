// NOTE SX_ENTRY_MENU: The legacy player listed the package's scripts for the player to pick; a TeaseScript package starts at main.tease, so this menu offers each script that no other script chains to.
global function sexscriptLegacyValue(value) {
  return value
}
global function sexscriptLegacyLoadInteger(key, whenMissing = null) {
  let value = load key
  if value == null {
    return whenMissing
  }
  return sexscriptLegacyValue(toInteger(value))
}
say "Which script do you want to start?"
let picked = choose addon: "addon", start: "start"
switch picked {
  case "addon" {
    goto "Story/addon.tease"
  }
  default {
    goto "Story/start.tease"
  }
}
