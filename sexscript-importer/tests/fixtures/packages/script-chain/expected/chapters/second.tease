say "Chapter two."
// The next script comes from storage.
let after = load "chapter.after"
// NOTE SX_DYNAMIC_SCRIPT line 4: Legacy chained to the script this value names, and ended the chain when the value was null or empty or named no file; its ".groovy" becomes ".tease" here, and script() fails at runtime for a name that is no file of the package.
if after == null or after == "" {
  exit
}
goto script(after.replace(".groovy", ".tease"))
