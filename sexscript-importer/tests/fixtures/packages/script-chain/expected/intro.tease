say "Welcome."
// Each script that reads a key declares its type, the same in every file, with the other values its variables take.
let progress: integer | string | null = load "story.progress", default: null
if progress == null {
  progress = "new"
}
save 1 as "story.progress"
say "Start the first chapter?"
if (choose yes: "Yes", no: "No") == "yes" {
  goto "chapters/first.tease"
}
// The legacy player found no such script and ended the chain.
// NOTE SX_MISSING_SCRIPT line 8: Legacy chained to the script "bonus.groovy", which is not part of this package; the legacy player ended the chain when it found no such file, so the script exits here.
exit
