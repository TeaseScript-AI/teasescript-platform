// Each script repeats the same table, reads the mistress from storage, and defines the same helpers.
// mistress is a global of helpers.tease; this script starts it with its own value.
mistress = load "mistress"
function enter {
  image()
  say "Come in."
}
save "Vera" as "mistress"
enter()
taunt()
greet()
goto "rooms/hall.tease"
