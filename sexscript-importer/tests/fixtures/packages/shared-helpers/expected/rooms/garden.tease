// mistress is a global of helpers.tease; this script starts it with its own value.
mistress = load "mistress"
// Another picture under the same name stays in this script.
function imageLocal {
  showImage "garden.jpg"
}
// The same text calls each script's own picture, so it stays in each script.
function enter {
  imageLocal()
  say "Come in."
}
// This script keeps its level as text, so the helper that shows it stays in each script.
let level = "high"
function report {
  say "Level ${level}"
}
enter()
report()
greet()
exit
