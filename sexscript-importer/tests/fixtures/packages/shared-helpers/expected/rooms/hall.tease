let phrases = ["Kneel.", "Wait."]
let mistress = load "mistress", default: ""
function image {
  showImage "room.jpg"
}
function taunt {
  say phrases.random, instant
}
function greet {
  say "Welcome to ${mistress}'s house.", instant
}
function enter {
  image()
  say "Come in.", instant
}
let level = 1
function report {
  say "Level ${level}", instant
}
enter()
report()
greet()
taunt()
goto "rooms/garden.tease"
