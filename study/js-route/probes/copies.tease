// Copies where the language copies: assignment, arguments, returns, elements, loop items.
let a = [[1, 2], [3]]
let b = a
b[0][0] = 9
function grow(items) {
  items.add(4)
  return items
}
let c = grow(a[1])
let d = dict{"k": [1]}
let e = d["k"]
e.add(2)
let dk = d["k"]
for item in a {
  item.add(0)
}
say "${a[0][0]} ${b[0][0]} ${a[1].length} ${c.length} ${dk.length} ${e.length} ${a[0].length}"
exit
