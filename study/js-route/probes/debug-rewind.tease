// Part F: Debug's stop at every statement, and rewind to an earlier wait with another answer there. The waits stand
// inside a call inside a loop, and a list outlives the call that changes it.
let log = []
function playRound(i: integer): integer {
  let picked = askChoice 1, 2, 3
  let extra = randomInteger(1..=6)
  log.add("${i}:${picked}+${extra}")
  say "Round ${i}: ${picked} and ${extra}"
  return picked * 10 + extra
}
let total = 0
for i in 0..3 {
  total += playRound(i)
  if total > 40 {
    let bonus = askInteger "Bonus?"
    total += bonus
  }
}
say "Total ${total}: ${log}"
exit
