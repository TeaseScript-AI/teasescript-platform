// Number and text rules a player sees: rounding, number to text, text case and comparison, sorting.
let xs = [0.1 + 0.2, 1 / 3, 2.5, -2.5, 1e21, 123456789.125, 0.000001]
for x in xs {
  say "${x} ${round(x)} ${round(x, decimals: 2)} ${floor(x)}"
}
let words = ["b", "B", "a", "Straße", "ǅ", "é", "e"]
words.sort()
let joined = words.join(", ")
say joined
let upper = "Straße".uppercase()
let lower = "İ".lowercase()
let same = "ß" == "SS"
say "${upper} ${lower} ${same}"
say "${sqrt(2)} ${exp(1)} ${ln(10)} ${tan(30 deg)}"
exit
