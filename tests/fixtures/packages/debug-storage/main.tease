save 3 as "player.score"
save "Ada" as "player.name"
save "captured-media:note" as "note"
save "captured-media:00000000-0000-4000-8000-000000000000:1" as "missing"
save { level: 2, tags: ["a", "b"] } as "player.flags"
let photo: string = askImage(hint: "Add an image to save")
save photo as "player.photo"
save [photo, photo] as "album"
say "Saved.", instant
let more = showButton "More"
save 4 as "player.score"
save "captured-media:00000000-0000-4000-8000-000000000000:2" as "player.photo"
say "Saved again.", instant
let done = showButton "Done"
exit
