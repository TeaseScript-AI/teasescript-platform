let note = encryptText("A secret note")
say "Locked.", instant
let opened = decryptText(note, default: "closed")
say "Opened: ${opened}", instant
let past = toAbsoluteDateTime("2023-08-23T15:09:27Z")
let timed = encryptText("From the past", openAt: past)
let byTime = decryptText(timed, default: "closed")
say "Time lock: ${byTime}", instant
exit
