speaker guide {
    displayName: "Guide"
    avatar: "avatars/missing.png"
}
speaker helper {
    displayName: "Helper"
    avatar: "avatars/corrupt.png"
}
showImage "images/missing.png"
say "One", instant
say as guide "Two", instant
say as helper "Three", instant
wait 30 s
playAudio "sounds/missing.wav"
playAudio "sounds/corrupt.wav"
showImage "images/corrupt.png"
showButton "Next"
showImage "images/missing.png"
playAudio async "sounds/missing.wav"
wait 30 s
showImage "images/valid.svg"
say "Done", instant
showButton "Finish"
exit
