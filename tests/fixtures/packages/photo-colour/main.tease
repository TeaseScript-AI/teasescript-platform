// Photo colours: the Stage photos colour the Player, and the empty Stage gives the theme's colours back.
speaker guide {
    displayName: "Guide"
    color: "#7a9a3a"
}
showImage "images/green.jpg"
say "A green photo.", instant
say as guide "Spoken in the guide's colour.", instant
say prose(color: "#eeeeee") "Authored prose on the background.", instant
let picture: string = askImage(hint: "Add an image")
showButton "Next"
showImage "images/red.svg"
showButton "Back"
showImage "images/green.jpg"
showButton "Again"
showImage "images/red.svg"
showButton "Hide"
hideImage
showButton "Done"
exit
