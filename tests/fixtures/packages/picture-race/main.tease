timer async 2 s {
  wait 1 s
  let interrupted = askImage(hint: "Timer image")
  showImage interrupted
  say "Timer image received."
}
let picture = askImage(hint: "Main image")
showImage picture
say "Main image received."
timer async 2 s {
  wait 1 s
}
let second = askImage(hint: "Second image")
showImage second
say "Second image received."
showButton "Done"
exit
