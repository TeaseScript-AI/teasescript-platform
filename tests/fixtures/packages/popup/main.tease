let name = askText "Your name?"
showPopup "Welcome, ${name}"
say "Closed with Enter", instant
showPopup(message: "The next part starts now.", buttonText: "Continue")
say "Closed with Escape", instant
showPopup "Space closes this one"
say "Closed with Space", instant
showPopup "A reload shows this one again"
say "Closed after the reload", instant
exit
