{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teasescript.ai/schemas/work-package-v1.schema.json",
  "title": "TeaseScript work package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "id",
    "title",
    "repository",
    "targetBranch",
    "baseSha",
    "basePolicy",
    "requiredContext",
    "allowedPaths",
    "baseBlobs",
    "checks",
    "commit"
  ],
  "properties": {
    "format": {
      "const": "teasescript-work-package"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "targetBranch": {
      "type": "string",
      "minLength": 1
    },
    "baseSha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "basePolicy": {
      "enum": [
        "exact",
        "compatible-ancestor"
      ]
    },
    "requiredContext": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryPath"
      }
    },
    "allowedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryPath"
      }
    },
    "baseBlobs": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "argv"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "prefixItems": [
              {
                "enum": [
                  "npm",
                  "node",
                  "php",
                  "composer"
                ]
              }
            ],
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$"
        },
        "body": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!-)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))[^\\r\\n]+$"
    }
  }
}
